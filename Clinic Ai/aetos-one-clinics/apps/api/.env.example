DATABASE_URL="postgresql://aetos:aetos@localhost:5432/aetos_one_clinics"
PORT=3001

# Keycloak OIDC
KEYCLOAK_ISSUER="http://localhost:8080/realms/aetos-clinics"
KEYCLOAK_AUDIENCE="aetos-clinics-api"

# Add-on supervisor
ADDON_REGISTRY_PATH="../../addons"

# LLM gateway (used by add-ons, not the core API directly)
