{% extends "base.html.j2" %}
{% block title %}Calls — {{ app_name }}{% endblock %}
{% block content %}
<header class="page-head">
  <h1>Calls</h1>
</header>

<section class="tiles">
  <div class="tile">
    <div class="tile-label">Today</div>
    <div class="tile-value">{{ stats.total }}</div>
    <div class="tile-sub">{{ stats.date }}</div>
  </div>
  <div class="tile">
    <div class="tile-label">Active now</div>
    <div class="tile-value {{ 'ok' if stats.active else '' }}">{{ stats.active }}</div>
    <div class="tile-sub">live rooms with history</div>
  </div>
  <div class="tile">
    <div class="tile-label">Talk time today</div>
    <div class="tile-value">{{ stats.total_minutes }}m</div>
    <div class="tile-sub">summed duration</div>
  </div>
</section>

<form method="get" action="/calls" class="form filter-row">
  <label>Agent
    <select name="agent">
      <option value="">All</option>
      {% for a in agents %}<option value="{{ a.id }}" {{ 'selected' if filter_agent == a.id else '' }}>{{ a.name }}</option>{% endfor %}
    </select>
  </label>
  <label>Date
    <input type="date" name="date" value="{{ filter_date or '' }}">
  </label>
  <label>Direction
    <select name="direction">
      <option value="">All</option>
      <option value="web" {{ 'selected' if filter_direction == 'web' else '' }}>web</option>
      <option value="sip" {{ 'selected' if filter_direction == 'sip' else '' }}>sip</option>
    </select>
  </label>
  <div class="form-actions" style="align-items:flex-end">
    <button class="btn btn-primary btn-sm" type="submit">Filter</button>
    <a class="btn btn-ghost btn-sm" href="/calls">Clear</a>
  </div>
</form>

{% if calls %}
<table class="table">
  <thead><tr><th>Call</th><th>Agent</th><th>Direction</th><th>Status</th><th>Duration</th><th>Participants</th></tr></thead>
  <tbody>
    {% for call in calls %}
    <tr>
      <td><a class="mono" href="/calls/{{ call.id }}">{{ call.id }}</a>
          <div class="sub" data-ts="{{ call.started_at }}"></div></td>
      <td>{{ call.agent_name or '—' }}</td>
      <td><span class="pill">{{ call.direction }}</span></td>
      <td><span class="pill {{ 'pill-ok' if call.status == 'active' else '' }}">{{ call.status }}</span></td>
      <td>{% if call.duration_seconds is not none %}{{ call.duration_seconds // 60 }}m {{ call.duration_seconds % 60 }}s{% else %}—{% endif %}</td>
      <td>{% for p in call.participants %}<span class="pill">{{ p }}</span> {% endfor %}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<script>
document.querySelectorAll("[data-ts]").forEach(function (el) {
  el.textContent = new Date(parseFloat(el.dataset.ts) * 1000).toLocaleString();
});
</script>
{% else %}
<section class="placeholder">
  <p>No calls recorded{{ ' for this filter' if (filter_agent or filter_date or filter_direction) else '' }} yet.
     Make one from the <a href="/test-call">Test Call</a> page (worker must be running).</p>
</section>
{% endif %}
{% endblock %}
