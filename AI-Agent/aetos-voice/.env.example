# Copy to .env and edit. All settings use the APP_ prefix.

APP_APP_NAME="Aetos Voice AI Dashboard"

# Bind (keep loopback; expose via nginx/tunnel later)
APP_HOST=127.0.0.1
APP_PORT=8100

# Security — REQUIRED before exposing anywhere
# Generate a secret:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-generate-a-real-secret
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin
APP_SESSION_MAX_AGE=43200

# Redis
APP_REDIS_URL=redis://127.0.0.1:6379/0
APP_REDIS_PREFIX=app
