  const PROVIDER_ORDER = ["tronic-cloud", "breeze-connect", "twilio", "telnyx", "vonage", "plivo", "cloudonix", "vobiz"];

  // ---------- State ----------
  let currentStep = 1;
  let selectedProvider = null;
  let namePrefix = "";
  let credValues = {};
  let numbers = [];
  let optionsLoaded = false;  // agents + time_profiles fetched lazily on first open

  // ---------- DOM helpers ----------
  const $ = (id) => document.getElementById(id);
  const modal = () => $("sipSetupWizardModal");

  function el(tag, opts) {
    const node = document.createElement(tag);
    if (!opts) return node;
    if (opts.className) node.className = opts.className;
    if (opts.text !== undefined) node.textContent = opts.text;
    if (opts.attrs) for (const k in opts.attrs) node.setAttribute(k, opts.attrs[k]);
    if (opts.style) for (const k in opts.style) node.style[k] = opts.style[k];
    if (opts.children) opts.children.forEach((c) => c && node.appendChild(c));
    return node;
  }

  function showStep(n) {
    currentStep = n;
    document.querySelectorAll(".wizard-pane").forEach((p) => {
      p.classList.toggle("d-none", String(p.dataset.pane) !== String(n));
    });
    document.querySelectorAll("#wizardStepper .wizard-step").forEach((s) => {
      const num = parseInt(s.dataset.step, 10);
      s.classList.remove("active", "complete");
      if (num < n) s.classList.add("complete");
      else if (num === n) s.classList.add("active");
    });
    $("wizardBackBtn").disabled = n <= 1 || n === "success";
    $("wizardNextBtn").classList.toggle("d-none", n >= 6 || n === "success");
    $("wizardCreateBtn").classList.toggle("d-none", n !== 6);
    $("wizardDoneBtn").classList.toggle("d-none", n !== "success");
    $("wizardCancelBtn").classList.toggle("d-none", n === "success");
    refreshNextEnabled();
    clearError();
  }

  function clearError() {
    const e = $("wizardError");
    e.classList.add("d-none");
    e.textContent = "";
  }
  function showError(msg) {
    const e = $("wizardError");
    e.textContent = msg;
    e.classList.remove("d-none");
  }

  function refreshNextEnabled() {
    let ok = false;
    if (currentStep === 1) ok = !!selectedProvider && namePrefix.trim().length > 0;
    else if (currentStep === 2) ok = true;
    else if (currentStep === 3) ok = validateCreds();
    else if (currentStep === 4) ok = validateIps();
    else if (currentStep === 5) ok = numbers.length > 0;
    else if (currentStep === 6) ok = true;
    $("wizardNextBtn").disabled = !ok;
    $("wizardCreateBtn").disabled = !validateCreds() || !validateIps() || numbers.length === 0 || !namePrefix.trim();
  }

  // ---------- Step 1: tiles ----------
  function renderProviderTiles() {
    const container = $("wizardProviderTiles");
    container.replaceChildren();
    PROVIDER_ORDER.forEach((slug) => {
      const p = PROVIDERS[slug];
      if (!p) return;
      const col = el("div", { className: "col" });
      const tile = el("div", { className: "wizard-provider-tile" });
      tile.dataset.slug = slug;
      if (p.recommended) {
        tile.appendChild(el("span", { className: "badge bg-success badge-recommended", text: "Recommended" }));
      }
      // Logo chip: a real provider logo when one is bundled, otherwise the
      // brand-tinted Bootstrap glyph. The chip keeps a consistent footprint so
      // logo tiles and icon-fallback tiles line up in the grid.
      const chip = el("div", { className: "tile-logo-chip" });
      const buildIcon = () => {
        const ic = el("i", { className: "bi " + p.icon + " tile-icon" });
        ic.style.color = p.iconColor || "var(--text-primary)";
        return ic;
      };
      if (p.logo) {
        // logoOnDark logos already carry a dark/transparent background and sit
        // directly on the dark tile; everyone else gets a white chip so their
        // mark reads against the dark theme.
        if (!p.logoOnDark) chip.classList.add("has-img");
        const img = el("img", { className: "tile-logo", attrs: { src: p.logo, alt: p.name + " logo", loading: "lazy" } });
        // If the bundled logo 404s on an older install, fall back to the glyph.
        img.addEventListener("error", () => {
          chip.classList.remove("has-img");
          chip.replaceChildren(buildIcon());
        });
        chip.appendChild(img);
      } else {
        chip.appendChild(buildIcon());
      }
      tile.appendChild(chip);
      tile.appendChild(el("div", { className: "tile-name", text: p.name }));
      tile.appendChild(el("div", { className: "tile-tag", text: p.tagline }));
      tile.addEventListener("click", () => {
        document.querySelectorAll(".wizard-provider-tile").forEach((t) => t.classList.remove("selected"));
        tile.classList.add("selected");
        selectedProvider = slug;
        refreshNextEnabled();
      });
      col.appendChild(tile);
      container.appendChild(col);
    });
  }

  // ---------- Step 2: portal checklist ----------
  function renderPortal() {
    const p = PROVIDERS[selectedProvider];
    if (!p) return;
    $("wizardPortalHeading").textContent = `Set up your ${p.name} account`;
    const portalBtn = $("wizardPortalUrlBtn");
    portalBtn.href = p.portalUrl;
    $("wizardPortalUrlLabel").textContent = `Open ${p.portalLabel || p.name + " Portal"}`;
    $("wizardGuideBtn").href = p.docUrl || `/settings/download/doc/${p.docSlug}`;
    const checklist = $("wizardChecklist");
    checklist.replaceChildren();
    (p.checklist || []).forEach((item) => {
      const li = el("li", { className: "list-group-item d-flex align-items-center gap-2" });
      const cb = el("input", { className: "form-check-input m-0" });
      cb.type = "checkbox";
      li.appendChild(cb);
      li.appendChild(el("span", { text: item }));
      checklist.appendChild(li);
    });
    const note = $("wizardPortalNote");
    if (p.portalNote) {
      note.textContent = p.portalNote;
      note.classList.remove("d-none");
    } else {
      note.classList.add("d-none");
    }
  }

  // ---------- Step 3: credentials ----------
  function renderCreds() {
    const p = PROVIDERS[selectedProvider];
    if (!p) return;
    $("wizardCredsHeading").textContent = `${p.name} credentials`;
    $("wizardCredsBlurb").textContent = "Paste the values you copied from the provider portal.";
    const container = $("wizardCredsFields");
    container.replaceChildren();
    credValues = {};
    (p.fields || []).forEach((f) => {
      const wrap = el("div", { className: "mb-3" });
      wrap.appendChild(el("label", { className: "form-label", text: f.label + (f.required ? " *" : "") }));
      let input;
      if (f.type === "select") {
        input = el("select", { className: "form-select" });
        (f.options || []).forEach((opt) => {
          const o = el("option", { text: opt.label });
          o.value = opt.value;
          input.appendChild(o);
        });
      } else if (f.type === "textarea") {
        input = el("textarea", { className: "form-control font-monospace" });
        input.rows = 3;
      } else {
        input = el("input", { className: "form-control" });
        input.type = f.type || "text";
      }
      input.id = `wizardField_${f.key}`;
      if (f.placeholder) input.placeholder = f.placeholder;
      if (f.value !== undefined) {
        input.value = f.value;
        credValues[f.key] = f.value;
      }
      const onChange = () => {
        credValues[f.key] = input.value;
        refreshNextEnabled();
      };
      input.addEventListener("input", onChange);
      input.addEventListener("change", onChange);
      wrap.appendChild(input);
      if (f.help) wrap.appendChild(el("small", { className: "form-text text-muted", text: f.help }));
      container.appendChild(wrap);
      if (f.type === "select") credValues[f.key] = input.value;
    });
  }

  function validateCreds() {
    const p = PROVIDERS[selectedProvider];
    if (!p) return false;
    return (p.fields || []).every((f) => {
      if (!f.required) return true;
      return ((credValues[f.key] || "") + "").trim().length > 0;
    });
  }

  // ---------- Step 4: allowed IPs ----------
  function renderIps() {
    const p = PROVIDERS[selectedProvider];
    if (!p) return;
    const ta = $("wizardIps");
    const skipNote = $("wizardIpsSkipNote");
    const help = $("wizardIpsHelp");
    if (p.ipsSkip) {
      ta.classList.add("d-none");
      ta.value = "";
      help.textContent = "";
      skipNote.textContent = p.ipsSkipNote || "Not needed for this provider — click Next to continue.";
      skipNote.classList.remove("d-none");
    } else {
      ta.classList.remove("d-none");
      skipNote.classList.add("d-none");
      ta.value = (p.defaultIps || []).join("\n");
      help.textContent = (p.ipsHelp || "") + (p.ipsRequired ? " — required." : "");
    }
    refreshNextEnabled();
  }

  function bindIpsInput() {
    const ta = $("wizardIps");
    if (!ta) return;
    const onChange = () => refreshNextEnabled();
    ta.addEventListener("input", onChange);
    ta.addEventListener("change", onChange);
  }

  function getIpsList() {
    const p = PROVIDERS[selectedProvider];
    if (!p || p.ipsSkip) return [];
    const raw = ($("wizardIps").value || "").trim();
    if (!raw) return [];
    return raw.split(/[\n,]/).map((s) => s.trim()).filter(Boolean);
  }

  function validateIps() {
    const p = PROVIDERS[selectedProvider];
    if (!p) return false;
    if (p.ipsSkip) return true;
    if (!p.ipsRequired) return true;
    return getIpsList().length > 0;
  }

  // ---------- Step 5: numbers ----------
  function bindNumbersInput() {
    const ta = $("wizardNumbers");
    const counter = $("wizardNumberCount");
    ta.addEventListener("input", () => {
      const lines = ta.value.split(/[\n,]/).map((s) => s.trim()).filter(Boolean);
      numbers = lines
        .map((n) => n.replace(/[^\d+]/g, ""))
        .filter((n) => /^\+?\d{6,}$/.test(n));
      counter.textContent = `${numbers.length} number${numbers.length === 1 ? "" : "s"}`;
      refreshNextEnabled();
    });
  }

  // ---------- Step 6: summary ----------
  function summaryRow(label, value, isCode) {
    const div = el("div");
    div.appendChild(el("strong", { text: label + ": " }));
    if (isCode) {
      div.appendChild(el("code", { text: value }));
    } else {
      div.appendChild(document.createTextNode(value));
    }
    return div;
  }

  function renderSummary() {
    const payload = buildPayload();
    const inb = $("wizardSummaryInbound");
    inb.replaceChildren(
      summaryRow("Name", `${payload.name_prefix} Inbound`),
      summaryRow("Numbers", String(payload.numbers.length)),
      summaryRow("Allowed IPs", String((payload.inbound.allowed_addresses || []).length || "(any)")),
      summaryRow("Number format", payload.inbound.number_format)
    );
    const outb = $("wizardSummaryOutbound");
    outb.replaceChildren(
      summaryRow("Name", `${payload.name_prefix} Outbound`),
      summaryRow("Address", payload.outbound.address || "(missing)", true),
      summaryRow("Transport", payload.outbound.transport),
      summaryRow("Auth", payload.outbound.auth_username ? "Digest (" + payload.outbound.auth_username + ")" : "None")
    );
    const rule = $("wizardSummaryRule");
    const agentSel = $("wizardAgentSelect");
    const tpSel = $("wizardTimeProfileSelect");
    const agentLabel = agentSel && agentSel.value
      ? (agentSel.options[agentSel.selectedIndex].text || agentSel.value)
      : "(none — assign later)";
    const tpLabel = tpSel && tpSel.value
      ? (tpSel.options[tpSel.selectedIndex].text || tpSel.value)
      : "(none — always active)";
    rule.replaceChildren(
      summaryRow("Name", `${payload.name_prefix} Inbound Rule`),
      summaryRow("Type", payload.dispatch.rule_type),
      summaryRow("Agent", agentLabel),
      summaryRow("Time profile", tpLabel),
      summaryRow("Auto-record", payload.dispatch.auto_record ? "Enabled" : "Disabled"),
      summaryRow("Bound to", `the new ${payload.name_prefix} inbound trunk`)
    );
  }

  // ---------- Submit payload ----------
  function buildPayload() {
    const p = PROVIDERS[selectedProvider];
    const preset = (p && p.preset) || {};
    const csrfToken = modal().dataset.csrfToken || "";

    let outboundAddress = "";
    if (typeof p.computeOutboundAddress === "function") {
      outboundAddress = p.computeOutboundAddress(credValues);
    } else if (credValues.outbound_address) {
      outboundAddress = credValues.outbound_address;
    } else if (preset.outbound && preset.outbound.address) {
      outboundAddress = preset.outbound.address;
    }

    // Inbound allowed IPs come from Step 4's textarea (user may have edited the
    // pre-filled defaults). For ipsSkip providers (Cloudonix), this is empty.
    const inboundAllowed = getIpsList();

    const numberFormat = (preset.outbound && preset.outbound.number_format) || "with_plus";
    const normalisedNumbers = numbers.map((n) => {
      if (numberFormat === "no_plus") return n.replace(/^\+/, "");
      return n.startsWith("+") ? n : "+" + n;
    });

    return {
      csrf_token: csrfToken,
      provider: selectedProvider,
      name_prefix: (namePrefix || p.name).trim(),
      numbers: normalisedNumbers,
      inbound: {
        allowed_addresses: inboundAllowed,
        auth_username: "",
        auth_password: "",
        number_format: (preset.inbound && preset.inbound.number_format) || numberFormat
      },
      outbound: {
        address: outboundAddress,
        transport: (preset.outbound && preset.outbound.transport) || "tls",
        auth_username: credValues.auth_username || "",
        auth_password: credValues.auth_password || "",
        trunk_type: (preset.outbound && preset.outbound.trunk_type) || "pstn",
        number_format: numberFormat
      },
      dispatch: {
        rule_type: (preset.dispatch && preset.dispatch.rule_type) || "individual",
        room_prefix: ((namePrefix || p.name) || "wizard").toLowerCase().replace(/[^a-z0-9]+/g, "-") + "-call-",
        agent_slug: ($("wizardAgentSelect") && $("wizardAgentSelect").value) || "",
        time_profile_id: ($("wizardTimeProfileSelect") && $("wizardTimeProfileSelect").value) || "",
        auto_record: !!($("wizardAutoRecord") && $("wizardAutoRecord").checked)
      }
    };
  }

  async function submitWizard() {
    clearError();
    const payload = buildPayload();
    const createBtn = $("wizardCreateBtn");
    const original = createBtn.textContent;
    createBtn.disabled = true;
    createBtn.replaceChildren(
      el("span", { className: "spinner-border spinner-border-sm me-2" }),
      document.createTextNode("Creating...")
    );

    try {
      const res = await fetch("/telephony/wizard/setup", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Content-Type": "application/json", "X-CSRFToken": payload.csrf_token },
        body: JSON.stringify(payload)
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.success) {
        const stepLabel = data.step ? `(${data.step}) ` : "";
        showError(stepLabel + (data.error || `HTTP ${res.status} — please check the credentials and try again.`));
        createBtn.textContent = original;
        createBtn.disabled = false;
        return;
      }
      showStep("success");
    } catch (err) {
      showError("Network error: " + (err && err.message ? err.message : err));
      createBtn.textContent = original;
      createBtn.disabled = false;
    }
  }

  function reset() {
    currentStep = 1;
    selectedProvider = null;
    namePrefix = "";
    credValues = {};
    numbers = [];
    const taN = $("wizardNumbers");
    if (taN) taN.value = "";
    const taIp = $("wizardIps");
    if (taIp) taIp.value = "";
    const nameInput = $("wizardNamePrefix");
    if (nameInput) nameInput.value = "";
    const autoRec = $("wizardAutoRecord");
    if (autoRec) autoRec.checked = true;
    const agentSel = $("wizardAgentSelect");
    if (agentSel) agentSel.value = "";
    const tpSel = $("wizardTimeProfileSelect");
    if (tpSel) tpSel.value = "";
    if ($("wizardNumberCount")) $("wizardNumberCount").textContent = "0 numbers";
    document.querySelectorAll(".wizard-provider-tile").forEach((t) => t.classList.remove("selected"));
    showStep(1);
  }

  let wired = false;
  function wireUp() {
    if (wired) return;
    wired = true;

    renderProviderTiles();
    bindNumbersInput();
    bindIpsInput();

    const nameInput = $("wizardNamePrefix");
    if (nameInput) {
      const onNameChange = () => {
        namePrefix = nameInput.value;
        refreshNextEnabled();
      };
      nameInput.addEventListener("input", onNameChange);
      nameInput.addEventListener("change", onNameChange);
    }

    $("wizardNextBtn").addEventListener("click", () => {
      if (currentStep === 1) { renderPortal(); showStep(2); }
      else if (currentStep === 2) { renderCreds(); showStep(3); }
      else if (currentStep === 3) { renderIps(); showStep(4); }
      else if (currentStep === 4) { showStep(5); }
      else if (currentStep === 5) { renderSummary(); showStep(6); }
    });
    $("wizardBackBtn").addEventListener("click", () => {
      if (currentStep === 6) showStep(5);
      else if (currentStep === 5) showStep(4);
      else if (currentStep === 4) showStep(3);
      else if (currentStep === 3) showStep(2);
      else if (currentStep === 2) showStep(1);
    });
    $("wizardCreateBtn").addEventListener("click", submitWizard);
    $("wizardDoneBtn").addEventListener("click", () => window.location.reload());

    modal().addEventListener("hidden.bs.modal", () => {
      if (currentStep === "success") window.location.reload();
      else reset();
    });
  }

  async function loadOptions() {
    if (optionsLoaded) return;
    try {
      const res = await fetch("/telephony/wizard/options", { credentials: "same-origin" });
      const data = await res.json().catch(() => ({}));
      const agentSel = $("wizardAgentSelect");
      const tpSel = $("wizardTimeProfileSelect");
      if (agentSel && Array.isArray(data.agents)) {
        // Strip any prior dynamic options (keep the leading "(None)" placeholder)
        while (agentSel.options.length > 1) agentSel.remove(1);
        data.agents.forEach((a) => {
          const o = el("option", { text: `${a.name} (${a.slug})` });
          o.value = a.slug;
          agentSel.appendChild(o);
        });
      }
      if (tpSel && Array.isArray(data.time_profiles)) {
        while (tpSel.options.length > 1) tpSel.remove(1);
        data.time_profiles.forEach((tp) => {
          const o = el("option", { text: tp.name });
          o.value = tp.id;
          tpSel.appendChild(o);
        });
      }
      optionsLoaded = true;
    } catch (err) {
      // Non-fatal: dropdowns just stay with "(None)" — operator can edit the rule later
      console.warn("SIP wizard: failed to load agents/time profiles", err);
    }
  }

  window.openSipSetupWizard = function () {
    wireUp();
    reset();
    loadOptions();
    const m = modal();
    if (!m) return;
    bootstrap.Modal.getOrCreateInstance(m).show();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => { if (modal()) wireUp(); });
  } else {
    if (modal()) wireUp();
  }
})();
