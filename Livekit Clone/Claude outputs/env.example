# Aetos Lattice Backend — Environment Configuration
# Copy this file to .env and fill in production values

# DATABASE
# Development: sqlite:///lattice.db
# Production: postgresql://user:password@host:5432/lattice_db
DATABASE_URL=sqlite:///lattice.db

# SECURITY
# Generate production SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
# Comma-separated list of allowed origins for production
# Example: https://dashboard.aetos-lattice.com,https://api.aetos-lattice.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ENVIRONMENT
DEBUG=True

# RATE LIMITING (optional)
MAX_REQUESTS_PER_MINUTE=100

# FILE UPLOADS
FILE_UPLOAD_DIR=/tmp/lattice-uploads
MAX_FILE_SIZE_MB=100

# LOGGING (optional for production)
LOG_LEVEL=INFO
LOG_FILE=/var/log/lattice/app.log
