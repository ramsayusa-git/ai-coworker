# Auto-HTTPS for the customer's own domain. On-demand TLS: point any hostname here and the cert is issued on first request.
{
  on_demand_tls { ask http://core:8100/api/v1/system/tls-ask }
}
{$AETOS_DOMAIN} {
  tls { on_demand }
  encode zstd gzip
  request_body { max_size 2GB }      # backups upload in one piece — no chunking hack needed
  handle /api/* { reverse_proxy core:8100 }
  handle /mcp*  { reverse_proxy core:8100 }
  handle /ws/*  { reverse_proxy core:8100 }
  handle_errors { @502 expression {http.error.status_code} == 502
    handle @502 { rewrite * /restarting.html  root * /srv/frontend  file_server } }
  handle { root * /srv/frontend  try_files {path} /index.html  file_server }
  log { output stdout  format json }   # fail2ban reads JSON
}
