#!/bin/sh
# Aetos One - first-boot add-on REPOSITORY registrar (v11: repos-only, NO installs).
# Adds the curated Aetos add-on-store repositories and reloads the store so they
# appear under Settings > Apps > Store. It does NOT install any add-on, by design
# (product spec: "add as app repos, don't install apps"). Users install on demand.
FLAG=/mnt/data/aetos/addons-repos-added
[ -f "$FLAG" ] && exit 0
mkdir -p /mnt/data/aetos 2>/dev/null
ATT=/mnt/data/aetos/addons-repos-attempts
n=$(cat "$ATT" 2>/dev/null || echo 0); n=$((n + 1)); echo "$n" > "$ATT"

# Curated Supervisor add-on-store repositories (add-on store only; HACS items are
# intentionally excluded here - they are not add-on repositories).
REPOS="https://github.com/blakeblackshear/frigate-hass-addons
https://github.com/homeassistant-ai/ha-mcp
https://github.com/Ferdinand99/home-assistant-newt-addon
https://github.com/netbirdio/addon-netbird
https://github.com/brenner-tobias/ha-addons"

# 1) Wait for Core + supervisor token (up to ~20 min on slow cards).
T=""; i=0
while [ $i -lt 300 ]; do
  T=$(docker exec homeassistant printenv SUPERVISOR_TOKEN 2>/dev/null)
  [ -n "$T" ] && break
  i=$((i + 1)); sleep 10
done
[ -z "$T" ] && { echo "aetos-repos: no Core token yet; will retry next boot."; exit 0; }

api() { docker exec homeassistant curl -s -m 300 -H "Authorization: Bearer $T" "$@"; }

# 2) Wait for Core to be RUNNING before touching the store.
i=0
while [ $i -lt 120 ]; do
  st=$(api http://supervisor/core/info | docker exec -i homeassistant python3 -c 'import sys,json;print(json.load(sys.stdin).get("data",{}).get("state",""))' 2>/dev/null)
  [ "$st" = "running" ] && break
  i=$((i + 1)); sleep 10
done

# 3) Add repositories + reload the store. NO installs.
ok=0; tot=0
for url in $REPOS; do
  tot=$((tot + 1))
  api -X POST -H "Content-Type: application/json" -d "{\"repository\":\"$url\"}" \
      http://supervisor/store/repositories >/dev/null 2>&1 && ok=$((ok + 1))
done
api -X POST http://supervisor/store/reload >/dev/null 2>&1
sleep 20

# 4) Verify our repos are live: the store should now list a Frigate add-on.
FR=$(api http://supervisor/store/addons | docker exec -i homeassistant python3 -c 'import sys,json
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
al=d.get("data",{}).get("addons") or d.get("addons") or []
print(sum(1 for a in al if "frigate" in ((a.get("slug","") or "")+" "+(a.get("name","") or "")).lower()))' 2>/dev/null)

echo "aetos-repos: attempt $n -> posted $ok/$tot repos; frigate add-ons visible: ${FR:-0}."
if [ -n "$FR" ] && [ "$FR" -ge 1 ]; then
  touch "$FLAG"; echo "aetos-repos: repositories registered, NO apps installed (by design). Done."
elif [ "$n" -ge 8 ]; then
  touch "$FLAG"; echo "aetos-repos: bounded stop after $n attempts (repos posted; store slow to index)."
else
  echo "aetos-repos: store not confirmed yet; will retry next boot."
fi
exit 0
