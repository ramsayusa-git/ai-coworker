diff --git a/src/components/aetos-top-nav.ts b/src/components/aetos-top-nav.ts
new file mode 100644
index 000000000..673344563
--- /dev/null
+++ b/src/components/aetos-top-nav.ts
@@ -0,0 +1,195 @@
+import { css, html, LitElement, nothing } from "lit";
+import type { TemplateResult } from "lit";
+import { customElement, property } from "lit/decorators";
+import { fireEvent } from "../common/dom/fire_event";
+import { navigate } from "../common/navigate";
+import type { HomeAssistant } from "../types";
+
+@customElement("aetos-top-nav")
+export class AetosTopNav extends LitElement {
+  @property({ attribute: false }) public hass!: HomeAssistant;
+
+  private _navItems(): { path: string; title: string }[] {
+    const panels: any = this.hass?.panels || {};
+    const items: { path: string; title: string }[] = [];
+    // Lovelace dashboards first (Overview + any custom dashboards)
+    Object.keys(panels).forEach((key) => {
+      const p = panels[key];
+      if (p && p.component_name === "lovelace") {
+        items.push({ path: `/${p.url_path || key}`, title: p.title || "Home" });
+      }
+    });
+    // Common built-in panels
+    if (panels.energy) items.push({ path: "/energy", title: "Energy" });
+    if (panels.history) items.push({ path: "/history", title: "History" });
+    if (panels.config) items.push({ path: "/config", title: "Settings" });
+    return items;
+  }
+
+  private _isActive(path: string): boolean {
+    const cur = this.hass?.panelUrl
+      ? `/${this.hass.panelUrl}`
+      : window.location.pathname;
+    return cur === path || cur.startsWith(`${path}/`);
+  }
+
+  protected render(): TemplateResult | typeof nothing {
+    if (!this.hass) {
+      return nothing;
+    }
+    const user = this.hass.user;
+    const initial = (user?.name || "U").trim().charAt(0).toUpperCase();
+    return html`
+      <header class="bar">
+        <div class="brand" @click=${this._home}>
+          <img
+            class="shield"
+            src="/static/icons/aetos-shield.png"
+            alt="Aetos One"
+          />
+          <span class="brand-name">Aetos One</span>
+        </div>
+        <nav class="nav">
+          ${this._navItems().map(
+            (i) => html`
+              <a
+                class=${this._isActive(i.path) ? "on" : ""}
+                @click=${() => navigate(i.path)}
+                >${i.title}</a
+              >
+            `
+          )}
+        </nav>
+        <div class="right">
+          <button class="ic" title="Notifications" @click=${this._notifications}>
+            &#128276;
+          </button>
+          <button class="ic" title="Menu" @click=${this._menu}>&#9776;</button>
+          <button
+            class="avatar"
+            title=${user?.name || ""}
+            @click=${() => navigate("/profile")}
+          >
+            ${initial}
+          </button>
+        </div>
+      </header>
+    `;
+  }
+
+  private _home() {
+    navigate("/");
+  }
+
+  private _menu() {
+    fireEvent(this, "hass-toggle-menu");
+  }
+
+  private _notifications() {
+    fireEvent(this, "hass-show-notifications");
+  }
+
+  static styles = css`
+    :host {
+      display: block;
+    }
+    .bar {
+      position: relative;
+      width: 100%;
+      height: 56px;
+      display: flex;
+      align-items: center;
+      gap: 20px;
+      padding: 0 16px;
+      background: #ffffff;
+      border-bottom: 3px solid #273a80;
+      box-sizing: border-box;
+      padding-left: calc(16px + var(--safe-area-inset-left, 0px));
+      padding-right: calc(16px + var(--safe-area-inset-right, 0px));
+    }
+    .brand {
+      display: flex;
+      align-items: center;
+      gap: 9px;
+      cursor: pointer;
+      flex-shrink: 0;
+    }
+    .shield {
+      height: 38px;
+      width: 38px;
+      object-fit: contain;
+      display: block;
+    }
+    .brand-name {
+      font-size: 18px;
+      font-weight: 800;
+      color: #273a80;
+      letter-spacing: 0.2px;
+      white-space: nowrap;
+    }
+    .nav {
+      display: flex;
+      gap: 2px;
+      flex: 1;
+      overflow-x: auto;
+      scrollbar-width: none;
+    }
+    .nav::-webkit-scrollbar {
+      display: none;
+    }
+    .nav a {
+      color: #3a4568;
+      font-size: 14px;
+      font-weight: 500;
+      padding: 8px 13px;
+      border-radius: 8px;
+      text-decoration: none;
+      white-space: nowrap;
+      cursor: pointer;
+      line-height: 40px;
+    }
+    .nav a:hover {
+      background: #f2f4fb;
+    }
+    .nav a.on {
+      color: #273a80;
+      font-weight: 700;
+      box-shadow: inset 0 -3px 0 #e6701c;
+    }
+    .right {
+      display: flex;
+      align-items: center;
+      gap: 8px;
+    }
+    .ic {
+      border: none;
+      background: transparent;
+      font-size: 17px;
+      cursor: pointer;
+      width: 36px;
+      height: 36px;
+      border-radius: 50%;
+      color: #3a4568;
+    }
+    .ic:hover {
+      background: #f2f4fb;
+    }
+    .avatar {
+      border: none;
+      width: 32px;
+      height: 32px;
+      border-radius: 50%;
+      background: #e6701c;
+      color: #fff;
+      font-size: 13px;
+      font-weight: 700;
+      cursor: pointer;
+    }
+  `;
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    "aetos-top-nav": AetosTopNav;
+  }
+}
