new file mode 100644
index 000000000..25a67af50
--- /dev/null
+++ b/src/panels/config/branding/ha-config-branding.ts
@@ -0,0 +1,349 @@
+import { mdiContentSave, mdiLock, mdiRestore } from "@mdi/js";
+import { css, html, LitElement, nothing } from "lit";
+import type { TemplateResult } from "lit";
+import { customElement, property, state } from "lit/decorators";
+import "../../../components/ha-card";
+import "../../../components/ha-button";
+import "../../../components/ha-svg-icon";
+import "../../../components/ha-picture-upload";
+import "../../../layouts/hass-subpage";
+import { haStyle } from "../../../resources/styles";
+import type { HomeAssistant, Route } from "../../../types";
+
+@customElement("ha-config-branding")
+export class HaConfigBranding extends LitElement {
+  @property({ attribute: false }) public hass!: HomeAssistant;
+
+  @property({ type: Boolean }) public narrow = false;
+
+  @property({ attribute: false }) public route!: Route;
+
+  @state() private _unlocked = false;
+
+  @state() private _pinInput = "";
+
+  @state() private _pinError = false;
+
+  @state() private _name = "";
+
+  @state() private _logo: string | null = null;
+
+  @state() private _primary = "#273A80";
+
+  @state() private _accent = "#E6701C";
+
+  @state() private _saved = false;
+
+  private _loaded = false;
+
+  private _st(id: string): string {
+    const s = this.hass?.states?.[id]?.state;
+    return s && s !== "unknown" && s !== "unavailable" ? s : "";
+  }
+
+  // Fixed, permanent access password for the Branding page (white-label lock).
+  // Same on every device, not user-changeable.
+  private _pin(): string {
+    return "Suseelarao@1";
+  }
+
+  protected willUpdate() {
+    if (!this._loaded && this.hass) {
+      this._name = this._st("input_text.aetos_brand_name") || "Aetos One";
+      this._logo = this._st("input_text.aetos_brand_logo") || null;
+      this._primary = this._st("input_text.aetos_primary_color") || "#273A80";
+      this._accent = this._st("input_text.aetos_accent_color") || "#E6701C";
+      this._loaded = true;
+      // PIN gate is ALWAYS required (including admins) — no auto-unlock.
+    }
+  }
+
+  protected render(): TemplateResult {
+    return html`
+      <hass-subpage
+        .hass=${this.hass}
+        .narrow=${this.narrow}
+        .route=${this.route}
+        header="Branding"
+      >
+        <div class="content">
+          ${this._unlocked ? this._renderForm() : this._renderGate()}
+        </div>
+      </hass-subpage>
+    `;
+  }
+
+  private _renderGate(): TemplateResult {
+    return html`
+      <ha-card outlined class="gate">
+        <div class="card-content">
+          <ha-svg-icon .path=${mdiLock}></ha-svg-icon>
+          <h3>Protected page</h3>
+          <p>Enter the branding PIN to continue.</p>
+          <input
+            class="fld"
+            type="password"
+            placeholder="PIN"
+            .value=${this._pinInput}
+            @input=${this._pinChanged}
+            @keydown=${this._pinKey}
+          />
+          ${this._pinError
+            ? html`<p class="err">Incorrect PIN</p>`
+            : nothing}
+          <ha-button appearance="filled" @click=${this._checkPin}
+            >Unlock</ha-button
+          >
+        </div>
+      </ha-card>
+    `;
+  }
+
+  private _pinChanged(e: any) {
+    this._pinInput = e.target.value;
+  }
+
+  private _pinKey(e: KeyboardEvent) {
+    if (e.key === "Enter") {
+      this._checkPin();
+    }
+  }
+
+  private _checkPin() {
+    if (this._pinInput === this._pin()) {
+      this._unlocked = true;
+      this._pinError = false;
+    } else {
+      this._pinError = true;
+    }
+  }
+
+  private _renderForm(): TemplateResult {
+    return html`
+      <ha-card outlined header="Brand identity">
+        <div class="card-content">
+          <label class="fld-label">Product name</label>
+          <input
+            class="fld"
+            type="text"
+            .value=${this._name}
+            @input=${(e: any) => {
+              this._name = e.target.value;
+            }}
+          />
+
+          <div class="field">
+            <label>Logo</label>
+            <ha-picture-upload
+              .hass=${this.hass}
+              .value=${this._logo}
+              crop
+              .cropOptions=${{ round: false, aspectRatio: 1 }}
+              .size=${512}
+              .supports=${"Square logo — cropped & resized to 512×512 (PNG with transparent background recommended)"}
+              @change=${(e: any) => {
+                this._logo = e.target.value;
+              }}
+            ></ha-picture-upload>
+          </div>
+
+          <div class="colors">
+            <div class="color">
+              <label>Primary color</label>
+              <input
+                type="color"
+                .value=${this._primary}
+                @input=${(e: any) => {
+                  this._primary = e.target.value;
+                }}
+              />
+              <span>${this._primary}</span>
+            </div>
+            <div class="color">
+              <label>Accent color</label>
+              <input
+                type="color"
+                .value=${this._accent}
+                @input=${(e: any) => {
+                  this._accent = e.target.value;
+                }}
+              />
+              <span>${this._accent}</span>
+            </div>
+          </div>
+        </div>
+        <div class="card-actions">
+          <ha-button appearance="filled" @click=${this._save}>
+            <ha-svg-icon slot="start" .path=${mdiContentSave}></ha-svg-icon>
+            Save branding
+          </ha-button>
+          <ha-button appearance="plain" @click=${this._reset}>
+            <ha-svg-icon slot="start" .path=${mdiRestore}></ha-svg-icon>
+            Reset to Aetos One
+          </ha-button>
+          ${this._saved ? html`<span class="ok">Saved ✓</span>` : nothing}
+        </div>
+      </ha-card>
+
+      <ha-card outlined header="Live preview">
+        <div class="card-content">
+          <div
+            class="pv-bar"
+            style="border-bottom:3px solid ${this._primary}"
+          >
+            ${this._logo
+              ? html`<img class="pv-logo" src=${this._logo} alt="logo" />`
+              : nothing}
+            <span class="pv-name" style="color:${this._primary}"
+              >${this._name}</span
+            >
+            <span class="pv-chip" style="background:${this._accent}"></span>
+          </div>
+        </div>
+      </ha-card>
+    `;
+  }
+
+  private async _setVal(entity: string, value: string) {
+    if (!this.hass.states[entity]) {
+      return;
+    }
+    await this.hass.callService("input_text", "set_value", {
+      entity_id: entity,
+      value,
+    });
+  }
+
+  private async _save() {
+    await this._setVal("input_text.aetos_brand_name", this._name);
+    await this._setVal("input_text.aetos_brand_logo", this._logo || "");
+    await this._setVal("input_text.aetos_primary_color", this._primary);
+    await this._setVal("input_text.aetos_accent_color", this._accent);
+    this._saved = true;
+    setTimeout(() => {
