#!/bin/sh
# Aetos One - boot-time clock guard (fake-hwclock style).
#
# WHY: the Raspberry Pi has no battery-backed RTC. On boot the clock starts at
# the stale timestamp baked into the image (the base HAOS build date). It is
# normally corrected by NTP - but on networks that BLOCK NTP (outbound UDP 123),
# the clock stays ~months in the past. A past clock makes every TLS certificate
# read as "not yet valid", so the Supervisor's internet check fails and it
# refuses to clone the add-on store (empty Apps page) and HACS/HTTPS break.
#
# FIX: never let the clock sit absurdly in the past. On boot, raise it to the
# newest of:
#   - the baked build epoch (/usr/share/aetos/build-epoch), and
#   - the last-known-good time persisted on the data partition (clock.save,
#     refreshed continuously by aetos-update-block).
# This guarantees the clock is >= image build date even with NTP fully blocked,
# so TLS validates and the store works. NTP still corrects upward when allowed.

FLOOR_FILE="/usr/share/aetos/build-epoch"
SAVE="/mnt/data/aetos/clock.save"

read_epoch() {  # $1=file -> digits only, or empty
    [ -r "$1" ] || return 0
    tr -dc '0-9' < "$1" 2>/dev/null
}

now=$(date +%s 2>/dev/null)
floor=$(read_epoch "$FLOOR_FILE"); [ -n "$floor" ] || floor=0
saved=$(read_epoch "$SAVE");       [ -n "$saved" ] || saved=0

# target = max(floor, saved)
target=$floor
[ "$saved" -gt "$target" ] 2>/dev/null && target=$saved

if [ "${target:-0}" -gt "${now:-0}" ] 2>/dev/null; then
    date -s "@$target" >/dev/null 2>&1
    hwclock -w >/dev/null 2>&1 || true
    echo "aetos-clock-guard: advanced clock to $(date -u -d "@$target" 2>/dev/null || date -u)"
else
    echo "aetos-clock-guard: clock OK ($(date -u))"
fi

# Make sure NTP stays enabled so it can fine-tune when the network permits it.
timedatectl set-ntp true >/dev/null 2>&1 || true

# Seed the persistence dir + file so update-block can keep it fresh.
mkdir -p /mnt/data/aetos 2>/dev/null
[ -f "$SAVE" ] || date +%s > "$SAVE" 2>/dev/null
exit 0
