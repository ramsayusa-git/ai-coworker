# Aetos One frontend-fork branding config
# Edit these, commit, and the GitHub Action will build a branded frontend wheel.

# The home-assistant/frontend git ref to build FROM.
# Must match the frontend version your HA core expects. Find yours on lab01 with:
#   sudo docker exec homeassistant python3 -c "import hass_frontend;print(hass_frontend.VERSION)"
# then use the matching tag from https://github.com/home-assistant/frontend/tags
# (frontend tags look like 20260702.0). Leave 'dev' only for experimenting.
FRONTEND_REF=20260624.5

# Brand strings
BRAND_NAME="Aetos One"
BRAND_SHORT="Aetos"
OLD_NAME="Home Assistant"

# Brand colors (used for the default theme primary/accent)
BRAND_PRIMARY="#273A80"
BRAND_ACCENT="#E6701C"

# Primary brand LOGO — ALWAYS the SQUARE SHIELD (eagle-in-shield), never the full
# "AETOS ONE" wordmark. Used for every brand mark: login, onboarding, sidebar,
# About, favicon, PWA/app icon. brand-logo.png is the square shield (512x512).
BRAND_LOGO="brand-logo.png"          # assets/brand-logo.png  (square shield)
