# Copy to .env and fill in. Never commit the filled copy.

# Postgres. The role needs CREATE on the database; tenant provisioning also needs
# CREATE SCHEMA for schema-per-tenant isolation.
DATABASE_URL=postgres://user:password@localhost:5432/whatsup

# Optional. Used for background job queues when present.
REDIS_URL=redis://localhost:6379

PORT=4000

# Signs session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=

# Signs every self-hosted/on-prem/dedicated licence key. Keep secret: every key ever
# issued verifies against it, so rotating it invalidates all outstanding licences.
# Generate with: openssl rand -hex 32
LICENSE_SIGNING_SECRET=

# Set to "on" ONLY for seed scripts and migrations, never for the API server. It sets
# app.bypass_rls, which disables row-level security for the connection — see
# src/db/migrations/0004_rls_policies.sql.
# RLS_BYPASS=on

# Per-tenant database connection strings, for orgs on `database` or `app` isolation.
# The orgs table stores only a reference (e.g. tenant_abc123); the string lives here or
# in your secret manager. Name pattern: TENANT_DB_<REFERENCE IN UPPER CASE>
# TENANT_DB_TENANT_ABC123=postgres://user:password@host:5432/loqio_abc123
