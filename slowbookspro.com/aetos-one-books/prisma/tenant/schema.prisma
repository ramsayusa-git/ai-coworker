// =============================================================================
// Aetos One Books — TENANT schema
// =============================================================================
// Applied to EVERY org environment, whatever its isolation tier:
//   SCHEMA tier    -> one Postgres schema inside a shared database
//   DATABASE tier  -> its own database
//   DEDICATED tier -> its own database served by its own app runtime
//   SELF_HOSTED    -> the customer's own single database
//
// There is deliberately NO org_id / company_id column anywhere below: the
// environment IS the boundary. Identity, org registry and branding live in the
// control-plane schema (prisma/control/schema.prisma).
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
}

// ==== ACCOUNTING CORE ====
// Upstream: SlowBooks Pro 2026 (FastAPI + SQLAlchemy). Spec: 01-accounting-core.md
//
// DIVERGENCE (module-wide, per CONVENTIONS.md "Multi-tenancy change vs upstream"):
// upstream runs ONE Postgres DATABASE per company. We run ONE database with
// row-level `companyId` scoping, so every unique constraint that was global
// upstream becomes @@unique([companyId, ...]) and every lookup index is prefixed
// with companyId. `Company` (the tenant root) and `FxRate` (a global feed cache)
// carry no companyId.
//
// DIVERGENCE (types): upstream money columns are Numeric(12,2); house convention
// is Decimal(14,2). Exchange rates stay Numeric(18,8) as upstream.

/// Account classification. Upstream Postgres enum type `accounttype`, which stores the
/// member NAME (uppercase) while the JSON API uses the lowercase value — map at the API edge.
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  COGS
}

/// Key-value company settings (DEFAULT_SETTINGS is the authoritative key allow-list;
/// ENCRYPTED_SETTINGS_KEYS values are stored Fernet-encrypted with a `fernet:v1:` prefix).
/// Upstream table `settings`.
model Setting {
  id Int @id @default(autoincrement())

  key   String  @db.VarChar(100)
  /// Always a string, even for numbers/booleans/JSON. Nullable upstream.
  value String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Upstream: UNIQUE(key), global within the company database.
  @@unique([key])
  @@map("settings")
}

/// Per-user (or operator-session) JSON preference blob, keyed by a snake_case name.
/// Upstream table `user_preferences`.
model UserPreference {
  id Int @id @default(autoincrement())

  /// NULL = the single-password "operator" session, which shares one row per key.
  /// Postgres does not collide NULLs in a plain unique index, so the operator row is
  /// additionally protected by a partial unique index emitted as raw SQL:
  ///   CREATE UNIQUE INDEX uq_user_preference_operator
  ///     ON user_preferences(company_id, key) WHERE user_id IS NULL;
  userId Int? @map("user_id") /// control-plane users.id — no FK: identity lives outside this database

  /// Validated against ^[a-z][a-z0-9_]{0,49}$.
  key   String @db.VarChar(50)
  /// Serialized JSON object, <= 16000 bytes. Stored as text upstream, default "{}".
  value String @default("{}") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Upstream constraint name: uq_user_preference (user_id, key).
  @@unique([userId, key], name: "uq_user_preference")
  @@index([userId])
  @@map("user_preferences")
}

/// Row-level change history written by the after-flush audit hook. Upstream table `audit_log`.
/// Skipped tables: audit_log, portal_accesses, login_attempts, document_audits, email_log.
/// Money inside the snapshots is serialized as an exact string, never through a float.
model AuditLog {
  id Int @id @default(autoincrement())

  tableName String @map("table_name") @db.VarChar(100)
  recordId  Int    @map("record_id")
  /// "INSERT" | "UPDATE" | "DELETE". Free string upstream, not a DB enum.
  action    String @db.VarChar(10)

  /// UPDATE rows carry only the changed attributes; DELETE carries a full snapshot.
  oldValues     Json? @map("old_values")
  /// INSERT carries a full snapshot; DELETE is null.
  newValues     Json? @map("new_values")
  /// Array of column names; null on DELETE.
  changedFields Json? @map("changed_fields")

  /// Upstream column is literally `timestamp` (server_default CURRENT_TIMESTAMP).
  timestamp DateTime @default(now()) @db.Timestamptz(6)
  /// "api" for hook-generated rows, "system" or caller-supplied via log_event().
  source    String?  @db.VarChar(100)
  /// Never NULL on new rows ("system" for machine principals); NULL only on pre-multi-user rows.
  username  String?  @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tableName, recordId])
  @@index([action])
  @@index([timestamp])
  @@index([username])
  @@map("audit_log")
}

/// Chart of accounts entry. Upstream table `accounts`.
/// Control accounts are identified by literal `accountNumber` (1000, 1100, 1200, 1300,
/// 2000, 2100, 2200, 3200, 4000, 4800, 5000, 5900, 6000, 6120, 6150) — their number and
/// type are immutable and they can never be deleted. `isSystem` does NOT gate delete/edit.
model Account {
  id Int @id @default(autoincrement())

  name          String      @db.VarChar(200)
  /// Blank/whitespace is coerced to NULL at the API layer. UNIQUE upstream.
  accountNumber String?     @map("account_number") @db.VarChar(20)
  accountType   AccountType @map("account_type")

  /// Self-referencing sub-account. No depth limit upstream; only "an account cannot be
  /// its own parent" is enforced (on PUT).
  parentId Int?      @map("parent_id")
  parent   Account?  @relation("AccountParent", fields: [parentId], references: [id], onDelete: Restrict)
  accounts Account[] @relation("AccountParent")

  description String?  @db.VarChar(500)
  /// Nullable in upstream DDL; the API defaults it to true.
  isActive    Boolean? @default(true) @map("is_active")
  /// True on the 57 seeded accounts and on every ensureAccount()/on-demand account.
  isSystem    Boolean? @default(false) @map("is_system")
  /// CACHED running balance maintained by the posting engine, natural-signed
  /// (debit-normal += debit - credit; credit-normal += credit - debit). Legacy rows may
  /// be NULL -> read as 0. Chart-of-accounts list ONLY: bank/card balances and every
  /// report use the derived SUM(debit)-SUM(credit) query instead.
  balance     Decimal? @default(0) @db.Decimal(14, 2)
  /// "bank" | "credit_card" | NULL. Free string upstream, not a DB enum.
  /// Invariant: bank => ASSET, credit_card => LIABILITY, NULL => any type.
  bankKind    String?  @map("bank_kind") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Upstream: UNIQUE(account_number).
  transactionLines                                TransactionLine[]    @relation("TransactionLine_account")
  taxCategoryMappings                             TaxCategoryMapping[] @relation("TaxCategoryMapping_account")
  items                                           Item[]               @relation("ItemIncomeAccount")
  itemsByExpenseAccount                           Item[]               @relation("ItemExpenseAccount")
  itemsByAssetAccount                             Item[]               @relation("ItemAssetAccount")
  payments                                        Payment[]            @relation("PaymentDepositAccount")
  vendors                                         Vendor[]             @relation("VendorDefaultExpenseAccount")
  billLines                                       BillLine[]           @relation("BillLineAccount")
  billPayments                                    BillPayment[]        @relation("BillPaymentPayFromAccount")
  vendorCreditLines                               VendorCreditLine[]   @relation("VendorCreditLineAccount")
  fixedAssetTypes                                 FixedAssetType[]     @relation("FixedAssetTypeAssetAccount")
  fixedAssetTypesByAccumulatedDepreciationAccount FixedAssetType[]     @relation("FixedAssetTypeAccumulatedDepreciationAccount")
  fixedAssetTypesByDepreciationExpenseAccount     FixedAssetType[]     @relation("FixedAssetTypeDepreciationExpenseAccount")
  bankAccounts                                    BankAccount[]        @relation("BankAccount_account")
  bankTransactions                                BankTransaction[]    @relation("BankTransactionCategoryAccount")
  reconciliations                                 Reconciliation[]     @relation("Reconciliation_account")
  bankRules                                       BankRule[]           @relation("BankRuleAccount")
  benefitCodes                                    BenefitCode[]        @relation("BenefitCodeExpenseAccount")
  benefitCodesByLiabilityAccount                  BenefitCode[]        @relation("BenefitCodeLiabilityAccount")
  payStubBenefits                                 PayStubBenefit[]     @relation("PayStubBenefitExpenseAccount")
  payStubBenefitsByLiabilityAccount               PayStubBenefit[]     @relation("PayStubBenefitLiabilityAccount")
  ptoPolicies                                     PtoPolicy[]          @relation("PtoPolicyExpenseAccount")
  ptoPoliciesByLiabilityAccount                   PtoPolicy[]          @relation("PtoPolicyLiabilityAccount")
  budgets                                         Budget[]             @relation("Budget_account")
  costCodes                                       CostCode[]           @relation("CostCode_account")
  costTypes                                       CostType[]           @relation("CostTypeDefaultAccount")
  costTypesByOffsetAccount                        CostType[]           @relation("CostTypeOffsetAccount")
  costTypesByBurdenOffsetAccount                  CostType[]           @relation("CostTypeBurdenOffsetAccount")
  equipments                                      Equipment[]          @relation("Equipment_recoveryAccount")
  jobCostLines                                    JobCostLine[]        @relation("JobCostLineDebitAccount")
  jobCostLinesByCreditAccount                     JobCostLine[]        @relation("JobCostLineCreditAccount")
  allocationRules                                 AllocationRule[]     @relation("AllocationRule_sourceAccount")
  inKindDonationLines                             InKindDonationLine[] @relation("InKindDonationLineDebitAccount")
  inKindDonationLinesByCreditAccount              InKindDonationLine[] @relation("InKindDonationLineCreditAccount")

  @@unique([accountNumber])
  @@index([accountType])
  @@index([bankKind])
  @@index([parentId])
  @@map("accounts")
}

/// Journal entry header (double-entry). Upstream table `transactions`.
/// Posted entries are NEVER deleted — they are voided by a mirror entry whose
/// `sourceType` is "<type>_void" and whose `sourceId` is this row's id. Voided-ness is
/// therefore DERIVED, never stored as a flag.
/// DIVERGENCE: the general ledger is single-currency by design — there are deliberately
/// no `currency` / `exchangeRate` columns here or on TransactionLine.
model Transaction {
  id Int @id @default(autoincrement())

  /// Posting date. Indexed (upstream model declared index=True; the initial migration
  /// omitted ix_transactions_date — we create it).
  date DateTime @db.Date

  /// Check no. / external reference.
  reference   String? @db.VarChar(100)
  /// Memo line.
  description String? @db.Text

  /// Emitter tag: manual, manual_void, transfer, transfer_void, bank_entry,
  /// opening_balance, invoice, bill, payment, bill_payment, vendor_credit, credit_memo,
  /// sales_receipt, expense, deposit, cc_charge, journal, manual_journal, plus *_void.
  sourceType String? @map("source_type") @db.VarChar(50)
  /// Id of the source record in the table named by sourceType — deliberately NOT a FK.
  /// For a *_void entry this is the id of the original TRANSACTION being reversed.
  sourceId   Int?    @map("source_id")

  /// Header class (fund). NULL groups as "Uncategorized".
  classId Int?           @map("class_id")
  class   TrackingClass? @relation("Transaction_class", fields: [classId], references: [id], onDelete: Restrict)

  /// Header Customer:Job (grant).
  jobId Int? @map("job_id")
  job   Job? @relation("Transaction_job", fields: [jobId], references: [id], onDelete: Restrict)

  /// DIVERGENCE (improvement): upstream derived "is this voided?" from a sibling
  /// transaction whose sourceType ends in _void, which every report had to re-derive.
  /// We flag it once, at reversal time, and link the two rows.
  isVoided   Boolean      @default(false) @map("is_voided")
  voidedAt   DateTime?    @map("voided_at") @db.Timestamptz(6)
  reversalId Int?         @unique @map("reversal_id")
  reversal   Transaction? @relation("TransactionReversal", fields: [reversalId], references: [id], onDelete: SetNull)
  reversalOf Transaction? @relation("TransactionReversal")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactionLines      TransactionLine[]      @relation("TransactionLine_transaction")
  inventoryMovements    InventoryMovement[]    @relation("InventoryMovement_transaction")
  invoices              Invoice[]              @relation("Invoice_transaction")
  payments              Payment[]              @relation("Payment_transaction")
  creditMemos           CreditMemo[]           @relation("CreditMemo_transaction")
  bills                 Bill[]                 @relation("BillTransaction")
  billPayments          BillPayment[]          @relation("BillPaymentTransaction")
  vendorCredits         VendorCredit[]         @relation("VendorCreditTransaction")
  bankTransactions      BankTransaction[]      @relation("BankTransaction_transaction")
  payRuns               PayRun[]               @relation("PayRun_transaction")
  ptoAccrualEntries     PtoAccrualEntry[]      @relation("PtoAccrualEntry_transaction")
  jobCosts              JobCost[]              @relation("JobCost_transaction")
  restrictionReleases   RestrictionRelease[]   @relation("RestrictionRelease_transaction")
  functionalAllocations FunctionalAllocation[] @relation("FunctionalAllocation_transaction")
  inKindDonations       InKindDonation[]       @relation("InKindDonation_transaction")

  @@index([date])
  @@index([isVoided, date])
  @@index([sourceType, sourceId])
  @@index([classId])
  @@index([jobId])
  @@map("transactions")
}

/// Journal split. Upstream table `transaction_lines`.
/// CHECK constraint ck_debit_or_credit (Prisma cannot express it — emit via raw SQL):
///   ALTER TABLE transaction_lines ADD CONSTRAINT ck_debit_or_credit
///     CHECK ((debit > 0 AND credit = 0) OR (debit = 0 AND credit > 0));
/// Every stored line is exactly one of debit-only or credit-only with the non-zero side
/// strictly positive; zero-amount lines are never persisted.
/// Reporting attribution: coalesce(line.jobId, transaction.jobId), likewise for classId.
model TransactionLine {
  id Int @id @default(autoincrement())

  transactionId Int         @map("transaction_id")
  transaction   Transaction @relation("TransactionLine_transaction", fields: [transactionId], references: [id], onDelete: Cascade)

  accountId Int     @map("account_id")
  account   Account @relation("TransactionLine_account", fields: [accountId], references: [id], onDelete: Restrict)

  debit  Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)

  /// Split memo. Engine writes "" rather than NULL when the caller omits it.
  description String? @db.VarChar(300)

  /// NULL falls back to the header job.
  jobId Int? @map("job_id")
  job   Job? @relation("TransactionLine_job", fields: [jobId], references: [id], onDelete: Restrict)

  /// NULL falls back to the header class.
  classId Int?           @map("class_id")
  class   TrackingClass? @relation("TransactionLine_class", fields: [classId], references: [id], onDelete: Restrict)

  costCodeId Int?      @map("cost_code_id")
  costCode   CostCode? @relation("TransactionLine_costCode", fields: [costCodeId], references: [id], onDelete: Restrict)

  /// Denormalized from the cost code for roll-ups: labor | material | subcontract |
  /// equipment | other. Free string, not a DB enum.
  costType String? @map("cost_type") @db.VarChar(20)

  /// Nonprofit function: "program" | "management" | "fundraising" | NULL (= not allocated).
  /// Presence of the key in the engine's line input is significant: an explicit null is
  /// honored verbatim, an absent key derives from the class's default_function.
  function String? @db.VarChar(20)

  /// Cost billable to the job's customer.
  isBillable Boolean @default(false) @map("is_billable")

  /// Set when this billable cost is pulled onto an invoice.
  billedInvoiceLineId Int?         @map("billed_invoice_line_id")
  billedInvoiceLine   InvoiceLine? @relation("TransactionLine_billedInvoiceLine", fields: [billedInvoiceLineId], references: [id], onDelete: Restrict)

  /// Bank register: matched to a statement line / ticked in a reconciliation.
  /// Cleared is reset to false when the transaction is voided (releaseStatementLinks).
  cleared Boolean @default(false)

  /// When set, this line's transaction CANNOT be voided (completed reconciliation).
  reconciliationId Int?            @map("reconciliation_id")
  reconciliation   Reconciliation? @relation("TransactionLine_reconciliation", fields: [reconciliationId], references: [id], onDelete: Restrict)

  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  bankTransactions BankTransaction[] @relation("BankTransaction_transactionLine")

  @@index([transactionId])
  @@index([accountId])
  @@index([jobId])
  @@index([classId])
  @@index([costCodeId])
  @@index([reconciliationId])
  @@index([billedInvoiceLineId])
  @@map("transaction_lines")
}

/// Schedule C tax-line override for one account (one tax line per account; upsert by
/// accountId). Falls back to DEFAULT_MAPPINGS by account-number prefix when absent.
/// Upstream table `tax_category_mappings`.
model TaxCategoryMapping {
  id Int @id @default(autoincrement())

  /// UNIQUE upstream — one mapping per account.
  accountId Int     @map("account_id")
  account   Account @relation("TaxCategoryMapping_account", fields: [accountId], references: [id], onDelete: Cascade)

  /// e.g. "Line 1 - Gross receipts or sales".
  taxLine String @map("tax_line") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([accountId])
  @@index([taxLine])
  @@map("tax_category_mappings")
}

/// Append-only history of closing-date lock changes (set / moved / cleared).
/// DIVERGENCE: upstream stored the lock only as the mutable `settings.closing_date` row,
/// so who closed a period — and when it was rolled back — was unrecoverable. The lock
/// itself still LIVES in Setting; this table is the audit trail the API-token guard
/// (_guard_closing_period) and period-close review read.
model ClosingDateLog {
  id Int @id @default(autoincrement())

  /// The lock in force before this change; null when no lock was set.
  previousClosingDate DateTime? @map("previous_closing_date") @db.Date
  /// The lock in force after this change; null when the lock was cleared.
  newClosingDate      DateTime? @map("new_closing_date") @db.Date

  /// "set" | "advanced" | "rolled_back" | "cleared" — derived from the two dates.
  action               String  @db.VarChar(20)
  /// True when the override password was used to post into a closed period.
  passwordOverrideUsed Boolean @default(false) @map("password_override_used")

  /// Acting principal: the session user name, or "system"; never NULL.
  username      String  @db.VarChar(100)
  /// "session" | "api_token" | "system". API tokens may only tighten the lock.
  principalType String? @map("principal_type") @db.VarChar(20)
  notes         String? @db.Text

  /// Upstream users table; null for operator-session / machine principals.
  userId Int? @map("user_id") /// control-plane users.id — no FK: identity lives outside this database

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([newClosingDate])
  @@map("closing_date_logs")
}

// NEW MODELS ADDED: none — every model in this fragment (Company, Setting,
// UserPreference, AuditLog, Account, Transaction, TransactionLine,
// TaxCategoryMapping, FxRate, ClosingDateLog) is already in the MODEL REGISTRY.// ==== SALES / AR ====
//
// Source: specs/02-sales-ar.md (SlowBooks Pro 2026 `app/` FastAPI+SQLAlchemy models).
// Cross-domain models referenced but NOT defined here (per CONVENTIONS "Relations"):
//   Company, Account, Transaction, TrackingClass (upstream `classes`), Job, CostCode, Employee.
// Back-relation fields on those models are intentionally omitted; `prisma format` adds them.
//
// DIVERGENCE (schema-wide, per CONVENTIONS "Types"): upstream uses Numeric(12,2) for money,
// Numeric(5,4) for tax rates, Numeric(10,2)/(14,4) for quantities and Numeric(12,4)/(14,4) for
// unit cost. The house convention is Decimal(14,2) money / Decimal(14,4) qty+rate+percent /
// Decimal(18,8) FX, so every column is widened to those. Values round-trip unchanged; only the
// declared precision differs. Rounding stays ROUND_HALF_UP at 0.01 (money) / 0.0001 (cost) in
// application code — the DB never rounds.
//
// DIVERGENCE (multi-tenancy): upstream is one database per company. Here every table carries
// `companyId`; all upstream-global uniques become @@unique([companyId, ...]) and every lookup
// index is prefixed with companyId. The single exception is Invoice.paymentToken — see there.

/// Sales-tax / taxability + activity flag enums and document state machines.

/// Item classification. Upstream `items.item_type`. Legacy QuickBooks kinds in parens.
enum ItemType {
  PRODUCT  @map("product") // itInventory
  SERVICE  @map("service") // itService
  MATERIAL @map("material") // itNonInventory
  LABOR    @map("labor") // itOtherCharge
}

/// Inventory ledger movement kind. Upstream `inventory_movements.movement_type`.
enum InventoryMovementType {
  PURCHASE   @map("purchase")
  SALE       @map("sale")
  ADJUSTMENT @map("adjustment")
  RETURN_IN  @map("return_in")
  RETURN_OUT @map("return_out")
  VOID       @map("void")
}

/// Invoice state machine (spec §4.1). draft→sent via POST /{id}/send; paid only on an
/// exact-zero balance_due; void is terminal and forbids edits.
enum InvoiceStatus {
  DRAFT   @map("draft")
  SENT    @map("sent")
  PARTIAL @map("partial")
  PAID    @map("paid")
  VOID    @map("void")
}

/// Estimate state machine (spec §4.2). Legacy interop bits: pending 0x00, accepted 0x01,
/// rejected 0x02, converted 0x04. A rejected estimate may still be converted.
enum EstimateStatus {
  PENDING   @map("pending")
  ACCEPTED  @map("accepted")
  REJECTED  @map("rejected")
  CONVERTED @map("converted")
}

/// Credit-memo state machine (spec §4.3). Model default draft; the create route writes
/// issued; the invoice write-off path writes applied directly.
enum CreditMemoStatus {
  DRAFT   @map("draft")
  ISSUED  @map("issued")
  APPLIED @map("applied")
  VOID    @map("void")
}

/// A customer / donor. Upstream table `customers`.
/// No uniqueness on name — duplicate protection is the fuzzy /check-duplicate route.
model Customer {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(200)
  // Upstream column `company` is renamed here: `company` is taken by the tenant relation.
  companyName String? @map("company") @db.VarChar(200)
  email       String? @db.VarChar(200)
  phone       String? @db.VarChar(50)
  mobile      String? @db.VarChar(50)
  fax         String? @db.VarChar(50)
  website     String? @db.VarChar(200)

  billAddress1 String? @map("bill_address1") @db.VarChar(200)
  billAddress2 String? @map("bill_address2") @db.VarChar(200)
  billCity     String? @map("bill_city") @db.VarChar(100)
  billState    String? @map("bill_state") @db.VarChar(50)
  billZip      String? @map("bill_zip") @db.VarChar(20)
  billCountry  String? @default("US") @map("bill_country") @db.VarChar(100)

  shipAddress1 String? @map("ship_address1") @db.VarChar(200)
  shipAddress2 String? @map("ship_address2") @db.VarChar(200)
  shipCity     String? @map("ship_city") @db.VarChar(100)
  shipState    String? @map("ship_state") @db.VarChar(50)
  shipZip      String? @map("ship_zip") @db.VarChar(20)
  shipCountry  String? @default("US") @map("ship_country") @db.VarChar(100)

  terms       String?  @default("Net 30") @db.VarChar(50)
  creditLimit Decimal? @map("credit_limit") @db.Decimal(14, 2)
  taxId       String?  @map("tax_id") @db.VarChar(50)
  isTaxable   Boolean  @default(true) @map("is_taxable") // only an explicit false excludes lines from tax
  notes       String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active") // customers are soft-deleted
  balance     Decimal  @default(0) @db.Decimal(14, 2)

  donorType            String? @map("donor_type") @db.VarChar(20) // "individual" | "organization"
  salutation           String? @db.VarChar(100)
  sendYearEndStatement Boolean @default(true) @map("send_year_end_statement")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoices          Invoice[]          @relation("Invoice_customer")
  estimates         Estimate[]         @relation("Estimate_customer")
  payments          Payment[]          @relation("Payment_customer")
  creditMemos       CreditMemo[]       @relation("CreditMemo_customer")
  recurringInvoices RecurringInvoice[] @relation("RecurringInvoice_customer")
  jobs              Job[]              @relation("Job_customer")
  inKindDonations   InKindDonation[]   @relation("InKindDonation_customer")

  @@index([name])
  @@index([isActive])
  @@map("customers")
}

/// A sellable product / service, optionally inventory-tracked. Upstream table `items`.
model Item {
  id Int @id @default(autoincrement())

  name        String   @db.VarChar(200)
  itemType    ItemType @map("item_type")
  description String?  @db.Text
  rate        Decimal  @default(0) @db.Decimal(14, 2)
  cost        Decimal  @default(0) @db.Decimal(14, 2) // standard / last cost, not the weighted average

  incomeAccountId  Int? @map("income_account_id")
  expenseAccountId Int? @map("expense_account_id")
  assetAccountId   Int? @map("asset_account_id") // falls back to 1300 Inventory at posting time

  income  Account? @relation("ItemIncomeAccount", fields: [incomeAccountId], references: [id], onDelete: Restrict)
  expense Account? @relation("ItemExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  asset   Account? @relation("ItemAssetAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)

  isTaxable      Boolean @default(true) @map("is_taxable")
  isActive       Boolean @default(true) @map("is_active") // items are soft-deleted
  trackInventory Boolean @default(false) @map("track_inventory") // all inventory hooks no-op when false

  quantityOnHand Decimal @default(0) @map("quantity_on_hand") @db.Decimal(14, 4) // may go negative (bill after invoice)
  reorderPoint   Decimal @default(0) @map("reorder_point") @db.Decimal(14, 4)
  avgCost        Decimal @default(0) @map("avg_cost") @db.Decimal(14, 4) // weighted average, revalued only on inbound moves

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  inventoryMovements    InventoryMovement[]    @relation("InventoryMovement_item")
  invoiceLines          InvoiceLine[]          @relation("InvoiceLine_item")
  estimateLines         EstimateLine[]         @relation("EstimateLine_item")
  creditMemoLines       CreditMemoLine[]       @relation("CreditMemoLine_item")
  recurringInvoiceLines RecurringInvoiceLine[] @relation("RecurringInvoiceLine_item")
  billLines             BillLine[]             @relation("BillLineItem")
  purchaseOrderLines    PurchaseOrderLine[]    @relation("PurchaseOrderLineItem")
  vendorCreditLines     VendorCreditLine[]     @relation("VendorCreditLineItem")
  timeEntries           TimeEntry[]            @relation("TimeEntry_project")

  @@index([name])
  @@index([isActive])
  @@index([trackInventory])
  @@map("items")
}

/// Append-only inventory ledger row; each write also caches qty/avg-cost on the Item.
/// Upstream table `inventory_movements`.
model InventoryMovement {
  id Int @id @default(autoincrement())

  itemId Int  @map("item_id")
  item   Item @relation("InventoryMovement_item", fields: [itemId], references: [id], onDelete: Restrict)

  date         DateTime              @default(now()) @db.Timestamptz(6)
  movementType InventoryMovementType @map("movement_type")

  quantity       Decimal @db.Decimal(14, 4) // SIGNED: + receipts / returns in, − sales / returns out
  unitCost       Decimal @map("unit_cost") @db.Decimal(14, 4) // cost at the time of the movement
  balanceQty     Decimal @map("balance_qty") @db.Decimal(14, 4) // post-movement snapshot
  balanceAvgCost Decimal @map("balance_avg_cost") @db.Decimal(14, 4) // post-movement snapshot

  // "invoice" | "bill" | "adjustment" | "credit_memo" | "invoice_void" | "invoice_edit" | "credit_memo_void"
  sourceType String? @map("source_type") @db.VarChar(32)
  sourceId   Int?    @map("source_id")

  transactionId Int?         @map("transaction_id")
  transaction   Transaction? @relation("InventoryMovement_transaction", fields: [transactionId], references: [id], onDelete: Restrict)

  memo String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream has created_at only

  @@index([itemId])
  @@index([itemId, date])
  @@index([sourceType, sourceId])
  @@map("inventory_movements")
}

/// A customer invoice — also the storage for sales receipts, pledges and donation receipts.
/// Upstream table `invoices`.
model Invoice {
  id Int @id @default(autoincrement())

  invoiceNumber String @map("invoice_number") @db.VarChar(50)

  customerId Int      @map("customer_id")
  customer   Customer @relation("Invoice_customer", fields: [customerId], references: [id], onDelete: Restrict)

  status   InvoiceStatus @default(DRAFT)
  date     DateTime      @db.Date
  dueDate  DateTime?     @map("due_date") @db.Date
  terms    String?       @default("Net 30") @db.VarChar(50)
  poNumber String?       @map("po_number") @db.VarChar(100)

  billAddress1 String? @map("bill_address1") @db.VarChar(200)
  billAddress2 String? @map("bill_address2") @db.VarChar(200)
  billCity     String? @map("bill_city") @db.VarChar(100)
  billState    String? @map("bill_state") @db.VarChar(50)
  billZip      String? @map("bill_zip") @db.VarChar(20)

  shipAddress1 String? @map("ship_address1") @db.VarChar(200)
  shipAddress2 String? @map("ship_address2") @db.VarChar(200)
  shipCity     String? @map("ship_city") @db.VarChar(100)
  shipState    String? @map("ship_state") @db.VarChar(50)
  shipZip      String? @map("ship_zip") @db.VarChar(20)

  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  taxRate    Decimal @default(0) @map("tax_rate") @db.Decimal(14, 4) // FRACTION (0.0890 = 8.9%); API rejects > 1
  taxAmount  Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total      Decimal @default(0) @db.Decimal(14, 2)
  amountPaid Decimal @default(0) @map("amount_paid") @db.Decimal(14, 2)
  balanceDue Decimal @default(0) @map("balance_due") @db.Decimal(14, 2) // never allowed to go negative

  notes String? @db.Text

  transactionId Int?         @map("transaction_id")
  transaction   Transaction? @relation("Invoice_transaction", fields: [transactionId], references: [id], onDelete: Restrict)

  // Public pay-page token (GET /pay/{token}). DIVERGENCE: kept GLOBALLY unique rather than
  // @@unique([companyId, paymentToken]) — the public route resolves it with no tenant context.
  paymentToken String? @unique @default(uuid()) @map("payment_token") @db.VarChar(36)

  stripeCheckoutSessionId String? @map("stripe_checkout_session_id") @db.VarChar(255) // legacy mirror
  checkoutProvider        String? @map("checkout_provider") @db.VarChar(20) // "stripe" | "paypal" | "square"
  checkoutExternalId      String? @map("checkout_external_id") @db.VarChar(255) // Square resolves invoices by this

  classId Int?           @map("class_id")
  class   TrackingClass? @relation("Invoice_class", fields: [classId], references: [id], onDelete: Restrict)
  jobId   Int?           @map("job_id")
  job     Job?           @relation("Invoice_job", fields: [jobId], references: [id], onDelete: Restrict)

  isSalesReceipt Boolean @default(false) @map("is_sales_receipt") // paid-at-issue receipt; no separate table

  currency     String?  @db.VarChar(3)
  exchangeRate Decimal? @map("exchange_rate") @db.Decimal(18, 8)

  isPledge             Boolean  @default(false) @map("is_pledge") // nonprofit document face
  fairValueAmount      Decimal? @map("fair_value_amount") @db.Decimal(14, 2) // IRS Pub. 1771 quid-pro-quo
  fairValueDescription String?  @map("fair_value_description") @db.VarChar(200)

  recurringInvoiceId Int?              @map("recurring_invoice_id")
  recurringInvoice   RecurringInvoice? @relation("Invoice_recurringInvoice", fields: [recurringInvoiceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  estimates          Estimate[]          @relation("EstimateConvertedInvoice")
  creditMemos        CreditMemo[]        @relation("CreditMemoOriginalInvoice")
  invoiceLines       InvoiceLine[]       @relation("InvoiceLine_invoice")
  paymentAllocations PaymentAllocation[] @relation("PaymentAllocation_invoice")
  creditApplications CreditApplication[] @relation("CreditApplication_invoice")

  @@unique([invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@index([date])
  @@index([isSalesReceipt])
  @@index([checkoutExternalId])
  @@index([recurringInvoiceId])
  @@map("invoices")
}

/// One invoice detail line. Upstream table `invoice_lines`.
/// `amount` is stored as q(quantity × rate) — round per line, then sum.
model InvoiceLine {
  id Int @id @default(autoincrement())

  invoiceId Int     @map("invoice_id")
  invoice   Invoice @relation("InvoiceLine_invoice", fields: [invoiceId], references: [id], onDelete: Cascade)

  itemId Int?  @map("item_id")
  item   Item? @relation("InvoiceLine_item", fields: [itemId], references: [id], onDelete: Restrict)

  description String? @db.Text
  quantity    Decimal @default(1) @db.Decimal(14, 4)
  rate        Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)

  className String? @map("class_name") @db.VarChar(100) // free text, legacy — superseded by classId

  jobId      Int?           @map("job_id")
  job        Job?           @relation("InvoiceLine_job", fields: [jobId], references: [id], onDelete: Restrict)
  classId    Int?           @map("class_id")
  class      TrackingClass? @relation("InvoiceLine_class", fields: [classId], references: [id], onDelete: Restrict)
  costCodeId Int?           @map("cost_code_id")
  costCode   CostCode?      @relation("InvoiceLine_costCode", fields: [costCodeId], references: [id], onDelete: Restrict)

  isTaxable Boolean @default(true) @map("is_taxable") // resolveLineTaxable persists true when still null
  lineOrder Int     @default(0) @map("line_order")

  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream line tables have no timestamps
  transactionLines TransactionLine[] @relation("TransactionLine_billedInvoiceLine")
  billLines        BillLine[]        @relation("BillLineBilledInvoiceLine")

  @@index([invoiceId])
  @@index([itemId])
  @@map("invoice_lines")
}

/// A quote that may be converted into an invoice. Upstream table `estimates`.
/// Has no amount_paid, balance_due, transaction_id, terms, ship-to block, currency or pay token.
model Estimate {
  id Int @id @default(autoincrement())

  estimateNumber String @map("estimate_number") @db.VarChar(50)

  customerId Int      @map("customer_id")
  customer   Customer @relation("Estimate_customer", fields: [customerId], references: [id], onDelete: Restrict)

  status         EstimateStatus @default(PENDING)
  date           DateTime       @db.Date
  expirationDate DateTime?      @map("expiration_date") @db.Date

  billAddress1 String? @map("bill_address1") @db.VarChar(200)
  billAddress2 String? @map("bill_address2") @db.VarChar(200)
  billCity     String? @map("bill_city") @db.VarChar(100)
  billState    String? @map("bill_state") @db.VarChar(50)
  billZip      String? @map("bill_zip") @db.VarChar(20)

  subtotal  Decimal @default(0) @db.Decimal(14, 2)
  taxRate   Decimal @default(0) @map("tax_rate") @db.Decimal(14, 4)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total     Decimal @default(0) @db.Decimal(14, 2)

  notes String? @db.Text

  convertedInvoiceId Int?     @map("converted_invoice_id")
  convertedInvoice   Invoice? @relation("EstimateConvertedInvoice", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)

  classId Int?           @map("class_id")
  class   TrackingClass? @relation("Estimate_class", fields: [classId], references: [id], onDelete: Restrict)
  jobId   Int?           @map("job_id")
  job     Job?           @relation("Estimate_job", fields: [jobId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  estimateLines EstimateLine[] @relation("EstimateLine_estimate")
  jobBudgets    JobBudget[]    @relation("JobBudget_estimate")

  @@unique([estimateNumber])
  @@index([customerId])
  @@index([date])
  @@map("estimates")
}

/// One estimate detail line. Upstream table `estimate_lines`.
/// Shape of invoice_lines minus class_id, plus unit_cost (the cost side; rate is revenue).
model EstimateLine {
  id Int @id @default(autoincrement())

  estimateId Int      @map("estimate_id")
  estimate   Estimate @relation("EstimateLine_estimate", fields: [estimateId], references: [id], onDelete: Cascade)

  itemId Int?  @map("item_id")
  item   Item? @relation("EstimateLine_item", fields: [itemId], references: [id], onDelete: Restrict)

  description String? @db.Text
  quantity    Decimal @default(1) @db.Decimal(14, 4)
  rate        Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)

  className String? @map("class_name") @db.VarChar(100)

  jobId      Int?      @map("job_id")
  job        Job?      @relation("EstimateLine_job", fields: [jobId], references: [id], onDelete: Restrict)
  costCodeId Int?      @map("cost_code_id")
  costCode   CostCode? @relation("EstimateLine_costCode", fields: [costCodeId], references: [id], onDelete: Restrict)

  unitCost Decimal? @map("unit_cost") @db.Decimal(14, 4)

  isTaxable Boolean @default(true) @map("is_taxable")
  lineOrder Int     @default(0) @map("line_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream line tables have no timestamps

  @@index([estimateId])
  @@index([itemId])
  @@map("estimate_lines")
}

/// A customer payment receipt. Upstream table `payments`.
/// Payments are never deleted — `isVoided` is the entire lifecycle (spec §4.4).
model Payment {
  id Int @id @default(autoincrement())

  customerId Int      @map("customer_id")
  customer   Customer @relation("Payment_customer", fields: [customerId], references: [id], onDelete: Restrict)

  date   DateTime @db.Date
  amount Decimal  @db.Decimal(14, 2) // must be > 0; refunds go through a credit memo

  method      String? @db.VarChar(50) // "check" | "cash" | "credit_card" | provider name
  checkNumber String? @map("check_number") @db.VarChar(50)
  // Holds the provider external_id — this is the online-payment idempotency key.
  reference   String? @db.VarChar(100)

  depositToAccountId Int?     @map("deposit_to_account_id") // null ⇒ 1200 Undeposited Funds
  depositToAccount   Account? @relation("PaymentDepositAccount", fields: [depositToAccountId], references: [id], onDelete: Restrict)

  notes String? @db.Text

  transactionId Int?         @map("transaction_id")
  transaction   Transaction? @relation("Payment_transaction", fields: [transactionId], references: [id], onDelete: Restrict)

  isVoided Boolean @default(false) @map("is_voided") // a void posts a reversing JE and leaves allocations in place

  currency     String?  @db.VarChar(3)
  exchangeRate Decimal? @map("exchange_rate") @db.Decimal(18, 8)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream payments have no updated_at

  paymentAllocations PaymentAllocation[] @relation("PaymentAllocation_payment")

  @@index([customerId])
  @@index([date])
  @@index([reference])
  @@map("payments")
}

/// Application of a payment against one invoice. Upstream table `payment_allocations`.
/// NOTE: rows survive a payment void; any sum over allocations must exclude voided payments.
model PaymentAllocation {
  id Int @id @default(autoincrement())

  paymentId Int     @map("payment_id")
  payment   Payment @relation("PaymentAllocation_payment", fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId Int     @map("invoice_id")
  invoice   Invoice @relation("PaymentAllocation_invoice", fields: [invoiceId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(14, 2) // must be > 0 and ≤ invoice.balanceDue

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream has no timestamps here

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/// A credit issued to a customer, including A/R write-offs. Upstream table `credit_memos`.
model CreditMemo {
  id Int @id @default(autoincrement())

  memoNumber String @map("memo_number") @db.VarChar(50) // series "CM-0001"

  customerId Int      @map("customer_id")
  customer   Customer @relation("CreditMemo_customer", fields: [customerId], references: [id], onDelete: Restrict)

  status CreditMemoStatus @default(DRAFT) // create route writes ISSUED; write-off writes APPLIED

  originalInvoiceId Int?     @map("original_invoice_id")
  originalInvoice   Invoice? @relation("CreditMemoOriginalInvoice", fields: [originalInvoiceId], references: [id], onDelete: Restrict)

  date DateTime @db.Date

  subtotal  Decimal @default(0) @db.Decimal(14, 2)
  taxRate   Decimal @default(0) @map("tax_rate") @db.Decimal(14, 4) // document-level; memo lines have no is_taxable
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total     Decimal @default(0) @db.Decimal(14, 2)

  amountApplied    Decimal @default(0) @map("amount_applied") @db.Decimal(14, 2)
  // Unapplied credit; A/R aging subtracts this to agree with account 1100 (no JE on apply).
  balanceRemaining Decimal @default(0) @map("balance_remaining") @db.Decimal(14, 2)

  notes String? @db.Text

  transactionId Int?         @map("transaction_id")
  transaction   Transaction? @relation("CreditMemo_transaction", fields: [transactionId], references: [id], onDelete: Restrict)

  classId Int?           @map("class_id")
  class   TrackingClass? @relation("CreditMemo_class", fields: [classId], references: [id], onDelete: Restrict)
  jobId   Int?           @map("job_id")
  job     Job?           @relation("CreditMemo_job", fields: [jobId], references: [id], onDelete: Restrict)

  isWriteOff Boolean @default(false) @map("is_write_off") // posts to 6960 Bad Debt Expense instead of income

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creditMemoLines    CreditMemoLine[]    @relation("CreditMemoLine_creditMemo")
  creditApplications CreditApplication[] @relation("CreditApplication_creditMemo")

  @@unique([memoNumber])
  @@index([customerId])
  @@index([date])
  @@map("credit_memos")
}

/// One credit-memo detail line. Upstream table `credit_memo_lines`.
/// Deliberately has NO is_taxable / job_id / class_id / cost_code_id.
model CreditMemoLine {
  id Int @id @default(autoincrement())

  creditMemoId Int        @map("credit_memo_id")
  creditMemo   CreditMemo @relation("CreditMemoLine_creditMemo", fields: [creditMemoId], references: [id], onDelete: Cascade)

  itemId Int?  @map("item_id")
  item   Item? @relation("CreditMemoLine_item", fields: [itemId], references: [id], onDelete: Restrict)

  description String? @db.Text
  quantity    Decimal @default(1) @db.Decimal(14, 4)
  rate        Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)
  lineOrder   Int     @default(0) @map("line_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream line tables have no timestamps

  @@index([creditMemoId])
  @@index([itemId])
  @@map("credit_memo_lines")
}

/// Application of a credit memo against an invoice. Upstream table `credit_applications`.
/// No journal entry is posted on application — the A/R credit was booked when the memo issued.
/// A credit-memo void DELETES these rows after restoring the invoice.
model CreditApplication {
  id Int @id @default(autoincrement())

  creditMemoId Int        @map("credit_memo_id")
  creditMemo   CreditMemo @relation("CreditApplication_creditMemo", fields: [creditMemoId], references: [id], onDelete: Cascade)

  invoiceId Int     @map("invoice_id")
  invoice   Invoice @relation("CreditApplication_invoice", fields: [invoiceId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream has no timestamps here

  @@index([creditMemoId])
  @@index([invoiceId])
  @@map("credit_applications")
}

/// A template that generates invoices on a schedule. Upstream table `recurring_invoices`.
/// Hard-deleted by the API (lines cascade).
model RecurringInvoice {
  id Int @id @default(autoincrement())

  customerId Int      @map("customer_id")
  customer   Customer @relation("RecurringInvoice_customer", fields: [customerId], references: [id], onDelete: Restrict)

  // "weekly" | "monthly" | "quarterly" | "yearly"; anything else advances by one month.
  frequency String    @db.VarChar(20)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  nextDue   DateTime  @map("next_due") @db.Date // initialized to startDate; advanced one installment per run

  isActive Boolean @default(true) @map("is_active") // cleared when nextDue passes endDate
  terms    String? @default("Net 30") @db.VarChar(50)
  taxRate  Decimal @default(0) @map("tax_rate") @db.Decimal(14, 4)
  notes    String? @db.Text

  invoicesCreated Int @default(0) @map("invoices_created")

  classId Int?           @map("class_id")
  class   TrackingClass? @relation("RecurringInvoice_class", fields: [classId], references: [id], onDelete: Restrict)
  jobId   Int?           @map("job_id")
  job     Job?           @relation("RecurringInvoice_job", fields: [jobId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoices              Invoice[]              @relation("Invoice_recurringInvoice")
  recurringInvoiceLines RecurringInvoiceLine[] @relation("RecurringInvoiceLine_recurringInvoice")

  @@index([customerId])
  @@index([isActive, nextDue])
  @@map("recurring_invoices")
}

/// One template detail line. Upstream table `recurring_invoice_lines`.
/// NO stored `amount` — it is computed as q(quantity × rate) at generation time.
model RecurringInvoiceLine {
  id Int @id @default(autoincrement())

  recurringInvoiceId Int              @map("recurring_invoice_id")
  recurringInvoice   RecurringInvoice @relation("RecurringInvoiceLine_recurringInvoice", fields: [recurringInvoiceId], references: [id], onDelete: Cascade)

  itemId Int?  @map("item_id")
  item   Item? @relation("RecurringInvoiceLine_item", fields: [itemId], references: [id], onDelete: Restrict)

  description String? @db.Text
  quantity    Decimal @default(1) @db.Decimal(14, 4)
  rate        Decimal @default(0) @db.Decimal(14, 2)
  isTaxable   Boolean @default(true) @map("is_taxable")
  lineOrder   Int     @default(0) @map("line_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream line tables have no timestamps

  @@index([recurringInvoiceId])
  @@index([itemId])
  @@map("recurring_invoice_lines")
}

/// A reusable subject/body pair for outbound customer mail. Upstream table `email_templates`.
/// Hard-deleted by the API.
model EmailTemplate {
  id Int @id @default(autoincrement())

  name            String @db.VarChar(100)
  subjectTemplate String @map("subject_template") @db.VarChar(500)
  bodyTemplate    String @map("body_template") @db.Text
  // "invoice" | "payment_receipt" | "past_due" | "collection" | "acknowledgment"
  templateType    String @map("template_type") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([name])
  @@index([templateType, name])
  @@map("email_templates")
}

/// One outbound-email attempt, success or failure. Upstream table `email_log` (singular).
model EmailLog {
  id Int @id @default(autoincrement())

  // "invoice" | "estimate" | "statement" | "collection" | "" — not a FK; entityId is 0 when unknown.
  entityType String @map("entity_type") @db.VarChar(50)
  entityId   Int    @map("entity_id")

  recipient    String  @db.VarChar(200)
  subject      String? @db.VarChar(500)
  status       String  @db.VarChar(20) // "sent" | "failed"
  errorMessage String? @map("error_message") @db.Text

  sentAt DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream has sent_at only

  @@index([entityType, entityId])
  @@index([sentAt])
  @@map("email_log")
}

/// A sales-tax reseller / exemption permit on file for audit. Upstream table `reseller_permits`.
/// Nothing in the posting path consults these — the operator clears is_taxable on the line.
/// Hard-deleted by the API. Responses are enriched with days_to_expire / is_expired /
/// verification_url, none of which are stored.
model ResellerPermit {
  id Int @id @default(autoincrement())

  // "customer" | "vendor" | "company". Polymorphic by design — entityId is NOT a FK and is
  // null for entityType "company".
  entityType String @map("entity_type") @db.VarChar(20)
  entityId   Int?   @map("entity_id")

  jurisdiction String @db.VarChar(20) // two-letter state, uppercased and trimmed on write
  permitNumber String @map("permit_number") @db.VarChar(50) // digits-only normalization only on a state-length match

  issuedAt  DateTime? @map("issued_at") @db.Date
  expiresAt DateTime? @map("expires_at") @db.Date

  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(6)
  verifiedBy     String?   @map("verified_by") @db.VarChar(100) // free-form note, not a User FK
  notes          String?   @db.Text
  isActive       Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([jurisdiction])
  @@index([permitNumber])
  @@index([expiresAt])
  @@index([isActive])
  @@map("reseller_permits")
}

/// Access-audit row for the EMPLOYEE self-service portal (/portal/*). Upstream table
/// `portal_accesses`. Despite living in the sales fragment it is not a customer portal.
model PortalAccess {
  id Int @id @default(autoincrement())

  employeeId Int?      @map("employee_id")
  employee   Employee? @relation("PortalAccess_employee", fields: [employeeId], references: [id], onDelete: Restrict)

  ip        String? @db.VarChar(45)
  userAgent String? @map("user_agent") @db.VarChar(255)
  path      String? @db.VarChar(200)
  success   Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) // DIVERGENCE: upstream has created_at only

  @@index([employeeId])
  @@index([createdAt])
  @@index([success])
  @@map("portal_accesses")
}

// ---------------------------------------------------------------------------
// Registry names with NO table in this domain (deliberately not modelled):
//
//   SalesReceipt — a sales receipt IS an Invoice with `isSalesReceipt = true`
//     (spec §13.7: POST /api/sales-receipts creates an Invoice + a Payment with one
//     allocation; GET /api/sales-receipts delegates to the invoice list filtered on the
//     flag). Giving it its own table would fork the numbering series and the A/R posting.
//
//   Deposit / DepositLine — deposits are journal-entry-only (spec §5.13: source_type
//     "deposit" with NO source_id; POST /api/deposits returns just a transaction_id).
//     GET /api/deposits/pending is derived by walking uncleared debit lines on 1200
//     Undeposited Funds, and DepositCreate.line_ids is accepted but unused upstream.
//     If a durable deposit record is wanted later it is a new table, not a port.
//
// NEW MODELS ADDED: none.
// ---------------------------------------------------------------------------// ==== PURCHASING / AP / INVENTORY / FIXED ASSETS ====
//
// Source spec: specs/03-purchasing-inventory.md (SlowBooks Pro 2026 upstream:
// vendors, bills, bill_lines, bill_payments, bill_payment_allocations,
// purchase_orders, purchase_order_lines, vendor_credits, vendor_credit_lines,
// vendor_credit_applications, fixed_asset_types, fixed_assets).
//
// NOT DEFINED HERE (owned by other fragments, referenced only):
//   Item, InventoryMovement          -> Sales/AR fragment (spec §1.11, §1.12)
//   EmployeeBankAccount              -> Payroll fragment (spec §1.15)
//   Account, Transaction, TrackingClass ("classes"), Job, CostCode,
//   InvoiceLine, Attachment, Company -> Core / Sales / Reporting / Platform
// Per CONVENTIONS.md the back-relation fields on those models are intentionally
// omitted; `prisma format` adds them at merge time.
//
// DIVERGENCE (global, applies to every model below): upstream money columns are
// Numeric(12,2), quantities Numeric(10,2), tax rates Numeric(5,4),
// effective_life_years Numeric(8,2), annual_rate Numeric(8,4). CONVENTIONS.md
// mandates uniform precision, so money is Decimal(14,2) and every quantity /
// rate / percentage is Decimal(14,4). Exchange rates stay Decimal(18,8).
//
// DIVERGENCE (global): upstream runs one database per company. We use one
// database with row-level `companyId` scoping, so every upstream-global UNIQUE
// (po_number, credit_number, asset_number, fixed_asset_types.name) becomes
// @@unique([companyId, ...]) and every lookup index leads with companyId.

/// Payment terms / status of a bill. Upstream enum `BillStatus`.
// State machine: unpaid -> partial -> paid, walking back to partial/unpaid when a
// payment or an applied vendor credit is voided. `void` is terminal.
// `draft` exists upstream but no route ever produces it.
enum BillStatus {
  DRAFT   @map("draft")
  UNPAID  @map("unpaid")
  PARTIAL @map("partial")
  PAID    @map("paid")
  VOID    @map("void")

  @@map("bill_status")
}

/// Lifecycle of a purchase order. Upstream enum `POStatus`.
// `PARTIAL` and `RECEIVED` are never written by any endpoint today — there is no
// receiving workflow (see spec §3.3 / §9 known gaps). Retained for fidelity.
enum PoStatus {
  DRAFT    @map("draft")
  SENT     @map("sent")
  PARTIAL  @map("partial")
  RECEIVED @map("received")
  CLOSED   @map("closed")

  @@map("po_status")
}

/// Lifecycle of a vendor credit. Upstream enum `VendorCreditStatus`.
// The create route always writes `ISSUED`; `DRAFT` is unreachable via the API.
enum VendorCreditStatus {
  DRAFT   @map("draft")
  ISSUED  @map("issued")
  APPLIED @map("applied")
  VOID    @map("void")

  @@map("vendor_credit_status")
}

/// Depreciation method for a fixed-asset class. Upstream enum `DepreciationMethod`.
enum DepreciationMethod {
  STRAIGHT_LINE     @map("straight_line")
  DECLINING_BALANCE @map("declining_balance")

  @@map("depreciation_method")
}

/// Lifecycle of a fixed asset. Upstream enum `FixedAssetStatus`.
enum FixedAssetStatus {
  REGISTERED @map("registered")
  DISPOSED   @map("disposed")

  @@map("fixed_asset_status")
}

/// A payee/supplier: AP master record plus 1099 tracking. Upstream table `vendors`.
model Vendor {
  id Int @id @default(autoincrement())

  name          String  @db.VarChar(200)
  companyName   String? @map("company") @db.VarChar(200) // upstream column is literally `company`; renamed in Prisma to avoid colliding with the tenant relation
  email         String? @db.VarChar(200)
  phone         String? @db.VarChar(50)
  fax           String? @db.VarChar(50)
  website       String? @db.VarChar(200)
  address1      String? @db.VarChar(200)
  address2      String? @db.VarChar(200)
  city          String? @db.VarChar(100)
  state         String? @db.VarChar(50)
  zip           String? @db.VarChar(20)
  country       String? @default("US") @db.VarChar(100)
  terms         String? @default("Net 30") @db.VarChar(50) // parsed by dueDateFromTerms(): lowercase, strip "net ", parseInt, fallback 30
  taxId         String? @map("tax_id") @db.VarChar(50)
  accountNumber String? @map("account_number") @db.VarChar(50) // the vendor's account number FOR US, not a chart-of-accounts number

  // Default posting account for bill lines that name neither an account nor an item
  // (fallback chain: line.account_id -> item.expense_account_id -> vendor.default_expense_account_id -> #6000).
  defaultExpenseAccountId Int?     @map("default_expense_account_id")
  defaultExpenseAccount   Account? @relation("VendorDefaultExpenseAccount", fields: [defaultExpenseAccountId], references: [id], onDelete: Restrict)

  // 1099 tracking. KNOWN GAP preserved from upstream: `is1099Eligible`, `w9OnFile` and
  // `w9DocumentId` have no write path in VendorCreate/VendorUpdate, yet the 1099-NEC
  // generator filters on `is_1099_eligible` while /api/reports/1099-summary filters on
  // `is_1099_vendor`. The TS port should add all three to the create/update schemas.
  is1099Vendor   Boolean     @default(false) @map("is_1099_vendor")
  vendor1099Type String?     @map("vendor_1099_type") @db.VarChar(10) // e.g. "NEC"
  is1099Eligible Boolean     @default(false) @map("is_1099_eligible")
  w9OnFile       Boolean     @default(false) @map("w9_on_file")
  w9DocumentId   Int?        @map("w9_document_id")
  w9Document     Attachment? @relation("VendorW9Document", fields: [w9DocumentId], references: [id], onDelete: SetNull)

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")
  balance  Decimal @default(0) @map("balance") @db.Decimal(14, 2) // denormalized open AP for this vendor

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bills           Bill[]           @relation("Bill_vendor")
  billPayments    BillPayment[]    @relation("BillPayment_vendor")
  purchaseOrders  PurchaseOrder[]  @relation("PurchaseOrder_vendor")
  vendorCredits   VendorCredit[]   @relation("VendorCredit_vendor")
  bankRules       BankRule[]       @relation("BankRule_vendor")
  benefitCodes    BenefitCode[]    @relation("BenefitCode_remittanceVendor")
  payStubBenefits PayStubBenefit[] @relation("PayStubBenefit_remittanceVendor")

  @@index([name])
  @@index([isActive])
  @@index([is1099Vendor])
  @@map("vendors")
}

/// A vendor invoice: DR expense/inventory, CR 2000 A/P. Upstream table `bills`.
model Bill {
  id Int @id @default(autoincrement())

  // The VENDOR's own invoice number. NOT globally unique — uniqueness is enforced in
  // code per (vendor_id, bill_number) with a 409, because two vendors may both use
  // invoice "111". Blank on create => generated as "YYYYMMDD-{vendor initials}[-n]".
  billNumber String @map("bill_number") @db.VarChar(100)

  vendorId Int    @map("vendor_id")
  vendor   Vendor @relation("Bill_vendor", fields: [vendorId], references: [id], onDelete: Restrict)

  status BillStatus @default(UNPAID)

  // Set only by PO -> bill conversion; SET NULL so deleting a PO never orphans the bill.
  poId Int?           @map("po_id")
  po   PurchaseOrder? @relation("Bill_po", fields: [poId], references: [id], onDelete: SetNull)

  date      DateTime  @db.Date
  dueDate   DateTime? @map("due_date") @db.Date // derived from `terms` when omitted; stays null if terms is empty
  terms     String?   @default("Net 30") @db.VarChar(50)
  refNumber String?   @map("ref_number") @db.VarChar(100)

  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  taxRate    Decimal @default(0) @map("tax_rate") @db.Decimal(14, 4) // a FRACTION: 0.089 = 8.9%
  taxAmount  Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total      Decimal @default(0) @db.Decimal(14, 2)
  amountPaid Decimal @default(0) @map("amount_paid") @db.Decimal(14, 2) // includes applied vendor credits, not just cash
  balanceDue Decimal @default(0) @map("balance_due") @db.Decimal(14, 2) // invariant: total - amountPaid, never negative (409 guard)

  notes String? @db.Text

  // The posted journal entry. Restrict: the ledger is the system of record.
  transactionId Int?         @map("transaction_id")
  transaction   Transaction? @relation("BillTransaction", fields: [transactionId], references: [id], onDelete: Restrict)

  classId Int?           @map("class_id")
  class   TrackingClass? @relation("BillClass", fields: [classId], references: [id], onDelete: Restrict)
  jobId   Int?           @map("job_id")
  job     Job?           @relation("BillJob", fields: [jobId], references: [id], onDelete: Restrict)

  // Document currency; the GL itself is single-currency (home). Null => home currency.
  currency     String?  @db.VarChar(3)
  exchangeRate Decimal? @map("exchange_rate") @db.Decimal(18, 8)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendorCredits            VendorCredit[]            @relation("VendorCreditOriginalBill")
  billLines                BillLine[]                @relation("BillLine_bill")
  billPaymentAllocations   BillPaymentAllocation[]   @relation("BillPaymentAllocation_bill")
  vendorCreditApplications VendorCreditApplication[] @relation("VendorCreditApplication_bill")

  @@index([vendorId, billNumber]) // backs the duplicate-number guard
  @@index([status])
  @@index([date])
  @@index([dueDate])
  @@index([poId])
  @@map("bills")
}

/// One expense or inventory-receipt line on a bill. Upstream table `bill_lines`.
model BillLine {
  id     Int  @id @default(autoincrement())
  billId Int  @map("bill_id")
  bill   Bill @relation("BillLine_bill", fields: [billId], references: [id], onDelete: Cascade)

  itemId Int?  @map("item_id")
  item   Item? @relation("BillLineItem", fields: [itemId], references: [id], onDelete: Restrict)

  // Expense account OR inventory-asset account: an inventory-tracked item forces the
  // item's asset account (or #1300), otherwise the vendor/item/#6000 fallback chain.
  accountId Int?     @map("account_id")
  account   Account? @relation("BillLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  description String? @db.Text
  quantity    Decimal @default(1) @db.Decimal(14, 4)
  rate        Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2) // always _q(quantity * rate), rounded BEFORE summing into subtotal

  jobId      Int?           @map("job_id")
  job        Job?           @relation("BillLineJob", fields: [jobId], references: [id], onDelete: Restrict)
  classId    Int?           @map("class_id")
  class      TrackingClass? @relation("BillLineClass", fields: [classId], references: [id], onDelete: Restrict)
  costCodeId Int?           @map("cost_code_id")
  costCode   CostCode?      @relation("BillLineCostCode", fields: [costCodeId], references: [id], onDelete: Restrict)

  // Nonprofit functional expense bucket: "program" | "management" | "fundraising".
  // DIVERGENCE: upstream column is `function`; renamed in Prisma to avoid a reserved
  // word in the generated client. Semantics: absent on the request => derive from the
  // fund/class default; explicit null => deliberately unassigned.
  functionCode String? @map("function") @db.VarChar(20)

  isBillable Boolean @default(false) @map("is_billable")

  // Set when this cost has been passed through onto a customer invoice.
  billedInvoiceLineId Int?         @map("billed_invoice_line_id")
  billedInvoiceLine   InvoiceLine? @relation("BillLineBilledInvoiceLine", fields: [billedInvoiceLineId], references: [id], onDelete: SetNull)

  lineOrder Int @default(0) @map("line_order") // the relationship is ordered by this

  @@index([billId])
  @@index([itemId])
  @@index([billedInvoiceLineId])
  @@map("bill_lines")
}

/// Cash going out to a vendor: DR 2000 A/P, CR bank (+ realized FX). Upstream table `bill_payments`.
model BillPayment {
  id Int @id @default(autoincrement())

  vendorId Int    @map("vendor_id")
  vendor   Vendor @relation("BillPayment_vendor", fields: [vendorId], references: [id], onDelete: Restrict)

  date        DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2) // may exceed the sum of allocations; the surplus is a vendor prepayment
  method      String?  @db.VarChar(50)
  checkNumber String?  @map("check_number") @db.VarChar(50) // caller-supplied; check printing never assigns one

  payFromAccountId Int?     @map("pay_from_account_id") // defaults to account #1000 Checking at posting time
  payFromAccount   Account? @relation("BillPaymentPayFromAccount", fields: [payFromAccountId], references: [id], onDelete: Restrict)

  notes String? @db.Text

  currency     String?  @db.VarChar(3)
  exchangeRate Decimal? @map("exchange_rate") @db.Decimal(18, 8)

  transactionId Int?         @map("transaction_id")
  transaction   Transaction? @relation("BillPaymentTransaction", fields: [transactionId], references: [id], onDelete: Restrict)

  // Unlike expenses and CC charges (whose voidedness is derived from the ledger),
  // a bill payment stores the flag. Voiding leaves the allocation rows in place.
  isVoided Boolean @default(false) @map("is_voided")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // NOTE: BillPaymentCreate also accepts class_id / job_id, which upstream silently
  // drops — there are deliberately no such columns here (spec §9 known gaps).
  billPaymentAllocations BillPaymentAllocation[] @relation("BillPaymentAllocation_billPayment")

  @@index([vendorId])
  @@index([date])
  @@index([isVoided])
  @@map("bill_payments")
}

/// Which bills a bill payment settles. Upstream table `bill_payment_allocations`.
model BillPaymentAllocation {
  id            Int         @id @default(autoincrement())
  billPaymentId Int         @map("bill_payment_id")
  billPayment   BillPayment @relation("BillPaymentAllocation_billPayment", fields: [billPaymentId], references: [id], onDelete: Cascade)

  // RESTRICT (not cascade): a bill that has been paid cannot be deleted out from under
  // its allocation. Void the payment instead.
  billId Int  @map("bill_id")
  bill   Bill @relation("BillPaymentAllocation_bill", fields: [billId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(14, 2)

  @@index([billPaymentId])
  @@index([billId])
  @@map("bill_payment_allocations")
}

/// A commitment to buy; NON-POSTING (writes no journal entry). Upstream table `purchase_orders`.
model PurchaseOrder {
  id Int @id @default(autoincrement())

  // Assigned by nextPoNumber() ("PO-0001", prefix "PO-", first 1, pad 4) inside a
  // 10-attempt retry-on-unique-violation loop; exhaustion is a 503.
  poNumber String @map("po_number") @db.VarChar(50)

  vendorId Int    @map("vendor_id")
  vendor   Vendor @relation("PurchaseOrder_vendor", fields: [vendorId], references: [id], onDelete: Restrict)

  status PoStatus @default(DRAFT)

  date         DateTime  @db.Date
  expectedDate DateTime? @map("expected_date") @db.Date
  shipTo       String?   @map("ship_to") @db.Text

  subtotal  Decimal @default(0) @db.Decimal(14, 2)
  taxRate   Decimal @default(0) @map("tax_rate") @db.Decimal(14, 4)
  taxAmount Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total     Decimal @default(0) @db.Decimal(14, 2)

  notes String? @db.Text

  jobId Int? @map("job_id")
  job   Job? @relation("PurchaseOrderJob", fields: [jobId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bills              Bill[]              @relation("Bill_po")
  purchaseOrderLines PurchaseOrderLine[] @relation("PurchaseOrderLine_purchaseOrder")

  @@unique([poNumber]) // upstream global UNIQUE, now tenant-scoped
  @@index([vendorId])
  @@index([status])
  @@index([date])
  @@map("purchase_orders")
}

/// One ordered line on a purchase order. Upstream table `purchase_order_lines`.
model PurchaseOrderLine {
  id              Int           @id @default(autoincrement())
  purchaseOrderId Int           @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation("PurchaseOrderLine_purchaseOrder", fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  itemId Int?  @map("item_id")
  item   Item? @relation("PurchaseOrderLineItem", fields: [itemId], references: [id], onDelete: Restrict)

  description String? @db.Text
  quantity    Decimal @default(1) @db.Decimal(14, 4)
  rate        Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)

  // Reserved for partial receipts: written by NO endpoint today (see spec §3.3, §9).
  receivedQty Decimal @default(0) @map("received_qty") @db.Decimal(14, 4)

  jobId      Int?      @map("job_id")
  job        Job?      @relation("PurchaseOrderLineJob", fields: [jobId], references: [id], onDelete: Restrict)
  costCodeId Int?      @map("cost_code_id")
  costCode   CostCode? @relation("PurchaseOrderLineCostCode", fields: [costCodeId], references: [id], onDelete: Restrict)

  lineOrder Int @default(0) @map("line_order")

  // NOTE: PO lines carry no class_id — only job/cost-code dimensions.

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_lines")
}

/// The mirror of a bill: DR 2000 A/P, CR expense/inventory. Upstream table `vendor_credits`.
// Applying a credit to a bill posts NOTHING — A/P already moved when the credit was
// issued; the application only records which bill it settles.
model VendorCredit {
  id Int @id @default(autoincrement())

  // nextVendorCreditNumber(): prefix "VC-", first 1, pad 4 => "VC-0001". A SEPARATE
  // series from customer credit memos. 10-attempt retry loop; exhaustion is a 503.
  creditNumber String @map("credit_number") @db.VarChar(50)

  vendorId Int    @map("vendor_id")
  vendor   Vendor @relation("VendorCredit_vendor", fields: [vendorId], references: [id], onDelete: Restrict)

  status VendorCreditStatus @default(DRAFT) // the create route always writes ISSUED

  // Advisory only: which bill prompted the credit. It does NOT apply the credit.
  originalBillId Int?  @map("original_bill_id")
  originalBill   Bill? @relation("VendorCreditOriginalBill", fields: [originalBillId], references: [id], onDelete: Restrict)

  refNumber String? @map("ref_number") @db.VarChar(100) // the vendor's own credit-note number

  date DateTime @db.Date

  subtotal         Decimal @default(0) @db.Decimal(14, 2)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(14, 4)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total            Decimal @default(0) @db.Decimal(14, 2) // must be > 0; the document, not the sign, makes it a credit
  amountApplied    Decimal @default(0) @map("amount_applied") @db.Decimal(14, 2)
  balanceRemaining Decimal @default(0) @map("balance_remaining") @db.Decimal(14, 2) // hits 0 => status APPLIED

  notes String? @db.Text

  transactionId Int?         @map("transaction_id")
  transaction   Transaction? @relation("VendorCreditTransaction", fields: [transactionId], references: [id], onDelete: Restrict)

  classId Int?           @map("class_id")
  class   TrackingClass? @relation("VendorCreditClass", fields: [classId], references: [id], onDelete: Restrict)
  jobId   Int?           @map("job_id")
  job     Job?           @relation("VendorCreditJob", fields: [jobId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  vendorCreditLines        VendorCreditLine[]        @relation("VendorCreditLine_vendorCredit")
  vendorCreditApplications VendorCreditApplication[] @relation("VendorCreditApplication_vendorCredit")

  @@unique([creditNumber]) // upstream uq_vendor_credits_credit_number, tenant-scoped
  @@index([vendorId])
  @@index([status])
  @@index([date])
  @@map("vendor_credits")
}

/// One line of a vendor credit. Upstream table `vendor_credit_lines`.
// Same shape as BillLine minus `function`, `is_billable` and `billed_invoice_line_id`.
model VendorCreditLine {
  id             Int          @id @default(autoincrement())
  vendorCreditId Int          @map("vendor_credit_id")
  vendorCredit   VendorCredit @relation("VendorCreditLine_vendorCredit", fields: [vendorCreditId], references: [id], onDelete: Cascade)

  itemId Int?  @map("item_id")
  item   Item? @relation("VendorCreditLineItem", fields: [itemId], references: [id], onDelete: Restrict)

  accountId Int?     @map("account_id")
  account   Account? @relation("VendorCreditLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  description String? @db.Text
  quantity    Decimal @default(1) @db.Decimal(14, 4)
  // The RETURN_OUT inventory movement uses this `rate` as unit_cost (NOT avg_cost), so a
  // bill and the credit reversing it net to zero on both quantity and value.
  rate        Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @default(0) @db.Decimal(14, 2)

  jobId      Int?           @map("job_id")
  job        Job?           @relation("VendorCreditLineJob", fields: [jobId], references: [id], onDelete: Restrict)
  classId    Int?           @map("class_id")
  class      TrackingClass? @relation("VendorCreditLineClass", fields: [classId], references: [id], onDelete: Restrict)
  costCodeId Int?           @map("cost_code_id")
  costCode   CostCode?      @relation("VendorCreditLineCostCode", fields: [costCodeId], references: [id], onDelete: Restrict)

  lineOrder Int @default(0) @map("line_order")

  @@index([vendorCreditId])
  @@index([itemId])
  @@map("vendor_credit_lines")
}

/// Which bill a vendor credit settles. Upstream table `vendor_credit_applications`.
// Posts no journal entry. Voiding the credit DELETES these rows (unlike bill-payment
// allocations, which are left in place).
model VendorCreditApplication {
  id             Int          @id @default(autoincrement())
  vendorCreditId Int          @map("vendor_credit_id")
  vendorCredit   VendorCredit @relation("VendorCreditApplication_vendorCredit", fields: [vendorCreditId], references: [id], onDelete: Cascade)

  billId Int  @map("bill_id")
  bill   Bill @relation("VendorCreditApplication_bill", fields: [billId], references: [id], onDelete: Restrict)

  amount Decimal @db.Decimal(14, 2)

  @@index([vendorCreditId])
  @@index([billId])
  @@map("vendor_credit_applications")
}

/// A depreciation class: method, life and the three GL accounts. Upstream table `fixed_asset_types`.
model FixedAssetType {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(120)
  description String? @db.Text

  // _requireTypeAccounts(): a null accumulated-depreciation or depreciation-expense
  // account is a 400 at run/dispose time, never at save time.
  assetAccountId Int?     @map("asset_account_id")
  assetAccount   Account? @relation("FixedAssetTypeAssetAccount", fields: [assetAccountId], references: [id], onDelete: Restrict)

  accumulatedDepreciationAccountId Int?     @map("accumulated_depreciation_account_id")
  accumulatedDepreciationAccount   Account? @relation("FixedAssetTypeAccumulatedDepreciationAccount", fields: [accumulatedDepreciationAccountId], references: [id], onDelete: Restrict)

  depreciationExpenseAccountId Int?     @map("depreciation_expense_account_id")
  depreciationExpenseAccount   Account? @relation("FixedAssetTypeDepreciationExpenseAccount", fields: [depreciationExpenseAccountId], references: [id], onDelete: Restrict)

  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE) @map("depreciation_method")

  // effectiveLifeYears is straight-line only; annualRate is declining-balance only
  // (0.2000 = 20%/yr). The unused one must be null or the run throws a 400.
  effectiveLifeYears Decimal? @map("effective_life_years") @db.Decimal(14, 4)
  annualRate         Decimal? @map("annual_rate") @db.Decimal(14, 4)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  fixedAssets FixedAsset[] @relation("FixedAsset_assetType")

  @@unique([name]) // upstream global UNIQUE on name, now tenant-scoped
  @@index([isActive])
  @@map("fixed_asset_types")
}

/// A capitalized asset carried at cost less accumulated depreciation. Upstream table `fixed_assets`.
// There is NO depreciation-history table: runs accumulate onto the asset and post one JE
// per asset. Book value is DERIVED, never stored:
//   bookValue = _q(purchasePrice - (accumulatedDepreciation ?? 0))
// and it can never fall below salvageValue.
model FixedAsset {
  id Int @id @default(autoincrement())

  // nextAssetNumber(): count(fixed_assets) + 1, formatted "FA-0001", incremented until unused.
  assetNumber String @map("asset_number") @db.VarChar(40)

  name String @db.VarChar(200)

  assetTypeId Int            @map("asset_type_id")
  assetType   FixedAssetType @relation("FixedAsset_assetType", fields: [assetTypeId], references: [id], onDelete: Restrict)

  status FixedAssetStatus @default(REGISTERED)

  purchaseDate  DateTime @map("purchase_date") @db.Date
  purchasePrice Decimal  @default(0) @map("purchase_price") @db.Decimal(14, 2)
  salvageValue  Decimal  @default(0) @map("salvage_value") @db.Decimal(14, 2)

  description String? @db.Text

  // Maintained ONLY by runDepreciation(); never written by a generic update path.
  accumulatedDepreciation Decimal   @default(0) @map("accumulated_depreciation") @db.Decimal(14, 2)
  lastDepreciationDate    DateTime? @map("last_depreciation_date") @db.Date // re-running for the same date is a no-op

  disposalDate     DateTime? @map("disposal_date") @db.Date
  disposalProceeds Decimal?  @map("disposal_proceeds") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([assetNumber]) // upstream global UNIQUE, now tenant-scoped
  @@index([assetTypeId]) // upstream ix_fixed_assets_asset_type_id
  @@index([status])
  @@index([purchaseDate])
  @@map("fixed_assets")
}

// NEW MODELS ADDED: none.
//
// CheckRun: NOT DEFINED. The model registry lists it under Purch/AP, but spec
// 03-purchasing-inventory.md contains no `check_runs` table. Check printing (§3.8,
// GET /api/checks/print) is a stateless PDF renderer over an existing customer
// payment or bill payment, and §3.9 states there is no AP batch-payment endpoint —
// so there is nothing for a CheckRun row to persist. Flagging rather than inventing
// one; if a later spec introduces batched check runs, add it here.
//
// Ledger-only documents with no table of their own (reproduced faithfully):
//   expense    -> transactions.source_type = "expense"   (source_id = vendor.id or null)
//   cc_charge  -> transactions.source_type = "cc_charge" (source_id always null)
// Their voidedness is DERIVED from the existence of an "*_void" transaction, never
// stored as a flag (contrast BillPayment.isVoided above).// ==== BANKING ====
//
// Source: SlowBooks Pro 2026 banking domain (spec 04-banking.md).
//
// Core architectural rule (upstream issue #114, "2.10"): THE BANK REGISTER IS THE
// GENERAL LEDGER. A bank/credit-card account is a Chart-of-Accounts row (`Account`)
// with `bankKind` set. `BankAccount` below is ONLY the feed/statement identity for
// that ledger account. No bank balance is ever stored — balances are always computed
// from `TransactionLine` (see gl_balances, spec §3.1). Imported statement lines sit in
// a review queue (`BankTransaction.matchStatus`) until a human matches, adds or
// excludes them; nothing posts to the ledger silently.
//
// -----------------------------------------------------------------------------
// COLUMNS THE CORE DOMAIN MUST CARRY (Account / Transaction / TransactionLine are
// owned by core — referenced here, NOT defined here):
//
//   Account.bankKind            String? @db.VarChar(20) @map("bank_kind")
//     "bank" | "credit_card" | NULL. THE single key for the register, the feed review
//     queue, reconciliation, transfers and every "paid from / deposit to" picker.
//     Never key off account numbers or names. Core should index [companyId, bankKind].
//
//   TransactionLine.cleared     Boolean @default(false) @map("cleared")
//     Set true when a statement line matches the ledger line, or a reconciliation
//     ticks it. Cleared ✓ in the register.
//
//   TransactionLine.reconciliationId  Int? @map("reconciliation_id")
//     FK -> Reconciliation.id, set only by a COMPLETED reconciliation. Makes the line
//     immutable/unvoidable (assert_not_reconciled, spec §4.5) and shows R in the
//     register. Core must declare:
//       reconciliation Reconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: SetNull)
//     Core should index [companyId, accountId, cleared] and [reconciliationId].
//
//   Also relied on by this domain (already core-owned): Account.accountType,
//   Account.accountNumber, Account.isActive, Account.isSystem, Transaction.date,
//   Transaction.reference, Transaction.description, Transaction.sourceType,
//   Transaction.sourceId, TransactionLine.debit/credit/description/accountId.
//
//   Core must also enforce CHECK ck_debit_or_credit on transaction_lines:
//     (debit >= 0 AND credit = 0 AND debit > 0) OR (debit = 0 AND credit >= 0 AND credit > 0)
//   (raw SQL migration; Prisma cannot express it). Port checklist item 2.
//
//   Voidness stays DERIVED — a transaction is void iff another transaction has
//   sourceType LIKE '%\_void' (escape \) and sourceId = that transaction's id.
//   Do NOT add an isVoid column anywhere (port checklist item 3).
//
//   EmployeeBankAccount (spec §1.8, direct-deposit/NACHA destinations) lives in
//   app/models/bank_accounts.py upstream but is owned by the PAYROLL domain per the
//   model registry — defined there, not here.
//
// DIVERGENCE (money precision): upstream banking columns are Numeric(12,2); the
// project-wide convention is Decimal(14,2), so all money below is @db.Decimal(14, 2).
// DIVERGENCE (multi-tenancy): upstream is one database per company; we scope by
// `companyId` and every unique/lookup index leads with it.
// -----------------------------------------------------------------------------

/// Status of a bank reconciliation. Upstream enum `ReconciliationStatus`
/// (RECON.DAT status byte: in_progress = 0x00, completed = 0x01).
enum ReconciliationStatus {
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")
}

/// Review-queue state of an imported statement line.
/// DIVERGENCE: upstream stores this as String(20); we model it as an enum whose
/// @map values are the exact upstream strings the SPA asserts on.
/// `auto`/`manual` = linked to a posting that already existed; `added` = this
/// statement line created the posting. State machine: spec §6.9.
enum BankMatchStatus {
  UNMATCHED @map("unmatched")
  AUTO      @map("auto")
  MANUAL    @map("manual")
  ADDED     @map("added")
  EXCLUDED  @map("excluded")
}

/// Condition operator of a bank rule, applied case-insensitively to the statement
/// line's payee. DIVERGENCE: upstream is String(20), not enum-validated at the API
/// boundary (an unrecognized value simply never matches); we constrain it.
enum BankRuleType {
  CONTAINS    @map("contains")
  STARTS_WITH @map("starts_with")
  EXACT       @map("exact")
}

/// Detected bank-CSV layout (spec §5.4, detected by COLUMNS, never by filename).
enum BankCsvFormat {
  CHASE_CHECKING @map("chase_checking")
  CHASE_CREDIT   @map("chase_credit")
  PAYPAL         @map("paypal")
  PAYPAL_NEW     @map("paypal_new")
  BOFA_DETAIL    @map("bofa_detail")
  UNKNOWN        @map("unknown")
}

/// Channel a batch of statement lines arrived through (spec §5, §16).
enum ImportChannel {
  OFX       @map("ofx")
  QFX       @map("qfx")
  CSV       @map("csv")
  SIMPLEFIN @map("simplefin")
}

/// Bank/credit-card feed identity for a ledger account — NOT a balance holder.
/// Upstream table: `bank_accounts`.
model BankAccount {
  id Int @id @default(autoincrement())

  name String @db.VarChar(200)

  // The linked Chart-of-Accounts row. Nullable: a feed can exist unlinked (migrated
  // from 2.9), in which case every posting path 400s with
  // "Link this feed to a ledger account first" (spec §6.3).
  accountId Int?     @map("account_id")
  account   Account? @relation("BankAccount_account", fields: [accountId], references: [id], onDelete: Restrict)

  bankName String? @map("bank_name") @db.VarChar(200)
  lastFour String? @map("last_four") @db.VarChar(4)

  // Pre-2.10 stored register balance. Holds the old number until it is posted as an
  // opening balance (POST /accounts/{id}/post-legacy-balance, against 3900 Opening
  // Balance Equity) or dismissed (PUT with legacy_balance: null). Never a live balance.
  legacyBalance Decimal? @map("legacy_balance") @db.Decimal(14, 2)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Invariant enforced in the route layer, not the DB (_reject_second_feed, 409
  // "'{other.name}' is already the feed for this ledger account"): AT MOST ONE ACTIVE
  // bank_accounts row per account_id. Not a DB unique constraint because inactive
  // historical feeds may share the account.
  bankTransactions BankTransaction[] @relation("BankTransaction_bankAccount")
  reconciliations  Reconciliation[]  @relation("Reconciliation_bankAccount")
  importBatches    ImportBatch[]     @relation("ImportBatch_bankAccount")

  @@index([accountId])
  @@index([isActive, name])
  @@map("bank_accounts")
}

/// An imported statement line — the review queue. Upstream table: `bank_transactions`.
model BankTransaction {
  id Int @id @default(autoincrement())

  bankAccountId Int         @map("bank_account_id")
  bankAccount   BankAccount @relation("BankTransaction_bankAccount", fields: [bankAccountId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  // THE SIGN RULE (spec §2): amount > 0 DEBITS the bank/card ledger account,
  // amount < 0 CREDITS it — identical for an asset (bank) and a liability (card).
  // Statements (OFX/QFX, CSV, SimpleFIN) already carry amounts this way; nothing is
  // flipped on import.
  amount Decimal @db.Decimal(14, 2)

  payee       String? @db.VarChar(200)
  description String? @db.VarChar(500)
  checkNumber String? @map("check_number") @db.VarChar(50)

  // Suggested/chosen category (the other side of the posting). Written by the bank
  // rules engine (spec §7) and by an explicit category on `add`.
  categoryAccountId Int?     @map("category_account_id")
  categoryAccount   Account? @relation("BankTransactionCategoryAccount", fields: [categoryAccountId], references: [id], onDelete: Restrict)

  // Pre-2.10 side-ledger tick. Retained for migrated rows; NOT used by 2.10 logic
  // (clearing lives on TransactionLine.cleared).
  reconciled Boolean @default(false)

  // The posting this line is matched to / was added as.
  transactionId Int?         @map("transaction_id")
  transaction   Transaction? @relation("BankTransaction_transaction", fields: [transactionId], references: [id], onDelete: SetNull)

  // The specific bank-side ledger line (a transfer has two bank lines, so the line
  // id — not just the transaction id — is what a statement line claims).
  transactionLineId Int?             @map("transaction_line_id")
  transactionLine   TransactionLine? @relation("BankTransaction_transactionLine", fields: [transactionLineId], references: [id], onDelete: SetNull)

  // Dedup key: OFX FITID, SimpleFIN txn id, or the CSV content digest of §5.7.
  importId String? @map("import_id") @db.VarChar(100)

  // "ofx" | "qfx" | "simplefin" | "csv_<format>" — free-form because the CSV variant
  // is a composed string; kept as VarChar to match upstream verbatim.
  importSource String? @map("import_source") @db.VarChar(50)

  matchStatus BankMatchStatus? @map("match_status")

  // Batch this row arrived in. NEW (not upstream): upstream had no import batch table.
  importBatchId Int?         @map("import_batch_id")
  importBatch   ImportBatch? @relation("BankTransaction_importBatch", fields: [importBatchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Dedup is scoped to the feed (port checklist item 4). Upstream enforces it by a
  // pre-insert query only; the spec says a Prisma port SHOULD add the constraint but
  // MUST keep the pre-check so the `skipped` counter still works. Both apply.
  @@unique([bankAccountId, importId], name: "uq_bank_txn_feed_import_id")
  @@index([bankAccountId, matchStatus])
  @@index([bankAccountId, date])
  @@index([transactionLineId])
  @@index([date])
  @@map("bank_transactions")
}

/// A statement reconciliation session. Upstream table: `reconciliations`.
/// difference = statementBalance − (beginningBalance + clearedTotal); completion
/// requires abs(difference) <= 0.005 and is always re-derived server-side.
model Reconciliation {
  id Int @id @default(autoincrement())

  // The ledger account — the 2.10 key. Nullable only because pre-2.10 rows carry just
  // bankAccountId; session() 400s on those with
  // "This reconciliation predates 2.10 and has no ledger account".
  accountId Int?     @map("account_id")
  account   Account? @relation("Reconciliation_account", fields: [accountId], references: [id], onDelete: Restrict)

  // Pre-2.10 key, kept so migrated history still renders.
  bankAccountId Int?         @map("bank_account_id")
  bankAccount   BankAccount? @relation("Reconciliation_bankAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)

  statementDate    DateTime @map("statement_date") @db.Date
  statementBalance Decimal  @map("statement_balance") @db.Decimal(14, 2)

  // Prior COMPLETED statement's statementBalance for this account (statement_date
  // DESC, id DESC), else 0.
  beginningBalance Decimal @default(0) @map("beginning_balance") @db.Decimal(14, 2)

  // Stamped at completion only.
  clearedTotal Decimal? @map("cleared_total") @db.Decimal(14, 2)

  status ReconciliationStatus @default(IN_PROGRESS)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // At most one IN_PROGRESS reconciliation per account is enforced in the service
  // layer with a 409 carrying {"message": ..., "existing_id": <id>} — a partial unique
  // index would break the structured detail the SPA asserts on, so it stays app-level.
  //
  // NOTE for core: TransactionLine.reconciliationId points here (onDelete: SetNull).
  // `abandon` DELETEs an in-progress row; cleared ticks deliberately stay, and an
  // in-progress row has stamped no lines.
  transactionLines TransactionLine[] @relation("TransactionLine_reconciliation")

  @@index([accountId, statementDate])
  @@index([accountId, status])
  @@index([bankAccountId])
  @@map("reconciliations")
}

/// Auto-categorisation rule for imported statement lines. Upstream table: `bank_rules`.
/// Grammar: ONE condition (ruleType applied to the lowercased payee — substring only,
/// no regex, no amount/date/description conditions) and ONE action (write
/// categoryAccountId). Rules never change matchStatus and never post.
model BankRule {
  id Int @id @default(autoincrement())

  name    String @db.VarChar(200)
  pattern String @db.VarChar(200)

  // The category written on a hit. An empty pattern never hits; a hit with a NULL
  // accountId still WINS and short-circuits (first hit wins even when nothing is
  // written — no lower-priority rule gets a chance).
  accountId Int?     @map("account_id")
  account   Account? @relation("BankRuleAccount", fields: [accountId], references: [id], onDelete: SetNull)

  // Stored and returned by the API but NOT applied by the engine (only accountId is).
  vendorId Int?    @map("vendor_id")
  vendor   Vendor? @relation("BankRule_vendor", fields: [vendorId], references: [id], onDelete: SetNull)

  ruleType BankRuleType @default(CONTAINS) @map("rule_type")

  // Engine order: is_active rules by priority DESC (no secondary key); the list
  // endpoint sorts priority DESC, name ASC.
  priority Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, priority])
  @@index([name])
  @@map("bank_rules")
}

/// NEW (no upstream table): one uploaded/synced statement file or sync run, so an
/// import is auditable, re-runnable and reversible. Upstream returned the counts in
/// the HTTP response only and kept nothing; we persist them and hang the resulting
/// BankTransaction rows off the batch.
model ImportBatch {
  id Int @id @default(autoincrement())

  bankAccountId Int         @map("bank_account_id")
  bankAccount   BankAccount @relation("ImportBatch_bankAccount", fields: [bankAccountId], references: [id], onDelete: Cascade)

  // Original upload filename (null for a SimpleFIN sync, which has no file).
  fileName  String? @map("file_name") @db.VarChar(255)
  // Byte length of the decoded upload; MAX_IMPORT_BYTES = 20 MB (413 over the limit).
  fileBytes Int?    @map("file_bytes")

  // sha256 hex of the raw file content. Lets the UI warn "you already imported this
  // exact file" before the per-row importId dedup does its (silent) work. NOT unique
  // on its own: re-importing the same file is legitimate and must still run the row
  // dedup — see occurrence below.
  fingerprint String? @db.VarChar(64)

  // Occurrence counter for this (bankAccountId, fingerprint): 0 for the first import
  // of a given file, 1 for the second, ... Mirrors the per-file `n` of the CSV
  // import-id fingerprint (§5.7) at the batch level and keeps the unique constraint
  // satisfiable for deliberate re-imports.
  occurrence Int @default(0)

  // How the rows arrived, and — for CSV — which layout was detected by columns.
  channel   ImportChannel
  csvFormat BankCsvFormat? @map("csv_format")

  // The exact string written to BankTransaction.importSource for this batch:
  // "ofx" | "qfx" | "simplefin" | "csv_<format>".
  importSource String @map("import_source") @db.VarChar(50)

  // Row counts as returned by import_transactions / import_csv_transactions:
  // total = rows parsed out of the file; imported + skipped <= total (rows with a
  // blank/unparseable date or amount are dropped by the parser and counted in neither);
  // matched = rows auto-matched by the post-import _auto_match_new pass.
  totalRows    Int @default(0) @map("total_rows")
  importedRows Int @default(0) @map("imported_rows")
  skippedRows  Int @default(0) @map("skipped_rows")
  matchedRows  Int @default(0) @map("matched_rows")
  // Rows the parser logged at WARNING and dropped (bad date/amount), plus rule-level
  // skips such as "Bank Deposit to PP Account" mirrors and BofA balance metadata.
  errorRows    Int @default(0) @map("error_rows")

  // Rows categorised by apply_bank_rules immediately after this import.
  categorisedRows Int @default(0) @map("categorised_rows")

  // User-safe parser messages / SimpleFIN warnings (string[]).
  errors Json?

  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bankTransactions BankTransaction[] @relation("BankTransaction_importBatch")

  @@unique([bankAccountId, fingerprint, occurrence], name: "uq_import_batch_fingerprint")
  @@index([bankAccountId, importedAt])
  @@index([channel])
  @@map("import_batches")
}

// NEW MODELS ADDED: ImportBatch (import_batches) — tracks each imported statement
// file / SimpleFIN sync run: filename, size, sha256 fingerprint + per-fingerprint
// occurrence counter, source channel and detected CSV format, and the imported /
// skipped / matched / error / categorised row counts. BankTransaction.importBatchId
// links each statement line back to the batch that created it.
//
// NEW ENUMS ADDED: BankMatchStatus, BankRuleType, BankCsvFormat, ImportChannel
// (ReconciliationStatus exists upstream).// ==== PAYROLL / HR ====
//
// Source spec: specs/05-payroll-hr.md (SlowBooks Pro 2026 upstream:
// app/models/{payroll,hr,benefits,deductions,pto,time_entries,document_audit,bank_accounts}.py).
//
// GLOBAL DIVERGENCES FROM UPSTREAM (apply to every model in this fragment):
//  - DIVERGENCE: multi-tenancy. Upstream runs one Postgres database per company;
//    we run one database with row-level `companyId` scoping. Every table below
//    therefore carries `companyId`, every upstream-global UNIQUE becomes
//    `@@unique([companyId, ...])`, and every lookup index leads with `companyId`.
//    The only exception is PayrollTaxRate, which is a global jurisdiction registry.
//  - DIVERGENCE: upstream tables mostly carry only `created_at`; the house
//    convention requires `created_at` + `updated_at` on every business table, so
//    `updatedAt` is added even where upstream has none.
//  - DIVERGENCE: money is Decimal(14,2) and rates/hours/percentages are
//    Decimal(14,4) per CONVENTIONS.md, widening upstream's Numeric(12,2),
//    Numeric(10,2), Numeric(12,4), Numeric(10,4), Numeric(6,3) and Numeric(6,2).
//    No value is narrowed, so every upstream figure still round-trips.
//  - DIVERGENCE: columns upstream typed as VARCHAR holding a closed vocabulary
//    (benefit kind/category/calc_method/burden_routing, PTO valuation) are real
//    Prisma enums here. Every enum value is `@map`ped to the exact lowercase
//    string SQLAlchemy stored (spec §0.2), so the on-disk values are unchanged.

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Salary vs hourly; drives whether `payRate` is an annual salary or an hourly rate.
enum PayType {
  SALARY @map("salary")
  HOURLY @map("hourly")
}

/// 2020+ Form W-4 Step 1(c). SINGLE == "Single or Married filing separately";
/// MARRIED == "Married filing jointly". There are no allowances on the federal side.
enum FilingStatus {
  SINGLE            @map("single")
  MARRIED           @map("married")
  HEAD_OF_HOUSEHOLD @map("head_of_household")
}

/// Pay periods per year: weekly 52, biweekly 26, semi_monthly 24, monthly 12.
/// An unparseable value annualizes at 26 (spec §1.1 PERIODS_PER_YEAR).
enum PayFrequency {
  WEEKLY       @map("weekly")
  BIWEEKLY     @map("biweekly")
  SEMI_MONTHLY @map("semi_monthly")
  MONTHLY      @map("monthly")
}

/// Employee portal / app role.
enum EmployeeRole {
  ADMIN    @map("admin")
  MANAGER  @map("manager")
  EMPLOYEE @map("employee")
}

/// DRAFT --process--> PROCESSED. VOID is terminal; processed and void both
/// reject re-processing (spec §2). Draft runs still count toward YTD; only
/// non-VOID runs do.
enum PayRunStatus {
  DRAFT     @map("draft")
  PROCESSED @map("processed")
  VOID      @map("void")
}

/// BONUS runs are the only ones `_ytd_supplemental` counts (spec §2.4).
enum PayRunType {
  REGULAR   @map("regular")
  OFF_CYCLE @map("off_cycle")
  BONUS     @map("bonus")
}

/// Only APPROVED entries with a null payRunId are swept into a pay run.
enum TimeEntryStatus {
  DRAFT     @map("draft")
  SUBMITTED @map("submitted")
  APPROVED  @map("approved")
  REJECTED  @map("rejected")
}

/// Garnishment priority order (spec §7.1 _TYPE_PRIORITY): child_support 0,
/// federal_levy 1, bankruptcy 1, state_tax_levy 2, student_loan 3, creditor 4.
enum GarnishmentType {
  CHILD_SUPPORT  @map("child_support")
  FEDERAL_LEVY   @map("federal_levy")
  STATE_TAX_LEVY @map("state_tax_levy")
  STUDENT_LOAN   @map("student_loan")
  BANKRUPTCY     @map("bankruptcy")
  CREDITOR       @map("creditor")
}

/// FIXED reads `amount` as dollars; PERCENT_DISPOSABLE reads it as 0-100 percent
/// of disposable earnings.
enum GarnishmentMethod {
  FIXED              @map("fixed")
  PERCENT_DISPOSABLE @map("percent_disposable")
}

/// BENEFIT_KINDS. DEDUCTION = employee side only, BENEFIT = employer side only,
/// BOTH = the code has both sides.
enum BenefitKind {
  DEDUCTION @map("deduction")
  BENEFIT   @map("benefit")
  BOTH      @map("both")
}

/// BENEFIT_CATEGORIES. Pre-tax codes may reduce the federal / state / FICA bases
/// independently (a traditional 401(k) reduces income tax but not FICA).
enum BenefitCategory {
  PRETAX  @map("pretax")
  POSTTAX @map("posttax")
}

/// CALC_METHODS plus the employer-only MATCH_PERCENT (EMPLOYER_CALC_METHODS).
/// MATCH_PERCENT is legal only in `employerCalcMethod` — enforced in the service
/// layer, not by the database.
enum BenefitCalcMethod {
  FIXED_AMOUNT       @map("fixed_amount")
  PERCENT_OF_GROSS   @map("percent_of_gross")
  PERCENT_OF_TAXABLE @map("percent_of_taxable")
  AMOUNT_PER_HOUR    @map("amount_per_hour")
  TIERED             @map("tiered")
  MATCH_PERCENT      @map("match_percent")
}

/// BURDEN_ROUTINGS. JOB_BURDEN employer amounts are distributed across jobs by
/// cost hours at process time (spec §11.5); FRINGE_POOL amounts stay in overhead.
enum BenefitBurdenRouting {
  FRINGE_POOL @map("fringe_pool")
  JOB_BURDEN  @map("job_burden")
}

/// Which benefit table a resolved line came from. Assignments beat group rows.
enum BenefitSource {
  ASSIGNMENT @map("assignment")
  GROUP      @map("group")
}

/// PTOType.
enum PtoType {
  VACATION @map("vacation")
  SICK     @map("sick")
  PERSONAL @map("personal")
}

/// AccrualMethod. PER_HOUR_WORKED multiplies hours worked by the rate (WA sick =
/// 0.025 = 1h per 40h); the other two grant the flat rate per period / per year.
enum PtoAccrualMethod {
  PER_HOUR_WORKED @map("per_hour_worked")
  PER_PAY_PERIOD  @map("per_pay_period")
  ANNUAL_GRANT    @map("annual_grant")
}

/// PTORequestStatus.
enum PtoRequestStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  DENIED   @map("denied")
}

/// How the dollar side of a PTO bank is priced (spec §9.3).
/// CURRENT_RATE = hours x today's rate (revaluation moves the liability on raises);
/// AVERAGE_RATE = the bank's own dollars / hours (historical cost).
enum PtoValuation {
  CURRENT_RATE @map("current_rate")
  AVERAGE_RATE @map("average_rate")
}

/// Why a PtoAccrualEntry row exists. NEW (see NEW MODELS ADDED at the end).
enum PtoAccrualEntryType {
  ACCRUAL            @map("accrual")
  USAGE              @map("usage")
  CARRYOVER_FORFEIT  @map("carryover_forfeit")
  REVALUATION        @map("revaluation")
  TERMINATION_PAYOUT @map("termination_payout")
  ADJUSTMENT         @map("adjustment")
}

/// DEFAULT_ONBOARDING_TASKS seeds all eight types, in this declaration order.
enum OnboardingTaskType {
  W4                    @map("w4")
  I9_SECTION1           @map("i9_section1")
  I9_SECTION2           @map("i9_section2")
  EVERIFY               @map("everify")
  DIRECT_DEPOSIT        @map("direct_deposit")
  STATE_NEW_HIRE_REPORT @map("state_new_hire_report")
  POLICY_ACKNOWLEDGMENT @map("policy_acknowledgment")
  EMERGENCY_CONTACT     @map("emergency_contact")
}

/// OnboardingTaskStatus.
enum OnboardingTaskStatus {
  PENDING     @map("pending")
  IN_PROGRESS @map("in_progress")
  COMPLETE    @map("complete")
}

/// BankAccountKind.
enum BankAccountKind {
  CHECKING @map("checking")
  SAVINGS  @map("savings")
}

/// DepositType for net-pay splitting (spec §11.6). REMAINDER is always allocated
/// last regardless of `priority`.
enum DepositType {
  FULL      @map("full")
  PERCENT   @map("percent")
  FIXED     @map("fixed")
  REMAINDER @map("remainder")
}

/// ACH prenote state. A PENDING account is skipped by the NACHA exporter.
enum PrenoteStatus {
  NOT_SENT  @map("not_sent")
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
}

/// Which side / kind of withholding a PayStubLine itemizes. NEW.
enum PayStubLineType {
  EARNING            @map("earning")
  EMPLOYEE_TAX       @map("employee_tax")
  EMPLOYEE_DEDUCTION @map("employee_deduction")
  GARNISHMENT        @map("garnishment")
  ADDITION           @map("addition")
  EMPLOYER_TAX       @map("employer_tax")
  EMPLOYER_BENEFIT   @map("employer_benefit")
}

// ---------------------------------------------------------------------------
// Employees
// ---------------------------------------------------------------------------

/// A person on payroll: W-4 elections, state tax situs, portal access and
/// E-Verify record-keeping. Upstream table `employees`.
model Employee {
  id Int @id @default(autoincrement())

  firstName   String  @map("first_name") @db.VarChar(100)
  lastName    String  @map("last_name") @db.VarChar(100)
  // `fullName` is derived in application code as "{firstName} {lastName}"; not stored.
  ssnLastFour String? @map("ssn_last_four") @db.VarChar(4)

  // --- compensation
  payType      PayType      @default(HOURLY) @map("pay_type")
  payRate      Decimal      @default(0) @map("pay_rate") @db.Decimal(14, 2) // hourly rate OR annual salary, per payType
  payFrequency PayFrequency @default(BIWEEKLY) @map("pay_frequency")

  // --- federal W-4 (2020+ redesign; no allowances)
  filingStatus      FilingStatus @default(SINGLE) @map("filing_status")
  multipleJobs      Boolean      @default(false) @map("multiple_jobs") // Step 2(c) checkbox: use the _CHECKBOX schedule and skip the standard-deduction add-back
  dependentsAmount  Decimal      @default(0) @map("dependents_amount") @db.Decimal(14, 2) // Step 3: $2000/child + $500/other, annual
  otherIncomeAnnual Decimal      @default(0) @map("other_income_annual") @db.Decimal(14, 2) // Step 4(a)
  deductionsAnnual  Decimal      @default(0) @map("deductions_annual") @db.Decimal(14, 2) // Step 4(b)
  extraWithholding  Decimal      @default(0) @map("extra_withholding") @db.Decimal(14, 2) // Step 4(c), PER PAY PERIOD

  // --- address
  address1 String? @map("address1") @db.VarChar(200)
  address2 String? @map("address2") @db.VarChar(200)
  city     String? @db.VarChar(100)
  state    String? @db.VarChar(50) // mailing state
  zip      String? @db.VarChar(20)

  // --- state / local tax situs
  workState             String?  @map("work_state") @db.VarChar(2) // drives SUTA + disability/leave premiums; falls back to the mailing state
  residenceState        String?  @map("residence_state") @db.VarChar(2) // drives income-tax reciprocity (spec §5.7)
  wcClassCode           String?  @map("wc_class_code") @db.VarChar(20) // workers' comp / WA L&I risk class, priced per hour worked
  stateAllowances       Int      @default(0) @map("state_allowances")
  stateExtraWithholding Decimal  @default(0) @map("state_extra_withholding") @db.Decimal(14, 2) // per period
  stateRateOverride     Decimal? @map("state_rate_override") @db.Decimal(14, 4) // PERCENT (AZ A-4 election); /100 at use; honoured only for flat-method states
  localTaxRate          Decimal? @map("local_tax_rate") @db.Decimal(14, 4) // flat local PERCENT (IN/MD/OH/PA/MI); /100 at use

  // --- job costing
  costRate  Decimal? @map("cost_rate") @db.Decimal(14, 2) // loaded hourly cost; blank = payRate, or payRate/2080 for salary
  burdenPct Decimal? @map("burden_pct") @db.Decimal(14, 4) // overrides the labor cost type's burden %

  // --- benefits template
  employeeGroupId Int?           @map("employee_group_id")
  employeeGroup   EmployeeGroup? @relation("Employee_employeeGroup", fields: [employeeGroupId], references: [id], onDelete: SetNull)

  // --- employment
  hireDate  DateTime?    @map("hire_date") @db.Date // + 20 days = the state new-hire reporting deadline (spec §13)
  isActive  Boolean      @default(true) @map("is_active")
  notes     String?      @db.Text
  email     String?      @db.VarChar(200)
  role      EmployeeRole @default(EMPLOYEE)
  managerId Int?         @map("manager_id")
  manager   Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  employees Employee[]   @relation("EmployeeManager")

  // --- self-service portal token (hard 1-year expiry, 90-day idle expiry)
  portalToken          String?   @map("portal_token") @db.VarChar(64) // secrets.token_urlsafe(24), 192-bit
  portalTokenLastUsed  DateTime? @map("portal_token_last_used") @db.Timestamptz(6)
  portalTokenExpiresAt DateTime? @map("portal_token_expires_at") @db.Timestamptz(6)

  // --- E-Verify (record-keeping only; no federal-system integration)
  everifyCaseNumber  String?   @map("everify_case_number") @db.VarChar(30)
  everifyStatus      String?   @map("everify_status") @db.VarChar(30) // not_submitted | pending | photo_match_required | tnc | employment_authorized | final_non_confirmation | case_closed
  everifySubmittedAt DateTime? @map("everify_submitted_at") @db.Timestamptz(6)
  everifyClosedAt    DateTime? @map("everify_closed_at") @db.Timestamptz(6)
  everifyNotes       String?   @map("everify_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  bankAccounts          EmployeeBankAccount[]
  ptoRequests           PtoRequest[]          @relation("PtoRequestEmployee")
  ptoRequestsByApprover PtoRequest[]          @relation("PtoRequestApprover")
  portalAccesses        PortalAccess[]        @relation("PortalAccess_employee")
  payStubs              PayStub[]             @relation("PayStub_employee")
  timeEntries           TimeEntry[]           @relation("TimeEntry_employee")
  garnishmentOrders     GarnishmentOrder[]    @relation("GarnishmentOrder_employee")
  employeeBenefits      EmployeeBenefit[]     @relation("EmployeeBenefit_employee")
  benefitYtds           BenefitYtd[]          @relation("BenefitYtd_employee")
  ptoBalances           PtoBalance[]          @relation("PtoBalance_employee")
  ptoAccrualEntries     PtoAccrualEntry[]     @relation("PtoAccrualEntry_employee")
  onboardingTasks       OnboardingTask[]      @relation("OnboardingTask_employee")
  jobCostLines          JobCostLine[]         @relation("JobCostLine_employee")
  attachments           Attachment[]          @relation("Attachment_employee")

  @@unique([portalToken]) // upstream: a global UNIQUE on portal_token
  @@index([lastName, firstName]) // the roster ordering used everywhere
  @@index([isActive])
  @@index([employeeGroupId])
  @@index([managerId])
  @@index([workState])
  @@map("employees")
}

/// Direct-deposit destination for one employee; routing/account numbers are
/// Fernet-encrypted at rest. Upstream table `employee_bank_accounts`.
model EmployeeBankAccount {
  id Int @id @default(autoincrement())

  employeeId Int      @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade) // upstream: cascade all, delete-orphan

  nickname         String?         @db.VarChar(100)
  accountKind      BankAccountKind @default(CHECKING) @map("account_kind")
  routingNumberEnc String?         @map("routing_number_enc") @db.VarChar(255) // Fernet ciphertext; ABA-checksum validated before encryption; never exposed raw
  accountNumberEnc String?         @map("account_number_enc") @db.VarChar(255) // Fernet ciphertext
  accountLastFour  String?         @map("account_last_four") @db.VarChar(4) // clear, display-safe

  depositType  DepositType @default(FULL) @map("deposit_type")
  depositValue Decimal     @default(0) @map("deposit_value") @db.Decimal(14, 2) // percent 0-100 or dollars, per depositType
  priority     Int         @default(0) // allocation order; REMAINDER is always last

  prenoteStatus   PrenoteStatus @default(NOT_SENT) @map("prenote_status")
  prenoteSentDate DateTime?     @map("prenote_sent_date") @db.Date
  isActive        Boolean       @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId, priority])
  @@map("employee_bank_accounts")
}

// ---------------------------------------------------------------------------
// Pay runs and pay stubs
// ---------------------------------------------------------------------------

/// One payroll batch: a period, a pay date, its stubs and the posted journal
/// entry. Upstream table `pay_runs`.
model PayRun {
  id Int @id @default(autoincrement())

  periodStart DateTime     @map("period_start") @db.Date
  periodEnd   DateTime     @map("period_end") @db.Date
  payDate     DateTime     @map("pay_date") @db.Date // every YTD/tax-form bucket keys off this, not the period
  status      PayRunStatus @default(DRAFT)
  runType     PayRunType   @default(REGULAR) @map("run_type")

  totalGross            Decimal @default(0) @map("total_gross") @db.Decimal(14, 2)
  totalNet              Decimal @default(0) @map("total_net") @db.Decimal(14, 2)
  totalTaxes            Decimal @default(0) @map("total_taxes") @db.Decimal(14, 2) // employee-side total
  totalEmployerTaxes    Decimal @default(0) @map("total_employer_taxes") @db.Decimal(14, 2)
  totalEmployerBenefits Decimal @default(0) @map("total_employer_benefits") @db.Decimal(14, 2)

  transactionId   Int?         @map("transaction_id") // the payroll JE, written at process time
  transaction     Transaction? @relation("PayRun_transaction", fields: [transactionId], references: [id], onDelete: Restrict)
  burdenJobCostId Int?         @map("burden_job_cost_id") // actual-burden distribution entry (spec §11.5)
  burdenJobCost   JobCost?     @relation("PayRun_burdenJobCost", fields: [burdenJobCostId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  stubs             PayStub[]
  timeEntries       TimeEntry[]       @relation("TimeEntry_payRun")
  ptoAccrualEntries PtoAccrualEntry[] @relation("PtoAccrualEntry_payRun")

  @@index([payDate])
  @@index([status, payDate])
  @@index([runType, payDate])
  @@map("pay_runs")
}

/// One employee's check for one pay run: hours, gross, every employee and
/// employer tax, and the itemization blob. Upstream table `pay_stubs`.
model PayStub {
  id Int @id @default(autoincrement())

  payRunId   Int      @map("pay_run_id")
  payRun     PayRun   @relation(fields: [payRunId], references: [id], onDelete: Cascade) // upstream: ON DELETE CASCADE, delete-orphan
  employeeId Int      @map("employee_id")
  employee   Employee @relation("PayStub_employee", fields: [employeeId], references: [id], onDelete: Restrict)

  // --- hours (priced at rate, rate x 1.5, rate x 2 in spec §2.1 Step A)
  hours           Decimal @default(0) @db.Decimal(14, 4) // total; kept for back-compat
  regularHours    Decimal @default(0) @map("regular_hours") @db.Decimal(14, 4)
  overtimeHours   Decimal @default(0) @map("overtime_hours") @db.Decimal(14, 4)
  doubletimeHours Decimal @default(0) @map("doubletime_hours") @db.Decimal(14, 4)

  grossPay Decimal @default(0) @map("gross_pay") @db.Decimal(14, 2)

  // --- employee-side withholding
  federalTax         Decimal @default(0) @map("federal_tax") @db.Decimal(14, 2)
  stateTax           Decimal @default(0) @map("state_tax") @db.Decimal(14, 2) // state income tax (may follow the residence state under reciprocity)
  stateOtherEmployee Decimal @default(0) @map("state_other_employee") @db.Decimal(14, 2) // WA PFML/Cares, SDI, PFL, transit, LOCAL income tax
  ssTax              Decimal @default(0) @map("ss_tax") @db.Decimal(14, 2) // 6.2% to the SS wage base
  medicareTax        Decimal @default(0) @map("medicare_tax") @db.Decimal(14, 2) // 1.45% + the 0.9% additional over $200k

  pretaxDeductions  Decimal @default(0) @map("pretax_deductions") @db.Decimal(14, 2) // benefit codes + ad-hoc
  posttaxDeductions Decimal @default(0) @map("posttax_deductions") @db.Decimal(14, 2)
  garnishments      Decimal @default(0) @db.Decimal(14, 2)
  reimbursements    Decimal @default(0) @db.Decimal(14, 2) // non-taxable accountable plan; ADDED to the check
  netPay            Decimal @default(0) @map("net_pay") @db.Decimal(14, 2) // gross - taxes - pretax - posttax - garnishments + reimbursements

  workState String? @map("work_state") @db.VarChar(2) // per-stub work location for multi-state runs

  // --- employer-side cost
  employerSsTax       Decimal @default(0) @map("employer_ss_tax") @db.Decimal(14, 2)
  employerMedicareTax Decimal @default(0) @map("employer_medicare_tax") @db.Decimal(14, 2) // employer NEVER carries the additional 0.9%
  futaTax             Decimal @default(0) @map("futa_tax") @db.Decimal(14, 2)
  sutaTax             Decimal @default(0) @map("suta_tax") @db.Decimal(14, 2) // always at the WORK-state engine's wage base
  stateOtherEmployer  Decimal @default(0) @map("state_other_employer") @db.Decimal(14, 2) // WA PFML employer, L&I employer, CO/MA/MN/DE/DC leave employer shares
  employerBenefits    Decimal @default(0) @map("employer_benefits") @db.Decimal(14, 2) // sum of PayStubBenefit.employerAmount

  detailJson String? @map("detail_json") @db.Text // JSON {label: stringified amount}; the pay-stub PDF reads its deduction lines from here

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  benefits     PayStubBenefit[]
  payStubLines PayStubLine[]    @relation("PayStubLine_payStub")

  @@index([employeeId])
  @@index([payRunId])
  @@map("pay_stubs")
}

/// Normalized itemization of one `PayStub.detailJson` key — one row per
/// withholding, deduction, garnishment, addition or employer cost line.
/// NEW: upstream keeps only the `detail_json` blob. DIVERGENCE: we persist the
/// parsed lines too so §226-style stub rendering, reporting and remittance can
/// query them in SQL instead of parsing JSON per stub. `detailJson` stays the
/// source of truth and is written unchanged; these rows are derived from it at
/// stub-persist time (spec §2.1 Step I / §10).
model PayStubLine {
  id Int @id @default(autoincrement())

  payStubId Int     @map("pay_stub_id")
  payStub   PayStub @relation("PayStubLine_payStub", fields: [payStubId], references: [id], onDelete: Cascade)

  lineType  PayStubLineType @map("line_type")
  detailKey String          @map("detail_key") @db.VarChar(120) // the raw detail_json key, e.g. "federal_income_tax", "benefit:401K", "garnishment:child_support:7"
  label     String          @db.VarChar(200) // _humanize(detailKey), e.g. "Federal Income Tax", "Garnishment Child Support"
  amount    Decimal         @db.Decimal(14, 2)
  sequence  Int             @default(0) // render order, following the detail_json insertion order
  note      String?         @db.Text // benefit "reduced from X to Y: not enough net pay", garnishment cap notes

  benefitCodeId      Int?              @map("benefit_code_id") // set for benefit:/employer_benefit: lines
  benefitCode        BenefitCode?      @relation("PayStubLine_benefitCode", fields: [benefitCodeId], references: [id], onDelete: Restrict)
  garnishmentOrderId Int?              @map("garnishment_order_id") // set for garnishment: lines
  garnishmentOrder   GarnishmentOrder? @relation("PayStubLine_garnishmentOrder", fields: [garnishmentOrderId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([payStubId, detailKey])
  @@index([payStubId, sequence])
  @@index([lineType])
  @@map("pay_stub_lines")
}

// ---------------------------------------------------------------------------
// Time entries
// ---------------------------------------------------------------------------

/// One employee-day of hours, already classified into regular / OT / DT by the
/// FLSA or daily-rule engine, optionally costed to a job. Upstream table
/// `time_entries`.
model TimeEntry {
  id Int @id @default(autoincrement())

  employeeId Int      @map("employee_id")
  employee   Employee @relation("TimeEntry_employee", fields: [employeeId], references: [id], onDelete: Restrict)
  date       DateTime @db.Date

  hoursRegular    Decimal @default(0) @map("hours_regular") @db.Decimal(14, 4)
  hoursOvertime   Decimal @default(0) @map("hours_overtime") @db.Decimal(14, 4) // priced at 1.5x; weighted 1.5x as cost hours
  hoursDoubletime Decimal @default(0) @map("hours_doubletime") @db.Decimal(14, 4) // priced at 2x; weighted 2x as cost hours

  projectId  Int?      @map("project_id") // DEAD LEGACY COLUMN (spec §16.12): keep it, never read it
  project    Item?     @relation("TimeEntry_project", fields: [projectId], references: [id], onDelete: Restrict)
  jobId      Int?      @map("job_id") // live job-costing link
  job        Job?      @relation("TimeEntry_job", fields: [jobId], references: [id], onDelete: Restrict)
  costCodeId Int?      @map("cost_code_id")
  costCode   CostCode? @relation("TimeEntry_costCode", fields: [costCodeId], references: [id], onDelete: Restrict)
  jobCostId  Int?      @map("job_cost_id") // set once posted to the job; cleared on reject after voiding the entry
  jobCost    JobCost?  @relation("TimeEntry_jobCost", fields: [jobCostId], references: [id], onDelete: SetNull)

  notes      String?         @db.Text
  status     TimeEntryStatus @default(DRAFT)
  approvedBy String?         @map("approved_by") @db.VarChar(200)
  approvedAt DateTime?       @map("approved_at") @db.Timestamptz(6)

  payRunId Int?    @map("pay_run_id") // set once swept into a run; a locked entry cannot be edited or deleted
  payRun   PayRun? @relation("TimeEntry_payRun", fields: [payRunId], references: [id], onDelete: SetNull)

  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobCostLines JobCostLine[] @relation("JobCostLine_timeEntry")

  @@index([employeeId, date])
  @@index([date])
  @@index([status, payRunId]) // the exact pay-run sweep filter: approved + payRunId IS NULL + date range
  @@index([payRunId])
  @@index([jobId, costCodeId])
  @@map("time_entries")
}

// ---------------------------------------------------------------------------
// Garnishments
// ---------------------------------------------------------------------------

/// A court or agency order to withhold from a paycheck, with the CCPA cap inputs.
/// Upstream table `garnishment_orders` (`app/models/deductions.py`).
model GarnishmentOrder {
  id Int @id @default(autoincrement())

  employeeId Int      @map("employee_id")
  employee   Employee @relation("GarnishmentOrder_employee", fields: [employeeId], references: [id], onDelete: Restrict)

  garnishmentType GarnishmentType   @default(CREDITOR) @map("garnishment_type")
  calcMethod      GarnishmentMethod @default(FIXED) @map("calc_method")
  amount          Decimal           @default(0) @db.Decimal(14, 2) // dollars (FIXED) or percent 0-100 of disposable (PERCENT_DISPOSABLE)
  priority        Int               @default(0) // tie-break within a type; lower is applied first

  caseNumber              String? @map("case_number") @db.VarChar(80)
  supportsSecondaryFamily Boolean @default(false) @map("supports_secondary_family") // false -> 60% base child-support cap, true -> 50%
  inArrears12Weeks        Boolean @default(false) @map("in_arrears_12_weeks") // adds 5 points to the child-support cap
  isActive                Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payStubLines PayStubLine[] @relation("PayStubLine_garnishmentOrder")

  @@index([employeeId, priority])
  @@index([isActive])
  @@map("garnishment_orders")
}

// ---------------------------------------------------------------------------
// Benefits / deductions engine
//
// REGISTRY NAME MAPPING: the registry lists BenefitPlan, BenefitEnrollment,
// DeductionType and EmployeeDeduction, but upstream runs benefits AND voluntary
// deductions through ONE engine, so those four names collapse onto two tables
// here and the spec's table names are kept (per the task brief):
//   BenefitPlan      == DeductionType   == BenefitCode     (`benefit_codes`)
//   BenefitEnrollment == EmployeeDeduction == EmployeeBenefit (`employee_benefits`)
// A "deduction type" is simply a BenefitCode with kind = DEDUCTION, and an
// employee deduction is an EmployeeBenefit assignment pointing at one.
// Cross-domain FKs should use the names below.
// ---------------------------------------------------------------------------

/// A benefit or deduction CODE with a rule: how it is calculated, which tax
/// bases it reduces, where it posts and in what order it applies.
/// Upstream table `benefit_codes` (registry alias: BenefitPlan / DeductionType).
model BenefitCode {
  id Int @id @default(autoincrement())

  code               String             @db.VarChar(30) // uppercased on write
  name               String             @db.VarChar(120)
  kind               BenefitKind        @default(DEDUCTION)
  category           BenefitCategory    @default(PRETAX)
  calcMethod         BenefitCalcMethod  @default(FIXED_AMOUNT) @map("calc_method")
  employerCalcMethod BenefitCalcMethod? @map("employer_calc_method") // null = same as the employee side; MATCH_PERCENT is valid only here

  // The three bases are independent: a traditional 401(k) sets federal+state but NOT fica.
  reducesFederal  Boolean @default(false) @map("reduces_federal")
  reducesState    Boolean @default(false) @map("reduces_state")
  reducesFica     Boolean @default(false) @map("reduces_fica")
  employerTaxable Boolean @default(false) @map("employer_taxable") // employer contribution taxable to the employee (GTL > $50k): reported, not withheld

  sequence Int @default(100) // pre-tax apply order; each code changes the taxable base the next one sees

  expenseAccountId   Int?     @map("expense_account_id")
  expenseAccount     Account? @relation("BenefitCodeExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  liabilityAccountId Int?     @map("liability_account_id")
  liabilityAccount   Account? @relation("BenefitCodeLiabilityAccount", fields: [liabilityAccountId], references: [id], onDelete: Restrict)
  remittanceVendorId Int?     @map("remittance_vendor_id")
  remittanceVendor   Vendor?  @relation("BenefitCode_remittanceVendor", fields: [remittanceVendorId], references: [id], onDelete: Restrict)

  burdenRouting BenefitBurdenRouting @default(FRINGE_POOL) @map("burden_routing")
  tracksBalance Boolean              @default(false) @map("tracks_balance") // loans: the deduction stops at zero

  effectiveFrom DateTime? @map("effective_from") @db.Date // code-level in-force window, checked against the pay period
  effectiveTo   DateTime? @map("effective_to") @db.Date
  isActive      Boolean   @default(true) @map("is_active") // codes are DEACTIVATED, never deleted: posted stubs snapshot them
  notes         String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates                 BenefitRate[]
  payStubLines          PayStubLine[]          @relation("PayStubLine_benefitCode")
  employeeGroupBenefits EmployeeGroupBenefit[] @relation("EmployeeGroupBenefit_benefitCode")
  employeeBenefits      EmployeeBenefit[]      @relation("EmployeeBenefit_benefitCode")
  benefitYtds           BenefitYtd[]           @relation("BenefitYtd_benefitCode")
  payStubBenefits       PayStubBenefit[]       @relation("PayStubBenefit_benefitCode")

  @@unique([code]) // upstream: a global UNIQUE on code
  @@index([sequence, code]) // the canonical listing order
  @@index([isActive])
  @@map("benefit_codes")
}

/// A dated rate row for one benefit code; rates resolve against the pay period
/// END date so history never moves. Upstream table `benefit_rates`.
model BenefitRate {
  id Int @id @default(autoincrement())

  benefitCodeId Int         @map("benefit_code_id")
  benefitCode   BenefitCode @relation(fields: [benefitCodeId], references: [id], onDelete: Cascade) // upstream: ON DELETE CASCADE, delete-orphan

  effectiveFrom DateTime  @map("effective_from") @db.Date // adding a row auto-closes the previous open one at (start - 1 day)
  effectiveTo   DateTime? @map("effective_to") @db.Date

  employeeRate Decimal @default(0) @map("employee_rate") @db.Decimal(14, 4) // dollars or PERCENT, per the code's calc method
  employerRate Decimal @default(0) @map("employer_rate") @db.Decimal(14, 4)

  // Three different rules; a code commonly needs all three.
  perPeriodCap    Decimal? @map("per_period_cap") @db.Decimal(14, 2)
  annualCap       Decimal? @map("annual_cap") @db.Decimal(14, 2) // measured against benefit_ytd.employee_amount
  wageBaseCeiling Decimal? @map("wage_base_ceiling") @db.Decimal(14, 2) // YTD gross ceiling for percent methods

  employerAnnualCap     Decimal? @map("employer_annual_cap") @db.Decimal(14, 2)
  employerMatchLimitPct Decimal? @map("employer_match_limit_pct") @db.Decimal(14, 4) // match on at most this PERCENT of gross
  tiersJson             String?  @map("tiers_json") @db.Text // JSON list of marginal bands: [{up_to, rate}] or [{up_to_pct, match_pct}]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([benefitCodeId, effectiveFrom]) // POST rejects a duplicate start date with 409
  @@index([benefitCodeId, effectiveFrom])
  @@map("benefit_rates")
}

/// A benefits template ("employee class" elsewhere; named group here so it is not
/// confused with class tracking). Upstream table `employee_groups`.
model EmployeeGroup {
  id Int @id @default(autoincrement())

  name        String  @db.VarChar(120)
  description String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  codes     EmployeeGroupBenefit[]
  employees Employee[]             @relation("Employee_employeeGroup")

  @@unique([name]) // upstream: a global UNIQUE on name
  @@map("employee_groups")
}

/// One code offered by a group, with the group's rate/limit overrides. An
/// employee assignment beats this row; this row beats the dated rate.
/// Upstream table `employee_group_benefits` (constraint `uq_group_benefit`).
model EmployeeGroupBenefit {
  id Int @id @default(autoincrement())

  groupId       Int           @map("group_id")
  group         EmployeeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade) // upstream: ON DELETE CASCADE, delete-orphan
  benefitCodeId Int           @map("benefit_code_id")
  benefitCode   BenefitCode   @relation("EmployeeGroupBenefit_benefitCode", fields: [benefitCodeId], references: [id], onDelete: Restrict)

  employeeRate Decimal? @map("employee_rate") @db.Decimal(14, 4) // null falls through to the dated rate
  employerRate Decimal? @map("employer_rate") @db.Decimal(14, 4)
  perPeriodCap Decimal? @map("per_period_cap") @db.Decimal(14, 2)
  annualCap    Decimal? @map("annual_cap") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([groupId, benefitCodeId]) // upstream uq_group_benefit(group_id, benefit_code_id)
  @@index([groupId])
  @@map("employee_group_benefits")
}

/// The assignment: this employee is enrolled in this code, optionally with their
/// own rates, caps and a tracked balance. Upstream table `employee_benefits`
/// (registry alias: BenefitEnrollment / EmployeeDeduction).
model EmployeeBenefit {
  id Int @id @default(autoincrement())

  employeeId    Int         @map("employee_id")
  employee      Employee    @relation("EmployeeBenefit_employee", fields: [employeeId], references: [id], onDelete: Cascade)
  benefitCodeId Int         @map("benefit_code_id")
  benefitCode   BenefitCode @relation("EmployeeBenefit_benefitCode", fields: [benefitCodeId], references: [id], onDelete: Restrict)

  employeeRate     Decimal? @map("employee_rate") @db.Decimal(14, 4) // null -> group value -> dated rate
  employerRate     Decimal? @map("employer_rate") @db.Decimal(14, 4)
  perPeriodCap     Decimal? @map("per_period_cap") @db.Decimal(14, 2)
  annualCap        Decimal? @map("annual_cap") @db.Decimal(14, 2)
  balanceRemaining Decimal? @map("balance_remaining") @db.Decimal(14, 2) // loan balance; null = not tracked. Required when the code tracksBalance

  startDate DateTime? @map("start_date") @db.Date // skipped when startDate > periodEnd
  endDate   DateTime? @map("end_date") @db.Date // skipped when endDate < periodStart
  isActive  Boolean   @default(true) @map("is_active")
  notes     String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId, isActive])
  @@index([benefitCodeId])
  @@map("employee_benefits")
}

/// First-class per-employee, per-code, per-year accumulator. Bumped as runs are
/// created; only the explicit repair path recomputes it from snapshots.
/// Upstream table `benefit_ytd` (constraint `uq_benefit_ytd`).
model BenefitYtd {
  id Int @id @default(autoincrement())

  employeeId    Int         @map("employee_id")
  employee      Employee    @relation("BenefitYtd_employee", fields: [employeeId], references: [id], onDelete: Cascade)
  benefitCodeId Int         @map("benefit_code_id")
  benefitCode   BenefitCode @relation("BenefitYtd_benefitCode", fields: [benefitCodeId], references: [id], onDelete: Restrict)
  year          Int

  employeeAmount Decimal @default(0) @map("employee_amount") @db.Decimal(14, 2) // drives the annual cap test
  employerAmount Decimal @default(0) @map("employer_amount") @db.Decimal(14, 2) // drives the employer annual cap test

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, benefitCodeId, year]) // upstream uq_benefit_ytd(employee_id, benefit_code_id, year)
  @@index([year])
  @@map("benefit_ytd")
}

/// Posted-run snapshot: freezes the resolved rule AND the amounts, so a later
/// config change cannot rewrite what was withheld. Upstream table
/// `pay_stub_benefits`.
model PayStubBenefit {
  id Int @id @default(autoincrement())

  payStubId     Int          @map("pay_stub_id")
  payStub       PayStub      @relation(fields: [payStubId], references: [id], onDelete: Cascade) // upstream: ON DELETE CASCADE, delete-orphan
  benefitCodeId Int?         @map("benefit_code_id") // nullable: the snapshot outlives a purged code
  benefitCode   BenefitCode? @relation("PayStubBenefit_benefitCode", fields: [benefitCodeId], references: [id], onDelete: SetNull)

  // --- frozen copies of the code definition
  code           String            @db.VarChar(30)
  name           String            @db.VarChar(120)
  kind           BenefitKind
  category       BenefitCategory
  sequence       Int               @default(100)
  calcMethod     BenefitCalcMethod @map("calc_method")
  employeeRate   Decimal           @default(0) @map("employee_rate") @db.Decimal(14, 4)
  employerRate   Decimal           @default(0) @map("employer_rate") @db.Decimal(14, 4)
  reducesFederal Boolean           @default(false) @map("reduces_federal")
  reducesState   Boolean           @default(false) @map("reduces_state")
  reducesFica    Boolean           @default(false) @map("reduces_fica")

  expenseAccountId   Int?     @map("expense_account_id")
  expenseAccount     Account? @relation("PayStubBenefitExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  liabilityAccountId Int?     @map("liability_account_id")
  liabilityAccount   Account? @relation("PayStubBenefitLiabilityAccount", fields: [liabilityAccountId], references: [id], onDelete: Restrict)
  remittanceVendorId Int?     @map("remittance_vendor_id") // a null here falls back to the code's CURRENT vendor at remittance time
  remittanceVendor   Vendor?  @relation("PayStubBenefit_remittanceVendor", fields: [remittanceVendorId], references: [id], onDelete: Restrict)

  burdenRouting BenefitBurdenRouting @default(FRINGE_POOL) @map("burden_routing")
  ruleJson      String?              @map("rule_json") @db.Text // frozen rule: source, caps, tiers, rate_effective_from, taxable_base_before, employer_taxable (spec §6.6)

  employeeAmount Decimal @default(0) @map("employee_amount") @db.Decimal(14, 2)
  employerAmount Decimal @default(0) @map("employer_amount") @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([payStubId, sequence]) // upstream orders a stub's benefits by sequence
  @@index([benefitCodeId])
  @@index([remittanceVendorId]) // the remittance grouping key
  @@map("pay_stub_benefits")
}

// ---------------------------------------------------------------------------
// PTO
// ---------------------------------------------------------------------------

/// An accrual rule: how hours are earned, what caps apply, and whether the bank
/// books a dollar liability. Upstream table `pto_policies` (model `PTOPolicy`).
model PtoPolicy {
  id Int @id @default(autoincrement())

  name          String           @db.VarChar(120)
  ptoType       PtoType          @default(VACATION) @map("pto_type")
  accrualMethod PtoAccrualMethod @default(PER_PAY_PERIOD) @map("accrual_method")
  accrualRate   Decimal          @default(0) @map("accrual_rate") @db.Decimal(14, 4) // per hour worked (WA sick = 0.025), hours per period, or annual grant hours

  maxCarryover Decimal? @map("max_carryover") @db.Decimal(14, 4) // 0/null = unlimited (WA sick caps at 40)
  maxBalance   Decimal? @map("max_balance") @db.Decimal(14, 4) // 0/null = no cap
  isActive     Boolean  @default(true) @map("is_active")

  accrueLiability      Boolean      @default(false) @map("accrue_liability") // off = hours only, no GL postings
  valuation            PtoValuation @default(CURRENT_RATE)
  expenseAccountId     Int?         @map("expense_account_id") // falls back to 6160 then 6110
  expenseAccount       Account?     @relation("PtoPolicyExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  liabilityAccountId   Int?         @map("liability_account_id") // falls back to 2390 then 2300
  liabilityAccount     Account?     @relation("PtoPolicyLiabilityAccount", fields: [liabilityAccountId], references: [id], onDelete: Restrict)
  paysOutOnTermination Boolean      @default(false) @map("pays_out_on_termination")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ptoBalances       PtoBalance[]      @relation("PtoBalance_policy")
  ptoAccrualEntries PtoAccrualEntry[] @relation("PtoAccrualEntry_policy")

  @@index([ptoType])
  @@index([name])
  @@map("pto_policies")
}

/// One employee's bank under one policy: an HOURS balance and a DOLLAR balance
/// that diverge when wage rates change. Upstream table `pto_accruals`
/// (model `PTOAccrual`; registry name PtoBalance).
model PtoBalance {
  id Int @id @default(autoincrement())

  employeeId Int       @map("employee_id")
  employee   Employee  @relation("PtoBalance_employee", fields: [employeeId], references: [id], onDelete: Cascade)
  policyId   Int       @map("policy_id")
  policy     PtoPolicy @relation("PtoBalance_policy", fields: [policyId], references: [id], onDelete: Restrict)

  balance       Decimal @default(0) @db.Decimal(14, 4) // hours available
  accruedYtd    Decimal @default(0) @map("accrued_ytd") @db.Decimal(14, 4) // PRE-cap earned hours; reset to 0 at carryover
  usedYtd       Decimal @default(0) @map("used_ytd") @db.Decimal(14, 4) // reset to 0 at carryover
  dollarBalance Decimal @default(0) @map("dollar_balance") @db.Decimal(14, 2) // dollar value of `balance` under the policy's valuation

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  ptoAccrualEntries PtoAccrualEntry[] @relation("PtoAccrualEntry_ptoBalance")

  @@unique([employeeId, policyId]) // "Employee already enrolled in this policy" (400)
  @@index([employeeId])
  @@map("pto_accruals")
}

/// A time-off request; approval draws the hours (and their dollars) out of the
/// matching bank. Upstream table `pto_requests` (model `PTORequest`).
model PtoRequest {
  id Int @id @default(autoincrement())

  employeeId Int              @map("employee_id")
  employee   Employee         @relation("PtoRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  startDate  DateTime         @map("start_date") @db.Date // liability relief posts on this date
  endDate    DateTime         @map("end_date") @db.Date
  hours      Decimal          @default(0) @db.Decimal(14, 4)
  ptoType    PtoType          @default(VACATION) @map("pto_type") // matched against PtoPolicy.ptoType to find the bank
  status     PtoRequestStatus @default(PENDING) // a decided request cannot be decided again

  approverId Int?      @map("approver_id")
  approver   Employee? @relation("PtoRequestApprover", fields: [approverId], references: [id], onDelete: SetNull)
  notes      String?   @db.Text

  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  ptoAccrualEntries PtoAccrualEntry[] @relation("PtoAccrualEntry_ptoRequest")

  @@index([employeeId, startDate])
  @@index([status])
  @@map("pto_requests")
}

/// One movement of a PTO bank — accrual, usage, carryover forfeiture,
/// revaluation or payout — with the hours, the dollars and the JE it posted.
/// NEW: upstream keeps only the running `pto_accruals` totals and returns the
/// carryover change records to the caller without storing them. DIVERGENCE: we
/// persist the ledger so the hours balance, the dollar balance and the GL can be
/// reconciled after the fact (spec §9.1-9.4).
model PtoAccrualEntry {
  id Int @id @default(autoincrement())

  ptoBalanceId Int        @map("pto_balance_id")
  ptoBalance   PtoBalance @relation("PtoAccrualEntry_ptoBalance", fields: [ptoBalanceId], references: [id], onDelete: Cascade)
  employeeId   Int        @map("employee_id")
  employee     Employee   @relation("PtoAccrualEntry_employee", fields: [employeeId], references: [id], onDelete: Cascade)
  policyId     Int        @map("policy_id")
  policy       PtoPolicy  @relation("PtoAccrualEntry_policy", fields: [policyId], references: [id], onDelete: Restrict)

  entryType         PtoAccrualEntryType @map("entry_type")
  effectiveDate     DateTime            @map("effective_date") @db.Date // the `as_of` / `when` the posting used
  hours             Decimal             @default(0) @db.Decimal(14, 4) // signed: + earned, - used/forfeited
  hoursEarnedPreCap Decimal             @default(0) @map("hours_earned_pre_cap") @db.Decimal(14, 4) // accruedYtd moves by this; `hours` moves by the post-cap amount
  hoursWorked       Decimal             @default(0) @map("hours_worked") @db.Decimal(14, 4) // input for PER_HOUR_WORKED accrual
  dollars           Decimal             @default(0) @db.Decimal(14, 2) // signed dollar movement of dollarBalance
  unitValue         Decimal?            @map("unit_value") @db.Decimal(14, 4) // dollars per hour used for this movement (current or average rate)

  balanceAfter       Decimal @default(0) @map("balance_after") @db.Decimal(14, 4)
  dollarBalanceAfter Decimal @default(0) @map("dollar_balance_after") @db.Decimal(14, 2)

  payRunId      Int?         @map("pay_run_id") // set when the accrual was driven by a pay run's hours
  payRun        PayRun?      @relation("PtoAccrualEntry_payRun", fields: [payRunId], references: [id], onDelete: SetNull)
  ptoRequestId  Int?         @map("pto_request_id") // set for approval draw-downs
  ptoRequest    PtoRequest?  @relation("PtoAccrualEntry_ptoRequest", fields: [ptoRequestId], references: [id], onDelete: SetNull)
  transactionId Int?         @map("transaction_id") // the source_type="pto" JE, when accrueLiability is on
  transaction   Transaction? @relation("PtoAccrualEntry_transaction", fields: [transactionId], references: [id], onDelete: Restrict)
  yearClosed    Int?         @map("year_closed") // set on CARRYOVER_FORFEIT rows
  memo          String?      @db.Text // e.g. "PTO accrual — {name} — {policy}"

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ptoBalanceId, effectiveDate])
  @@index([employeeId, effectiveDate])
  @@index([entryType])
  @@map("pto_accrual_entries")
}

// ---------------------------------------------------------------------------
// HR: onboarding and document audit
// ---------------------------------------------------------------------------

/// One item on a new hire's checklist; seeded with all eight task types on first
/// access and idempotently re-seeded. Upstream table `onboarding_tasks`.
model OnboardingTask {
  id Int @id @default(autoincrement())

  employeeId Int                  @map("employee_id")
  employee   Employee             @relation("OnboardingTask_employee", fields: [employeeId], references: [id], onDelete: Cascade)
  taskType   OnboardingTaskType   @map("task_type") // STATE_NEW_HIRE_REPORT tracks the 20-day statutory filing
  status     OnboardingTaskStatus @default(PENDING)

  documentId Int?        @map("document_id") // per-employee vault doc
  document   Attachment? @relation("OnboardingTask_document", fields: [documentId], references: [id], onDelete: SetNull)

  signed      Boolean   @default(false) // lightweight acknowledgement, NOT a cryptographic signature
  signedAt    DateTime? @map("signed_at") @db.Timestamptz(6) // stamped when `signed` flips true, cleared when it flips false
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6) // stamped on COMPLETE, cleared on any other status
  completedBy String?   @map("completed_by") @db.VarChar(120)
  notes       String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, taskType]) // makes the idempotent seed a real upsert
  @@index([employeeId])
  @@index([status])
  @@map("onboarding_tasks")
}

/// SHA-256 content hash of a rendered tax document, with the timestamp of issue.
/// The PDF footer prints `id` + the first 16 hex chars so an auditor can pull the
/// row and recompute. A hash + audit trail, deliberately NOT a digital signature.
/// Upstream table `document_audits`.
model DocumentAudit {
  id Int @id @default(autoincrement())

  docType     String @map("doc_type") @db.VarChar(20) // w2 | w3 | 940 | 941 | new_hire | ...
  docKey      String @map("doc_key") @db.VarChar(80) // emp42-yr2026, yr2026-q3, ...
  contentHash String @map("content_hash") @db.VarChar(64) // full 64 lowercase hex chars; content-only, so re-rendering the same data reproduces it

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) // the time-of-issue anchor; never part of the hash
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([docType])
  @@index([docKey])
  @@index([contentHash]) // GET /api/document-audits/verify/{content_hash}
  @@index([createdAt])
  @@map("document_audits")
}

// NEW MODELS ADDED: PayStubLine (`pay_stub_lines`) — normalized projection of
// PayStub.detailJson; PtoAccrualEntry (`pto_accrual_entries`) — the PTO bank
// movement ledger; PayrollTaxRate (`payroll_tax_rates`) — the state/federal
// withholding registry that upstream holds in Python dataclasses. All three are
// registry names; the benefits engine keeps the spec's table names, with
// BenefitPlan/DeductionType == BenefitCode and BenefitEnrollment/EmployeeDeduction
// == EmployeeBenefit as documented above.// ==== REPORTING / JOBS / NONPROFIT ====
//
// Source: specs/06-reports-analytics.md (SlowBooks Pro 2026 upstream).
// Reports themselves are computed on demand from `transactions` / `transaction_lines`
// and the document tables — NOTHING in §1, §2, §3.3, §6.2-6.6, §8.3-8.7, §9 or §10 is
// persisted. Only the tables below exist.
//
// Multi-tenancy: upstream runs one database per company; we run one database with
// row-level `companyId`. Every global unique constraint upstream therefore becomes
// `@@unique([companyId, ...])` and every lookup index starts with `companyId`.

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Lifecycle of a job / project / (nonprofit) grant. Upstream JOB_STATUSES.
enum JobStatus {
  PENDING     @map("pending")
  AWARDED     @map("awarded")
  IN_PROGRESS @map("in_progress")
  CLOSED      @map("closed")
  NOT_AWARDED @map("not_awarded")
}

/// Posted/void state shared by every job-cost, release, allocation and in-kind document.
/// Upstream DOC_STATUSES / JOB_COST_STATUSES.
enum DocStatus {
  POSTED @map("posted")
  VOID   @map("void")
}

/// What produced a job cost entry. Upstream JOB_COST_SOURCES plus "payroll",
/// which is written by distribute_payroll_burden (§6.8).
enum JobCostSource {
  MANUAL     @map("manual")
  TIME_ENTRY @map("time_entry")
  ALLOCATION @map("allocation")
  PAYROLL    @map("payroll")
}

/// Where a job budget row came from. "change" rows are change orders and roll into
/// `changes` rather than `original` in the §6.4 figure vocabulary.
enum JobBudgetSource {
  MANUAL   @map("manual")
  ESTIMATE @map("estimate")
  CHANGE   @map("change")
}

/// How labor burden is applied: a flat percentage per labor line, or actual employer
/// cost distributed by the pay run (§6.8 distribute_payroll_burden).
enum BurdenMethod {
  FLAT    @map("flat")
  PAYROLL @map("payroll")
}

/// Donor restriction carried by a tracking class / fund. Upstream RESTRICTIONS.
/// is_restricted = TEMPORARILY_RESTRICTED || PERMANENTLY_RESTRICTED.
enum FundRestriction {
  UNRESTRICTED           @map("unrestricted")
  TEMPORARILY_RESTRICTED @map("temporarily_restricted")
  PERMANENTLY_RESTRICTED @map("permanently_restricted")
}

/// Form 990 Part IX functional expense column. Upstream FUNCTIONS.
enum ExpenseFunction {
  PROGRAM     @map("program")
  MANAGEMENT  @map("management")
  FUNDRAISING @map("fundraising")
}

/// Basis a nonprofit functional-allocation rule spreads on. Upstream ALLOCATION_BASES.
enum AllocationBasis {
  PERCENT     @map("percent")
  SQUARE_FEET @map("square_feet")
  HOURS       @map("hours")
}

/// Report kinds a SavedReport may point at. Upstream validates this list in the API and
/// stores a VarChar(50); we enforce it in the database. Wire values are unchanged.
enum SavedReportType {
  PROFIT_LOSS                     @map("profit_loss")
  BALANCE_SHEET                   @map("balance_sheet")
  AR_AGING                        @map("ar_aging")
  AP_AGING                        @map("ap_aging")
  SALES_TAX                       @map("sales_tax")
  GENERAL_LEDGER                  @map("general_ledger")
  INCOME_BY_CUSTOMER              @map("income_by_customer")
  ACCOUNT_TRANSACTIONS            @map("account_transactions")
  CASH_FLOW                       @map("cash_flow")
  ANALYTICS_DASHBOARD             @map("analytics_dashboard")
  STATEMENT_OF_FINANCIAL_POSITION @map("statement_of_financial_position")
  STATEMENT_OF_ACTIVITIES         @map("statement_of_activities")
  FUND_BALANCES                   @map("fund_balances")
  FUNCTIONAL_EXPENSES             @map("functional_expenses")
  PLEDGES                         @map("pledges")
}

// ---------------------------------------------------------------------------
// Budgets (§4)
// ---------------------------------------------------------------------------

/// One budgeted amount for one account in one month of one year. Upstream `budgets`.
/// The variance report (§4.2) only ever reports accounts that have at least one row here,
/// and flips the sign of the actual for income/liability/equity accounts.
model Budget {
  id Int @id @default(autoincrement())

  accountId Int     @map("account_id")
  account   Account @relation("Budget_account", fields: [accountId], references: [id], onDelete: Restrict)
  year      Int
  month     Int // 1..12
  amount    Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Upstream uq_budget_account_year_month, now company-scoped. POST /api/budgets and
  // /api/budgets/bulk upsert on this key.
  @@unique([accountId, year, month], name: "uq_budget_account_year_month")
  @@index([year])
  @@map("budgets")
}

// ---------------------------------------------------------------------------
// Saved reports (§5)
// ---------------------------------------------------------------------------

/// A named parameter set for a report. NOTHING is cached — the SPA re-runs the
/// underlying /api/reports/* endpoint with these parameters. Upstream `saved_reports`.
model SavedReport {
  id Int @id @default(autoincrement())

  name       String          @db.VarChar(200) // trimmed; blank rejected by the API
  reportType SavedReportType @map("report_type")
  // Serialized form is capped at 65536 bytes by the API (§5), not by the column.
  parameters Json            @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([reportType])
  @@index([name])
  @@map("saved_reports")
}

// ---------------------------------------------------------------------------
// Dashboard layout (§3.1)
// ---------------------------------------------------------------------------

/// The per-user dashboard widget layout behind GET|PUT|DELETE /api/preferences/dashboard.
/// DIVERGENCE: upstream stores this as one row in the generic `user_preferences` table
/// under key "dashboard". We give it a typed table of its own so the Core UserPreference
/// model stays free of dashboard semantics; the API surface and JSON body
/// (`{"value": {...}}`, object only, <= 16000 bytes serialized) are unchanged.
model DashboardLayout {
  id Int @id @default(autoincrement())

  // NULL for the single-password operator session, which has no user row (§3.1).
  userId Int? @map("user_id") /// control-plane users.id — no FK: identity lives outside this database

  // The stored preference object. Widget order lives under the "widgets"/"order" keys the
  // SPA writes; unknown widget ids are skipped at render time, and an empty layout falls
  // back to DEFAULT_LAYOUT (or NONPROFIT_DEFAULT_LAYOUT in nonprofit mode).
  value Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId])
  @@map("dashboard_layouts")
}

// ---------------------------------------------------------------------------
// Job costing (§6.1)
// ---------------------------------------------------------------------------

/// A "Customer:Job" / project / (nonprofit) grant. Upstream `jobs`.
/// full_name = customer ? `${customer.name}: ${job.name}` : job.name  (colon + SPACE).
/// NOTE: the /api/csv/export/jobs "Customer:Job" cell uses "{cust}:{name}" with NO space.
model Job {
  id Int @id @default(autoincrement())

  customerId       Int       @map("customer_id")
  customer         Customer  @relation("Job_customer", fields: [customerId], references: [id], onDelete: Restrict)
  // Unique per customer case-insensitively, and may not contain ":" — both enforced in the
  // API (409 "This customer already has a job named '{name}'"), not by a DB constraint.
  name             String    @db.VarChar(200)
  jobNumber        String?   @map("job_number") @db.VarChar(50)
  status           JobStatus @default(IN_PROGRESS)
  jobType          String?   @map("job_type") @db.VarChar(100)
  description      String?   @db.Text
  siteAddress      String?   @map("site_address") @db.Text
  startDate        DateTime? @map("start_date") @db.Date
  projectedEndDate DateTime? @map("projected_end_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  contractAmount   Decimal?  @map("contract_amount") @db.Decimal(14, 2)
  notes            String?   @db.Text
  // DELETE is refused with 400 once any transaction references the job — deactivate
  // instead, so posted history keeps its dimension.
  isActive         Boolean   @default(true) @map("is_active")

  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  transactions          Transaction[]          @relation("Transaction_job")
  transactionLines      TransactionLine[]      @relation("TransactionLine_job")
  invoices              Invoice[]              @relation("Invoice_job")
  invoiceLines          InvoiceLine[]          @relation("InvoiceLine_job")
  estimates             Estimate[]             @relation("Estimate_job")
  estimateLines         EstimateLine[]         @relation("EstimateLine_job")
  creditMemos           CreditMemo[]           @relation("CreditMemo_job")
  recurringInvoices     RecurringInvoice[]     @relation("RecurringInvoice_job")
  bills                 Bill[]                 @relation("BillJob")
  billLines             BillLine[]             @relation("BillLineJob")
  purchaseOrders        PurchaseOrder[]        @relation("PurchaseOrderJob")
  purchaseOrderLines    PurchaseOrderLine[]    @relation("PurchaseOrderLineJob")
  vendorCredits         VendorCredit[]         @relation("VendorCreditJob")
  vendorCreditLines     VendorCreditLine[]     @relation("VendorCreditLineJob")
  timeEntries           TimeEntry[]            @relation("TimeEntry_job")
  jobCosts              JobCost[]              @relation("JobCost_job")
  jobCostLines          JobCostLine[]          @relation("JobCostLine_job")
  jobBudgets            JobBudget[]            @relation("JobBudget_job")
  allocationRuleTargets AllocationRuleTarget[] @relation("AllocationRuleTarget_job")
  inKindDonations       InKindDonation[]       @relation("InKindDonation_job")
  inKindDonationLines   InKindDonationLine[]   @relation("InKindDonationLine_job")

  @@index([customerId])
  @@index([status])
  @@index([isActive])
  @@map("jobs")
}

/// A cost code in the work-breakdown structure (CSI MasterFormat by default).
/// Arbitrary-depth tree via parentId. Upstream `cost_codes`. label = `${code} ${name}`.trim().
model CostCode {
  id Int @id @default(autoincrement())

  code      String     @db.VarChar(20)
  name      String     @db.VarChar(200)
  // FK BY VALUE to CostType.code, not by id — cost types are operator-extensible, so this
  // stays a string rather than an enum. Unknown values are rejected with 422 by the API.
  costType  String     @default("other") @map("cost_type") @db.VarChar(20)
  // Default debit (cost) account for lines coded here; step 2 of resolve_line_accounts.
  accountId Int?       @map("account_id")
  account   Account?   @relation("CostCode_account", fields: [accountId], references: [id], onDelete: Restrict)
  parentId  Int?       @map("parent_id")
  parent    CostCode?  @relation("CostCodeParent", fields: [parentId], references: [id], onDelete: Restrict)
  costCodes CostCode[] @relation("CostCodeParent")
  notes     String?    @db.Text
  // DELETE is refused with 400 when posted transaction_lines or bill_lines reference it.
  isActive  Boolean    @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Upstream global unique on code; clash detection in the API is case-insensitive.
  transactionLines   TransactionLine[]   @relation("TransactionLine_costCode")
  invoiceLines       InvoiceLine[]       @relation("InvoiceLine_costCode")
  estimateLines      EstimateLine[]      @relation("EstimateLine_costCode")
  billLines          BillLine[]          @relation("BillLineCostCode")
  purchaseOrderLines PurchaseOrderLine[] @relation("PurchaseOrderLineCostCode")
  vendorCreditLines  VendorCreditLine[]  @relation("VendorCreditLineCostCode")
  timeEntries        TimeEntry[]         @relation("TimeEntry_costCode")
  equipments         Equipment[]         @relation("Equipment_costCode")
  jobCostLines       JobCostLine[]       @relation("JobCostLine_costCode")
  jobBudgets         JobBudget[]         @relation("JobBudget_costCode")

  @@unique([code])
  @@index([parentId])
  @@index([costType])
  @@map("cost_codes")
}

/// A category of cost (labor, material, subcontract, equipment, other) with its default
/// posting accounts and burden policy. Seeded idempotently by code. Upstream `cost_types`.
/// The five DEFAULT_COST_TYPES codes cannot be deleted.
model CostType {
  id Int @id @default(autoincrement())

  code                  String       @db.VarChar(20)
  name                  String       @db.VarChar(100)
  isLabor               Boolean      @default(false) @map("is_labor")
  // Flat burden percentage applied to labor cost. DIVERGENCE: upstream Decimal(6,2);
  // conventions put percentages at (14,4).
  burdenPct             Decimal?     @map("burden_pct") @db.Decimal(14, 4)
  // PAYROLL suppresses the per-time-entry burden line so the pay run can distribute the
  // actual employer cost instead — otherwise the job would carry burden twice (§6.8).
  burdenMethod          BurdenMethod @default(FLAT) @map("burden_method")
  // Default DEBIT account (step 3 of resolve_line_accounts).
  defaultAccountId      Int?         @map("default_account_id")
  defaultAccount        Account?     @relation("CostTypeDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: Restrict)
  // Default CREDIT account. Must be a P&L contra-expense account — a balance-sheet offset
  // would double the cost on the P&L once the real expense posts (§6.11 setup-offsets).
  offsetAccountId       Int?         @map("offset_account_id")
  offsetAccount         Account?     @relation("CostTypeOffsetAccount", fields: [offsetAccountId], references: [id], onDelete: Restrict)
  burdenOffsetAccountId Int?         @map("burden_offset_account_id")
  burdenOffsetAccount   Account?     @relation("CostTypeBurdenOffsetAccount", fields: [burdenOffsetAccountId], references: [id], onDelete: Restrict)
  sortOrder             Int          @default(0) @map("sort_order")
  isActive              Boolean      @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([code])
  @@index([sortOrder, code])
  @@map("cost_types")
}

/// A piece of owned equipment charged to jobs at an hourly recovery rate.
/// Upstream `equipment`.
model Equipment {
  id Int @id @default(autoincrement())

  code              String?   @db.VarChar(30)
  name              String    @db.VarChar(200)
  // Used as the line rate when an equipment line is entered with a falsy rate (§6.11).
  hourlyRate        Decimal   @default(0) @map("hourly_rate") @db.Decimal(14, 2)
  costCodeId        Int?      @map("cost_code_id")
  costCode          CostCode? @relation("Equipment_costCode", fields: [costCodeId], references: [id], onDelete: Restrict)
  // Credit side for equipment lines — step 2 of the credit branch of resolve_line_accounts.
  recoveryAccountId Int?      @map("recovery_account_id")
  recoveryAccount   Account?  @relation("Equipment_recoveryAccount", fields: [recoveryAccountId], references: [id], onDelete: Restrict)
  notes             String?   @db.Text
  // DELETE is refused with 400 when job cost lines reference it.
  isActive          Boolean   @default(true) @map("is_active")

  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobCostLines JobCostLine[] @relation("JobCostLine_equipment")

  @@index([name])
  @@index([isActive])
  @@map("equipment")
}

/// The "Job Cost Entry" document — one balanced journal entry per document (§6.7).
/// Upstream `job_costs`. Numbering "JC-000001" (6-pad).
model JobCost {
  id Int @id @default(autoincrement())

  number        String        @db.VarChar(30)
  date          DateTime      @db.Date
  // NULL for allocation / payroll-burden documents, whose LINES name the jobs.
  jobId         Int?          @map("job_id")
  job           Job?          @relation("JobCost_job", fields: [jobId], references: [id], onDelete: Restrict)
  memo          String?       @db.Text
  source        JobCostSource @default(MANUAL)
  status        DocStatus     @default(POSTED)
  // The posted journal. Voiding posts a MIRRORED entry rather than deleting this one.
  transactionId Int?          @map("transaction_id")
  transaction   Transaction?  @relation("JobCost_transaction", fields: [transactionId], references: [id], onDelete: Restrict)
  total         Decimal       @default(0) @db.Decimal(14, 2)

  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  payRuns      PayRun[]      @relation("PayRun_burdenJobCost")
  timeEntries  TimeEntry[]   @relation("TimeEntry_jobCost")
  jobCostLines JobCostLine[] @relation("JobCostLine_jobCost")

  @@unique([number])
  @@index([date])
  @@index([jobId])
  @@index([status])
  @@map("job_costs")
}

/// One cost line of a job cost entry. Upstream `job_cost_lines`.
/// Posting DEBITs debitAccountId tagged with the job dimensions and CREDITs
/// creditAccountId with job_id = NULL, so the offset lands in the "No job" bucket and the
/// P&L is unchanged while the job carries the cost (§6.7).
model JobCostLine {
  id Int @id @default(autoincrement())

  jobCostId       Int        @map("job_cost_id")
  jobCost         JobCost    @relation("JobCostLine_jobCost", fields: [jobCostId], references: [id], onDelete: Cascade)
  // Overrides the header job; required (effectively) when the header has none —
  // 422 "Line {n}: pick a job".
  jobId           Int?       @map("job_id")
  job             Job?       @relation("JobCostLine_job", fields: [jobId], references: [id], onDelete: Restrict)
  costCodeId      Int?       @map("cost_code_id")
  costCode        CostCode?  @relation("JobCostLine_costCode", fields: [costCodeId], references: [id], onDelete: Restrict)
  // Effective type = line.costType ?? code.costType ?? (equipment ? "equipment" : "other").
  costType        String?    @map("cost_type") @db.VarChar(20)
  description     String?    @db.Text
  // Hours, miles or units. DIVERGENCE: upstream Decimal(12,2); conventions put quantities
  // at (14,4). Negative quantities/amounts are rejected — void and re-enter instead.
  quantity        Decimal    @default(1) @db.Decimal(14, 4)
  rate            Decimal    @default(0) @db.Decimal(14, 4)
  amount          Decimal    @default(0) @db.Decimal(14, 2)
  // Both NOT NULL: resolve_line_accounts fails the request rather than posting unbalanced.
  debitAccountId  Int        @map("debit_account_id")
  debitAccount    Account    @relation("JobCostLineDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccountId Int        @map("credit_account_id")
  creditAccount   Account    @relation("JobCostLineCreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  employeeId      Int?       @map("employee_id")
  employee        Employee?  @relation("JobCostLine_employee", fields: [employeeId], references: [id], onDelete: Restrict)
  equipmentId     Int?       @map("equipment_id")
  equipment       Equipment? @relation("JobCostLine_equipment", fields: [equipmentId], references: [id], onDelete: Restrict)
  // Set when the line came from a time entry; cleared on void of the parent document.
  timeEntryId     Int?       @map("time_entry_id")
  timeEntry       TimeEntry? @relation("JobCostLine_timeEntry", fields: [timeEntryId], references: [id], onDelete: SetNull)
  isBurden        Boolean    @default(false) @map("is_burden")
  isBillable      Boolean    @default(false) @map("is_billable")
  lineOrder       Int        @default(0) @map("line_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([jobCostId])
  @@index([jobId])
  @@index([costCodeId])
  @@index([timeEntryId])
  @@map("job_cost_lines")
}

/// A budget row for a job: cost budget + revenue budget, at whole-job, cost-type or
/// cost-code granularity. Upstream `job_budgets`.
/// `original` = rows with source <> CHANGE; `changes` = rows with source = CHANGE (§6.4).
model JobBudget {
  id Int @id @default(autoincrement())

  jobId         Int             @map("job_id")
  job           Job             @relation("JobBudget_job", fields: [jobId], references: [id], onDelete: Cascade)
  // Code XOR type XOR neither (= whole job). Never both — 422 from the API.
  costCodeId    Int?            @map("cost_code_id")
  costCode      CostCode?       @relation("JobBudget_costCode", fields: [costCodeId], references: [id], onDelete: Restrict)
  costType      String?         @map("cost_type") @db.VarChar(20)
  amount        Decimal         @default(0) @db.Decimal(14, 2) // cost budget
  revenueAmount Decimal         @default(0) @map("revenue_amount") @db.Decimal(14, 2)
  source        JobBudgetSource @default(MANUAL)
  // Set when the row was generated by budgets_from_estimate (§6.10).
  estimateId    Int?            @map("estimate_id")
  estimate      Estimate?       @relation("JobBudget_estimate", fields: [estimateId], references: [id], onDelete: SetNull)
  notes         String?         @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Upstream uq_job_budget, now company-scoped. NOTE: Postgres treats NULLs as distinct,
  // so the whole-job row (both NULL) is not deduped by the constraint — the API enforces it.
  @@unique([jobId, costCodeId, costType], name: "uq_job_budget")
  @@index([jobId])
  @@map("job_budgets")
}

// ---------------------------------------------------------------------------
// Class / fund tracking (§7)
// ---------------------------------------------------------------------------

/// A tracking class — a "Fund" in nonprofit mode. Upstream table `classes`
/// (upstream model name TxnClass; registry name here is TrackingClass).
/// Exactly one row per company carries isSystemDefault, the "Uncategorized" bucket that
/// class_attribution() coalesces to so every by-class report reconciles to the plain P&L.
model TrackingClass {
  id Int @id @default(autoincrement())

  name            String           @db.VarChar(100)
  isArchived      Boolean          @default(false) @map("is_archived")
  // The system default row cannot be renamed, archived, restricted or deleted.
  isSystemDefault Boolean          @default(false) @map("is_system_default")
  restriction     FundRestriction  @default(UNRESTRICTED)
  // Fallback for functional_attribution when a line carries no explicit function.
  defaultFunction ExpenseFunction? @map("default_function")
  donorName       String?          @map("donor_name") @db.VarChar(200)
  purpose         String?          @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Upstream global unique on name; resolve_class_id matches exact then case-insensitive.
  transactions          Transaction[]          @relation("Transaction_class")
  transactionLines      TransactionLine[]      @relation("TransactionLine_class")
  invoices              Invoice[]              @relation("Invoice_class")
  invoiceLines          InvoiceLine[]          @relation("InvoiceLine_class")
  estimates             Estimate[]             @relation("Estimate_class")
  creditMemos           CreditMemo[]           @relation("CreditMemo_class")
  recurringInvoices     RecurringInvoice[]     @relation("RecurringInvoice_class")
  bills                 Bill[]                 @relation("BillClass")
  billLines             BillLine[]             @relation("BillLineClass")
  vendorCredits         VendorCredit[]         @relation("VendorCreditClass")
  vendorCreditLines     VendorCreditLine[]     @relation("VendorCreditLineClass")
  restrictionReleases   RestrictionRelease[]   @relation("RestrictionRelease_class")
  allocationRules       AllocationRule[]       @relation("AllocationRule_sourceClass")
  allocationRuleTargets AllocationRuleTarget[] @relation("AllocationRuleTarget_class")
  inKindDonations       InKindDonation[]       @relation("InKindDonation_class")
  inKindDonationLines   InKindDonationLine[]   @relation("InKindDonationLine_class")

  @@unique([name])
  @@index([isArchived])
  @@index([restriction])
  @@map("classes")
}

// ---------------------------------------------------------------------------
// Nonprofit: restriction releases and functional allocations (§8.8, §8.9)
// ---------------------------------------------------------------------------

/// A net-assets-released-from-restrictions entry: DR 3400 / CR 3300 for one fund.
/// Numbering "RL-000001" (6-pad). Upstream `restriction_releases`.
/// Releases are real journal entries, which is why the §8.2 composed net-asset lines add
/// up without any year-end close.
model RestrictionRelease {
  id Int @id @default(autoincrement())

  number        String        @db.VarChar(30)
  date          DateTime      @db.Date
  classId       Int           @map("class_id")
  class         TrackingClass @relation("RestrictionRelease_class", fields: [classId], references: [id], onDelete: Restrict)
  amount        Decimal       @default(0) @db.Decimal(14, 2)
  // The window the suggestion was computed over; defaults to fiscal YTD.
  periodStart   DateTime?     @map("period_start") @db.Date
  periodEnd     DateTime?     @map("period_end") @db.Date
  memo          String?       @db.Text
  status        DocStatus     @default(POSTED)
  transactionId Int?          @map("transaction_id")
  transaction   Transaction?  @relation("RestrictionRelease_transaction", fields: [transactionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([number])
  @@index([date])
  @@index([classId])
  @@index([status])
  @@map("restriction_releases")
}

/// A rule for spreading unassigned expense across funds/functions (Form 990 Part IX).
/// Upstream `allocation_rules`.
model AllocationRule {
  id Int @id @default(autoincrement())

  name            String          @db.VarChar(200)
  basis           AllocationBasis
  // Optional narrowing of the pool: only this account and/or only this fund.
  sourceAccountId Int?            @map("source_account_id")
  sourceAccount   Account?        @relation("AllocationRule_sourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  sourceClassId   Int?            @map("source_class_id")
  sourceClass     TrackingClass?  @relation("AllocationRule_sourceClass", fields: [sourceClassId], references: [id], onDelete: Restrict)
  notes           String?         @db.Text
  // DELETE is refused with 409 once the rule has posted allocations — deactivate instead.
  isActive        Boolean         @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Clash detection in the API is case-insensitive: 409 "A rule with that name exists".
  allocationRuleTargets AllocationRuleTarget[] @relation("AllocationRuleTarget_rule")
  functionalAllocations FunctionalAllocation[] @relation("FunctionalAllocation_rule")

  @@unique([name])
  @@index([isActive])
  @@map("allocation_rules")
}

/// One ordered destination of an allocation rule. A target needs a fund, a function, or
/// both; with basis = HOURS every target must name a job. Upstream `allocation_rule_targets`.
/// PUT /allocation-rules/{id} replaces the whole target list.
model AllocationRuleTarget {
  id Int @id @default(autoincrement())

  ruleId    Int              @map("rule_id")
  rule      AllocationRule   @relation("AllocationRuleTarget_rule", fields: [ruleId], references: [id], onDelete: Cascade)
  // Falls back to rule.sourceClassId, then the pool row's class, when null.
  classId   Int?             @map("class_id")
  class     TrackingClass?   @relation("AllocationRuleTarget_class", fields: [classId], references: [id], onDelete: Restrict)
  function  ExpenseFunction?
  // Required when basis = HOURS: the job whose time entries supply the weight.
  jobId     Int?             @map("job_id")
  job       Job?             @relation("AllocationRuleTarget_job", fields: [jobId], references: [id], onDelete: Restrict)
  // Stored weight for PERCENT / SQUARE_FEET; cannot be negative. Ignored for HOURS.
  weight    Decimal          @default(0) @db.Decimal(14, 4)
  lineOrder Int              @default(0) @map("line_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ruleId])
  @@map("allocation_rule_targets")
}

/// A posted functional-allocation run for one rule over one period. Numbering "FA-000001".
/// Upstream `functional_allocations`.
/// Each pool row is re-classed within the SAME natural account (DR shares tagged with the
/// target fund/function, CR the whole row back with explicit function = NULL so it never
/// re-enters the pool), so the P&L is unchanged to the cent and re-running the same period
/// finds an empty pool — the guard against double allocation.
model FunctionalAllocation {
  id Int @id @default(autoincrement())

  number        String         @db.VarChar(30)
  date          DateTime       @db.Date
  ruleId        Int            @map("rule_id")
  rule          AllocationRule @relation("FunctionalAllocation_rule", fields: [ruleId], references: [id], onDelete: Restrict)
  periodStart   DateTime       @map("period_start") @db.Date
  periodEnd     DateTime       @map("period_end") @db.Date
  memo          String?        @db.Text
  status        DocStatus      @default(POSTED)
  transactionId Int?           @map("transaction_id")
  transaction   Transaction?   @relation("FunctionalAllocation_transaction", fields: [transactionId], references: [id], onDelete: Restrict)
  total         Decimal        @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([number])
  @@index([date])
  @@index([ruleId])
  @@index([status])
  @@map("functional_allocations")
}

// ---------------------------------------------------------------------------
// Nonprofit: in-kind gifts (§8.10)
// ---------------------------------------------------------------------------

/// A non-cash (in-kind) contribution document. Upstream `in_kind_gifts`
/// (registry name InKindDonation). Numbering "IK-0001" (4-pad).
/// A gift whose lines are all zero-valued still exists as a document — the acknowledgment
/// describes the property — and posts nothing.
model InKindDonation {
  id Int @id @default(autoincrement())

  number        String         @db.VarChar(30)
  // The donor. Upstream column is customer_id — "Donor" is a display-only term swap.
  customerId    Int            @map("customer_id")
  customer      Customer       @relation("InKindDonation_customer", fields: [customerId], references: [id], onDelete: Restrict)
  date          DateTime       @db.Date
  memo          String?        @db.Text
  status        DocStatus      @default(POSTED)
  transactionId Int?           @map("transaction_id")
  transaction   Transaction?   @relation("InKindDonation_transaction", fields: [transactionId], references: [id], onDelete: Restrict)
  total         Decimal        @default(0) @db.Decimal(14, 2)
  // Header dimensions; each line may override them.
  classId       Int?           @map("class_id")
  class         TrackingClass? @relation("InKindDonation_class", fields: [classId], references: [id], onDelete: Restrict)
  jobId         Int?           @map("job_id")
  job           Job?           @relation("InKindDonation_job", fields: [jobId], references: [id], onDelete: Restrict)

  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  inKindDonationLines InKindDonationLine[] @relation("InKindDonationLine_gift")

  @@unique([number])
  @@index([date])
  @@index([customerId])
  @@index([status])
  @@map("in_kind_gifts")
}

/// One item of donated property. Upstream `in_kind_gift_lines`.
/// The debit account must be asset|expense|cogs (what the property is); the credit account
/// defaults to 4400 In-Kind Contributions and must be an income account.
model InKindDonationLine {
  id Int @id @default(autoincrement())

  inKindGiftId    Int            @map("in_kind_gift_id")
  gift            InKindDonation @relation("InKindDonationLine_gift", fields: [inKindGiftId], references: [id], onDelete: Cascade)
  description     String         @db.Text // required: "Describe the property given"
  // quantity > 0 and fairValue >= 0, enforced at the schema layer.
  // DIVERGENCE: upstream stored both at (12,2); conventions put quantities at (14,4).
  quantity        Decimal        @default(1) @db.Decimal(14, 4)
  fairValue       Decimal        @default(0) @map("fair_value") @db.Decimal(14, 4) // PER UNIT
  amount          Decimal        @default(0) @db.Decimal(14, 2) // _q(quantity * fairValue)
  debitAccountId  Int            @map("debit_account_id")
  debitAccount    Account        @relation("InKindDonationLineDebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccountId Int            @map("credit_account_id")
  creditAccount   Account        @relation("InKindDonationLineCreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  classId         Int?           @map("class_id")
  class           TrackingClass? @relation("InKindDonationLine_class", fields: [classId], references: [id], onDelete: Restrict)
  jobId           Int?           @map("job_id")
  job             Job?           @relation("InKindDonationLine_job", fields: [jobId], references: [id], onDelete: Restrict)
  lineOrder       Int            @default(0) @map("line_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([inKindGiftId])
  @@map("in_kind_gift_lines")
}

// ---------------------------------------------------------------------------
// REGISTRY NOTES — names in the Reporting registry that are NOT tables
// ---------------------------------------------------------------------------
//
// The following registry entries have no upstream table and are deliberately NOT emitted
// as models; emitting them would create real Postgres tables with no writer and would
// duplicate data that already lives elsewhere. Cross-domain code should use the mapping
// below.
//
//   BudgetLine     — upstream has no `budget_lines` table. A budget is stored as twelve
//                    monthly `budgets` rows per account (§4.1); the "lines" of the variance
//                    report are computed, not stored.
//   Fund           — display alias of TrackingClass (`classes`). §0.8: nonprofit mode swaps
//                    Class/Classes -> Fund/Funds in the UI only; DB columns never change.
//                    /fund-balances (§8.5) is computed from `classes` + the ledger.
//   Donor          — display alias of Customer (Sales/AR). In-kind gifts, pledges and
//                    giving statements all key on `customer_id`.
//   Pledge         — display alias of Invoice, flagged by the existing `invoices.is_pledge`
//                    column (§8.12); recurring pledges are RecurringInvoice rows. The
//                    pledge report is computed from those two tables.
//   PledgePayment  — display alias of Payment / PaymentAllocation (Sales/AR). §8.12 derives
//                    `received` from payment_allocations against pledge invoices.
//
// If the port later decides it wants first-class Fund/Pledge tables, that is a data-model
// divergence from upstream and must be decided explicitly, not introduced here.
//
// NEW MODELS ADDED: RestrictionRelease (`restriction_releases`),
// AllocationRule (`allocation_rules`), AllocationRuleTarget (`allocation_rule_targets`),
// FunctionalAllocation (`functional_allocations`),
// InKindDonationLine (`in_kind_gift_lines`).
/// `backups.backup_type` — manual (operator pressed the button) vs auto (scheduled).
enum BackupType {
  MANUAL @map("manual")
  AUTO   @map("auto")

  @@map("backup_type")
}

/// `qbo_mappings.entity_type` — the six entity kinds QBO sync maps (§25.2).
enum QboEntityType {
  ACCOUNT  @map("account")
  CUSTOMER @map("customer")
  VENDOR   @map("vendor")
  ITEM     @map("item")
  INVOICE  @map("invoice")
  PAYMENT  @map("payment")

  @@map("qbo_entity_type")
}

/// The eight AI providers of the §19.1 registry. Values are the verbatim
/// `key` field of each ProviderSpec (also the value stored in `ai_provider`).
enum AiProvider {
  GROK              @map("grok")
  GROQ              @map("groq")
  CLOUDFLARE        @map("cloudflare")
  CLOUDFLARE_WORKER @map("cloudflare_worker")
  ANTHROPIC         @map("anthropic")
  OPENAI            @map("openai")
  GEMINI            @map("gemini")
  CUSTOM            @map("custom")

  @@map("ai_provider")
}

/// Wire format used to talk to a provider (§19.1 `wire_format`).
enum AiWireFormat {
  OPENAI    @map("openai")
  ANTHROPIC @map("anthropic")
  GEMINI    @map("gemini")

  @@map("ai_wire_format")
}

/// Pending-scan lifecycle for the OCR intake bucket (§18.4).
/// Upstream has no status column — a scan exists on disk or it does not.
/// DIVERGENCE: we keep the row and mark its fate so the "Receipts to Review"
/// card and the sweeper can both be driven from SQL instead of a directory walk.
enum OcrIntakeStatus {
  PENDING  @map("pending")
  ATTACHED @map("attached")
  EXPIRED  @map("expired")
  DELETED  @map("deleted")

  @@map("ocr_intake_status")
}

/// Every file-based import path the platform offers: the six CSV dialects of
/// §26.5 SOURCES, plus IIF (§24), QBO (§25) and the QuickBooks Desktop report
/// CSV (§27). Values match the `SOURCES` keys / route segments verbatim.
enum MigrationSource {
  XERO      @map("xero")
  MYOB      @map("myob")
  SAGE      @map("sage")
  WAVE      @map("wave")
  ZOHO      @map("zoho")
  GNUCASH   @map("gnucash")
  IIF       @map("iif")
  QBO       @map("qbo")
  QB_REPORT @map("qb_report")

  @@map("migration_source")
}

/// Which half of the two-phase migration contract a run represents.
/// `dry_run` writes NOTHING (§26.2); `import` is gated on a passing dry run (§26.3).
enum MigrationRunMode {
  DRY_RUN  @map("dry_run")
  IMPORT   @map("import")
  VALIDATE @map("validate") // IIF pre-flight (POST /api/iif/validate) — never touches the DB
  EXPORT   @map("export") // IIF / QBO export direction

  @@map("migration_run_mode")
}

enum MigrationRunStatus {
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")

  @@map("migration_run_status")
}

/// The six categories of the global search response (§20). Values are the
/// verbatim response-object keys so the index can be projected straight out.
enum SearchEntityType {
  CUSTOMERS @map("customers")
  VENDORS   @map("vendors")
  ITEMS     @map("items")
  INVOICES  @map("invoices")
  ESTIMATES @map("estimates")
  PAYMENTS  @map("payments")

  @@map("search_entity_type")
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

/// File uploaded against any entity; doubles as the per-employee HR document vault
/// via `employeeId` + `docCategory`. Upstream: `attachments`.
/// Limits enforced in code (§14.1): 50 MB, the `_ENTITY_TYPE_DIRS` whitelist, the
/// ALLOWED_MIME_TYPES / ALLOWED_EXTENSIONS allowlists (nothing a browser would
/// render-and-execute, because attachments are served back from /static/).
model Attachment {
  id              Int              @id @default(autoincrement())
  /// One of `_ENTITY_TYPE_DIRS`: invoice, bill, expense, estimate, purchase_order,
  /// vendor_credit, vendor, customer. Routing the user-supplied value through that
  /// dict — never using the raw string — is the sanitisation point for the
  /// path-injection taint flow. Kept as a string (not an enum) because the GET
  /// listing route matches it raw, with no validation (§14.3).
  entityType      String           @map("entity_type") @db.VarChar(50)
  entityId        Int              @map("entity_id")
  filename        String           @db.VarChar(255)
  /// POSIX form ALWAYS, relative to `filesRoot()` in both desktop and server mode
  /// ("uploads/attachments/…"), so a company file keeps working when it is moved
  /// between platforms. Reads split on BOTH separators — rows written by a pre-fix
  /// Windows install carry backslashes (§13, §14.2).
  filePath        String           @map("file_path") @db.VarChar(500)
  mimeType        String?          @map("mime_type") @db.VarChar(100)
  fileSize        Int?             @map("file_size")
  /// HR document vault: set when this file belongs to an employee's record. The
  /// /api/employees/{id}/documents route that reads these is admin-only under
  /// `_ADMIN_ONLY_EMPLOYEE_RE` (§4.3).
  employeeId      Int?             @map("employee_id")
  employee        Employee?        @relation("Attachment_employee", fields: [employeeId], references: [id], onDelete: Restrict)
  /// w4, i9, offer_letter, … Free text by design — the vault grows new categories
  /// without a migration.
  docCategory     String?          @map("doc_category") @db.VarChar(50)
  /// Upstream's own column (server default now); `GET /api/attachments/{type}/{id}`
  /// orders by it DESC.
  uploadedAt      DateTime         @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  vendors         Vendor[]         @relation("VendorW9Document")
  onboardingTasks OnboardingTask[] @relation("OnboardingTask_document")
  ocrIntakes      OcrIntake[]      @relation("OcrIntake_attachment")

  @@index([entityType, entityId])
  @@index([employeeId])
  @@index([uploadedAt])
  @@map("attachments")
}

/// A backup taken of this installation. Registry name BackupRecord; upstream table `backups`.
/// GLOBAL (conventions exception): a backup is a `pg_dump -F c` of the whole database or
/// an sqlite3 online-backup of the whole file — it is not a per-company artefact, and in
/// our single-database model it necessarily spans every company.
/// `GET /api/backups` filters this list to rows whose file still exists on disk.
/// Listed in the audit hook's manual callers: a RESTORE breadcrumb row is written and
/// COMMITTED to `audit_log` BEFORE the restore runs, because the restore overwrites the
/// entire database including `audit_log` itself (§9.2, §17.2).
model BackupRecord {
  id         Int         @id @default(autoincrement())
  /// `slowbooks_YYYYMMDD_HHMMSS.sql` (PostgreSQL) or `…​.db` (SQLite), local time.
  /// Validated against `_BACKUP_FILENAME_RE` /^[A-Za-z0-9_.-]+\.(sql|dump|backup|db)$/
  /// BEFORE any path is constructed — that regex is the trust boundary (§17.1).
  filename   String      @db.VarChar(255)
  fileSize   Int?        @map("file_size")
  backupType BackupType? @default(MANUAL) @map("backup_type")
  notes      String?     @db.Text
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("backups")
}

// ---------------------------------------------------------------------------
// OCR receipt intake
// ---------------------------------------------------------------------------

/// Remembered field geometry for one merchant's receipts. Upstream: `ocr_templates`.
/// Anchor-relative, never absolute pixels: a field box is stored as an anchor word's
/// text plus the box's offset from that anchor, all scaled by the ANCHOR'S HEIGHT
/// (text height is the stable unit across DPI and photo scale; page width is not) — §18.6.
/// Honestly framed: anchor matching plus operator feedback, no ML.
model OcrTemplate {
  id           Int         @id @default(autoincrement())
  /// `merchantKey(name)`: uppercase, non-alphanumerics to spaces, collapse whitespace
  /// FIRST (an unbounded \s* before \d is polynomial on adversarial all-space input),
  /// then strip store numbers, then collapse again.
  /// "HOME DEPOT #4521 SHOREWOOD" -> "HOME DEPOT SHOREWOOD".
  /// DIVERGENCE: upstream's global UNIQUE becomes per-company — two companies may
  /// each have corrected boxes for the same merchant.
  merchantKey  String      @map("merchant_key") @db.VarChar(120)
  merchantName String?     @map("merchant_name") @db.VarChar(200)
  /// {fieldKey: {anchor_text, anchor_index, anchor_count, dx, dy, w, h}} for fieldKey
  /// in FIELD_OCR_TYPE (total, tax, subtotal, date, merchant, reference).
  /// Kept as TEXT holding JSON, verbatim to upstream, because `_fields(row)` must
  /// tolerate any non-object payload by returning {} rather than erroring.
  fieldsJson   String      @default("{}") @map("fields_json") @db.Text
  /// Incremented only when `applyTemplate` actually read something.
  useCount     Int         @default(0) @map("use_count")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  ocrIntakes   OcrIntake[] @relation("OcrIntake_template")

  @@unique([merchantKey])
  @@index([merchantKey])
  @@map("ocr_templates")
}

/// A pending receipt scan awaiting review on the box-to-fix canvas. Registry name OcrIntake.
/// DIVERGENCE: upstream has NO table for this — the bucket is a directory under
/// `filesRoot()/uploads/intake` holding `<id><ext>` plus a `<id>.json` sidecar, and
/// `listIntake()` walks the directory. That works when the process owns the disk; it does
/// not survive several app instances sharing one database, and "Receipts to Review" then
/// cannot be answered in SQL. The row is the index; the bytes stay on disk exactly as
/// before (NEVER served statically), and the sweeper's rules are unchanged:
/// INTAKE_TTL_HOURS = 24, INTAKE_MAX_FILES = 500, INTAKE_MAX_BYTES = 1 GB, evict oldest first.
model OcrIntake {
  id               Int             @id @default(autoincrement())
  /// `uuid4().hex` — must match `_INTAKE_ID_RE` /\A[0-9a-f]{32}\Z/. Unguessable and
  /// expiring, but the image route still sits behind the session gate.
  intakeId         String          @map("intake_id") @db.VarChar(32)
  /// `basename(orig || "receipt")` from the sidecar.
  originalFilename String          @map("original_filename") @db.VarChar(255)
  /// `<intakeId><ext>` where ext ∈ _INTAKE_EXTS {.png,.jpg,.jpeg,.webp,.pdf},
  /// defaulting to .png when the original extension is not in that set.
  storedName       String          @map("stored_name") @db.VarChar(255)
  mimeType         String?         @map("mime_type") @db.VarChar(100)
  size             Int?
  status           OcrIntakeStatus @default(PENDING)
  /// Engine that produced the first pass: tesseract | vision | winrt.
  engine           String?         @db.VarChar(20)
  language         String?         @db.VarChar(40)
  /// `rawText.slice(0, 4000)` as returned by POST /api/ocr/receipt.
  rawText          String?         @map("raw_text") @db.Text
  /// The `extractReceipt()` envelope: merchant{value,confidence}, date, date_is_default,
  /// total, total_confidence, subtotal, tax, tax_detected, reference, partial_reasons,
  /// template_applied, template_fields.
  extracted        Json?
  /// Set when a template was found and applied for this scan.
  templateId       Int?            @map("template_id")
  template         OcrTemplate?    @relation("OcrIntake_template", fields: [templateId], references: [id], onDelete: SetNull)
  /// Populated by POST /api/ocr/intake/{id}/attach, which then deletes the intake bytes.
  attachmentId     Int?            @map("attachment_id")
  attachment       Attachment?     @relation("OcrIntake_attachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  /// createdAt + INTAKE_TTL_HOURS (24 h). Past this, `getIntake` deletes and returns null.
  expiresAt        DateTime        @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([intakeId])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("ocr_intakes")
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

/// Correspondence between a Slowbooks record and its QuickBooks Online twin.
/// Registry name QboMapping; upstream table `qbo_mappings` (§25.2).
model QboMapping {
  id           Int           @id @default(autoincrement())
  entityType   QboEntityType @map("entity_type")
  /// The local row id. Named `slowbooks_id` upstream; kept verbatim.
  slowbooksId  Int           @map("slowbooks_id")
  /// QBO ids are strings; `getMappingByQboId` compares `String(qboId)`.
  qboId        String        @map("qbo_id") @db.VarChar(100)
  /// Required by QBO for updates — an update without the current SyncToken is rejected.
  qboSyncToken String?       @map("qbo_sync_token") @db.VarChar(50)
  lastSyncedAt DateTime?     @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Both directions must be single-valued, or a sync can fan out.
  @@unique([entityType, slowbooksId])
  @@unique([entityType, qboId])
  @@index([entityType])
  @@map("qbo_mappings")
}

/// Configuration for one AI provider. Registry name AiProviderConfig.
/// DIVERGENCE: upstream stores exactly one configuration, spread across six rows of the
/// `settings` key-value table (`ai_provider`, `ai_model`, `ai_api_key`,
/// `ai_cloudflare_account_id`, `ai_worker_url`, `ai_endpoint_url` — §19.9). Those keys are
/// deliberately NOT settable through PUT /api/settings, which whitelists against
/// DEFAULT_SETTINGS, and are managed by their own /api/analytics/ai-config routes instead.
/// Once one database holds many companies, a typed per-company row is both safer (the
/// encrypted key cannot be read back through a settings route that forgets to redact a
/// new key) and clearer. The settings keys remain as the compatibility read path.
model AiProviderConfig {
  id                  Int          @id @default(autoincrement())
  provider            AiProvider
  wireFormat          AiWireFormat @map("wire_format")
  /// Empty means "use the registry's `default_model` for this provider".
  model               String       @default("") @db.VarChar(200)
  /// Fernet ciphertext, "fernet:v1:"-prefixed, under the SETTINGS_ENCRYPTION_KEY master
  /// key (§10.1). NEVER returned by any endpoint: GET /api/analytics/ai-config reports
  /// only `has_api_key` and `api_key_encrypted`. On ANY decrypt exception the reader
  /// treats the value as no key ("") rather than propagating (§19.9).
  /// PUT semantics: omitted keeps the stored key, non-empty replaces it, empty removes it.
  apiKeyEncrypted     String?      @map("api_key_encrypted") @db.Text
  /// Cloudflare direct REST. Must match CLOUDFLARE_ACCOUNT_ID_RE /^[a-f0-9]{32}$/ —
  /// 400 `cloudflare_account_id must be exactly 32 lowercase hex characters` otherwise.
  cloudflareAccountId String?      @map("cloudflare_account_id") @db.VarChar(32)
  /// Self-hosted Cloudflare Worker gateway. Stored only after `validateWorkerUrl()`:
  /// https only, no embedded credentials, no private/loopback/link-local/reserved host
  /// (literal AND resolved), query and fragment stripped. Cap is _MAX_WORKER_URL_LEN 2048.
  workerUrl           String?      @map("worker_url") @db.VarChar(2048)
  /// Generic OpenAI-compatible base URL for `custom`; identical validation — a generic
  /// endpoint is just as dangerous to point at an internal address. "/chat/completions"
  /// is appended at request time unless the normalised URL already ends with it.
  endpointUrl         String?      @map("endpoint_url") @db.VarChar(2048)
  /// Exactly one config per company should be active; the others are remembered
  /// credentials the operator can switch back to.
  isActive            Boolean      @default(false) @map("is_active")
  lastTestedAt        DateTime?    @map("last_tested_at") @db.Timestamptz(6)
  /// Reply text of the last POST /api/analytics/ai-config/test, `.trim().slice(0,200)`.
  lastTestResult      String?      @map("last_test_result") @db.VarChar(200)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider])
  @@index([isActive])
  @@map("ai_provider_configs")
}

// ---------------------------------------------------------------------------
// Migration
// ---------------------------------------------------------------------------

/// One execution of an import/export path: a CSV-dialect dry run or import (§26), an
/// IIF validate/import/export (§24), a QBO import/export (§25), or a QuickBooks Desktop
/// report-CSV import (§27). Registry name MigrationRun.
/// DIVERGENCE: upstream persists nothing — every route computes its result object and
/// returns it, and the only trace left behind is the pair of settings keys
/// `chart_setup_source` / `chart_setup_ready_at` written after a successful import.
/// Keeping the run means the dry-run verdict an operator approved can be shown next to
/// what the import actually did, and a failed 500 (`Import failed — the server log has
/// the details`) stops being invisible to everyone without shell access.
model MigrationRun {
  id                Int                @id @default(autoincrement())
  source            MigrationSource
  /// The SOURCES label shown to the user: "Xero", "MYOB", "Sage 50", "Wave",
  /// "Zoho Books", "GnuCash".
  sourceLabel       String             @map("source_label") @db.VarChar(100)
  /// The `source_type` stamped onto every journal the run posts: "xero_import",
  /// "myob_import", "sage_import", "wave_import", "zoho_import", "gnucash_import".
  sourceType        String?            @map("source_type") @db.VarChar(50)
  mode              MigrationRunMode
  status            MigrationRunStatus @default(RUNNING)
  /// A dry run's `ok`, or an import's — the import is gated on a passing dry run.
  ok                Boolean            @default(false)
  /// Uploaded filenames and the kind each was classified as
  /// ({filename: "coa"|"gl"|"tb"}), so an unclassified-file 400 can be explained later.
  files             Json?
  /// Counters. CSV dialects fill accounts/journals; IIF fills the rest.
  accounts          Int                @default(0)
  journals          Int                @default(0)
  importedAccounts  Int                @default(0) @map("imported_accounts")
  importedJournals  Int                @default(0) @map("imported_journals")
  duplicatesSkipped Int                @default(0) @map("duplicates_skipped")
  /// Opening balances detected by the trial-balance check: per-account residuals that
  /// net to EXACTLY zero. [{account, amount}] (§26.2).
  openingBalances   Json?              @map("opening_balances")
  /// The full result object verbatim (IIF: classes/accounts/customers/vendors/items/
  /// invoices/payments/sales_receipts/estimates/bills/deposits; QBO: QBOImportResult /
  /// QBOExportResult; QB report: detected + the three counters).
  result            Json?
  /// [{row, message}] for IIF; plain strings for the CSV engine. Per-row errors are
  /// collected rather than aborting the batch — every row runs in its own savepoint.
  errors            Json?
  warnings          Json?
  /// Acting principal: a username, or "token:<label>" for an API-token principal —
  /// the same attribution the audit log uses.
  startedBy         String?            @map("started_by") @db.VarChar(100)
  startedAt         DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?          @map("finished_at") @db.Timestamptz(6)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([source])
  @@index([startedAt])
  @@index([status])
  @@map("migration_runs")
}

// ---------------------------------------------------------------------------
// Search
// ---------------------------------------------------------------------------

/// One searchable record for GET /api/search. Registry name SearchIndexEntry.
/// DIVERGENCE: upstream runs six live `ILIKE '%q%'` queries against Customer, Vendor,
/// Item, Invoice, Estimate and Payment on every keystroke, 5 rows per category
/// (LIMIT_PER = 5), omitting empty categories from the response entirely. A leading
/// wildcard cannot use a B-tree index, which is survivable when the database holds one
/// company and unsurvivable when it holds hundreds. This table is the denormalised
/// projection those six queries read from; the API contract (categories, field sets,
/// ordering, the 5-per-category cap, `q` min length 2) is unchanged.
model SearchIndexEntry {
  id         Int              @id @default(autoincrement())
  entityType SearchEntityType @map("entity_type")
  /// Primary key of the row in its own table. Not an FK — six different targets.
  entityId   Int              @map("entity_id")
  /// The display line: customer/vendor/item name, or the document number.
  title      String           @db.VarChar(300)
  /// The secondary line: company for customers/vendors, customer_name for documents
  /// ("" when a document has no customer), item_type for items, method for payments.
  subtitle   String?          @db.VarChar(300)
  /// Every field the upstream ILIKE clauses touch, concatenated and lowercased:
  /// name, company, email, description, invoice_number, estimate_number, reference,
  /// check_number. Matched with a trigram (pg_trgm GIN) index rather than a scan.
  keywords   String           @db.Text
  /// Documents only — `total` for invoices/estimates, `amount` for payments.
  amount     Decimal?         @db.Decimal(14, 2)
  /// Documents only — the `date DESC` ordering key for invoices, estimates, payments.
  entryDate  DateTime?        @map("entry_date") @db.Date
  /// Verbatim enum value of the source row's status, where it has one.
  status     String?          @db.VarChar(50)
  /// Mirrors the source row's `is_active`. Customers, vendors and items are filtered
  /// on it; documents are not.
  isActive   Boolean          @default(true) @map("is_active")
  indexedAt  DateTime         @default(now()) @map("indexed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entityType, entityId])
  @@index([entityType, isActive])
  @@index([entityType, entryDate])
  @@map("search_index_entries")
}

